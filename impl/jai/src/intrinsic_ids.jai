// Intrinsic::ID constants for the intrinsics passes switch on (evaluated at compile time from INTRINSIC_INFOS).
// Add a name here when a pass needs a new one.

iid_by_name :: (name: string) -> Intrinsic_Id {
    for INTRINSIC_INFOS if it.name == name return cast(Intrinsic_Id)(it_index + 1);
    assert(false, "no intrinsic named %", name);
    return 0;
}

