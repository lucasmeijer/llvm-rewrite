ISD_USUBO_CARRY : u32 : 350;
ISD_VACOPY : u32 : 351;
ISD_VAEND : u32 : 352;
ISD_VASTART : u32 : 353;
ISD_VECTOR_FIND_LAST_ACTIVE : u32 : 354;
ISD_VECTOR_SPLICE_LEFT : u32 : 355;
ISD_VECTOR_SPLICE_RIGHT : u32 : 356;
ISD_ZERO_EXTEND_VECTOR_INREG : u32 : 357;
ISD_ZEXTLOAD : u32 : 358;
ISD_COUNT :: 359;

// target-specific (X86ISD) opcodes: getOperationAction answers Custom
isd_is_target :: (isd: u32) -> bool {
    return isd == ISD_X86_PMULUDQ || isd == ISD_X86_VROTLI || isd == ISD_X86_VSHLI || isd == ISD_X86_VSRLI || isd == ISD_X86_VSRAI;
}

set_f16_action :: (st: *X86_Lowering, VT: u32, Action: u8) {
    soa(st, ISD_FABS, VT, Action);
    soa(st, ISD_FNEG, VT, Action);
    soa(st, ISD_FCOPYSIGN, VT, LA_EXPAND);
    soa(st, ISD_FREM, VT, Action);
    soa(st, ISD_FMA, VT, Action);
    soa(st, ISD_FMINNUM, VT, Action);
    soa(st, ISD_FMAXNUM, VT, Action);
    soa(st, ISD_FMINIMUM, VT, Action);
    soa(st, ISD_FMAXIMUM, VT, Action);
    soa(st, ISD_FMINIMUMNUM, VT, Action);
    soa(st, ISD_FMAXIMUMNUM, VT, Action);
    soa(st, ISD_FSIN, VT, Action);
    soa(st, ISD_FCOS, VT, Action);
    soa(st, ISD_FSINCOS, VT, Action);
    soa(st, ISD_FTAN, VT, Action);
    soa(st, ISD_FSQRT, VT, Action);
    soa(st, ISD_FPOW, VT, Action);
    soa(st, ISD_FPOWI, VT, Action);
    soa(st, ISD_FLOG, VT, Action);
    soa(st, ISD_FLOG2, VT, Action);
    soa(st, ISD_FLOG10, VT, Action);
    soa(st, ISD_FEXP, VT, Action);
    soa(st, ISD_FEXP2, VT, Action);
    soa(st, ISD_FEXP10, VT, Action);
    soa(st, ISD_FCEIL, VT, Action);
    soa(st, ISD_FFLOOR, VT, Action);
    soa(st, ISD_FNEARBYINT, VT, Action);
    soa(st, ISD_FRINT, VT, Action);
    soa(st, ISD_BR_CC, VT, Action);
    soa(st, ISD_SETCC, VT, Action);
    soa(st, ISD_SELECT, VT, LA_CUSTOM);
    soa(st, ISD_SELECT_CC, VT, Action);
    soa(st, ISD_FROUND, VT, Action);
    soa(st, ISD_FROUNDEVEN, VT, Action);
    soa(st, ISD_FTRUNC, VT, Action);
    soa(st, ISD_FLDEXP, VT, Action);
    soa(st, ISD_FFREXP, VT, Action);
    soa(st, ISD_FSINCOSPI, VT, Action);
  }

set_group :: (st: *X86_Lowering, VT: u32) {
      soa(st, ISD_FADD,               VT, LA_LEGAL);
      soa(st, ISD_STRICT_FADD,        VT, LA_LEGAL);
      soa(st, ISD_FSUB,               VT, LA_LEGAL);
      soa(st, ISD_STRICT_FSUB,        VT, LA_LEGAL);
      soa(st, ISD_FMUL,               VT, LA_LEGAL);
      soa(st, ISD_STRICT_FMUL,        VT, LA_LEGAL);
      soa(st, ISD_FDIV,               VT, LA_LEGAL);
      soa(st, ISD_STRICT_FDIV,        VT, LA_LEGAL);
      soa(st, ISD_FSQRT,              VT, LA_LEGAL);
      soa(st, ISD_STRICT_FSQRT,       VT, LA_LEGAL);

      soa(st, ISD_FFLOOR,             VT, LA_LEGAL);
      soa(st, ISD_STRICT_FFLOOR,      VT, LA_LEGAL);
      soa(st, ISD_FCEIL,              VT, LA_LEGAL);
      soa(st, ISD_STRICT_FCEIL,       VT, LA_LEGAL);
      soa(st, ISD_FTRUNC,             VT, LA_LEGAL);
      soa(st, ISD_STRICT_FTRUNC,      VT, LA_LEGAL);
      soa(st, ISD_FRINT,              VT, LA_LEGAL);
      soa(st, ISD_STRICT_FRINT,       VT, LA_LEGAL);
      soa(st, ISD_FNEARBYINT,         VT, LA_LEGAL);
      soa(st, ISD_STRICT_FNEARBYINT,  VT, LA_LEGAL);
      soa(st, ISD_FROUNDEVEN, VT, LA_LEGAL);
      soa(st, ISD_STRICT_FROUNDEVEN, VT, LA_LEGAL);

      soa(st, ISD_FROUND,             VT, LA_CUSTOM);

      soa(st, ISD_LOAD,               VT, LA_LEGAL);
      soa(st, ISD_STORE,              VT, LA_LEGAL);

      soa(st, ISD_FMA,                VT, LA_LEGAL);
      soa(st, ISD_STRICT_FMA,         VT, LA_LEGAL);
      soa(st, ISD_VSELECT,            VT, LA_LEGAL);
      soa(st, ISD_BUILD_VECTOR,       VT, LA_CUSTOM);
      soa(st, ISD_SELECT,             VT, LA_CUSTOM);

      soa(st, ISD_FNEG,               VT, LA_CUSTOM);
      soa(st, ISD_FABS,               VT, LA_CUSTOM);
      soa(st, ISD_FCOPYSIGN,          VT, LA_CUSTOM);
      soa(st, ISD_EXTRACT_VECTOR_ELT, VT, LA_CUSTOM);
      soa(st, ISD_VECTOR_SHUFFLE,     VT, LA_CUSTOM);

      soa(st, ISD_SETCC,              VT, LA_CUSTOM);
      soa(st, ISD_STRICT_FSETCC,      VT, LA_CUSTOM);
      soa(st, ISD_STRICT_FSETCCS,     VT, LA_CUSTOM);
    }

set_fp_min_max_action :: (st: *X86_Lowering, VT: u32) {
    soa(st, ISD_PSEUDO_FMIN, VT, LA_LEGAL);
    soa(st, ISD_PSEUDO_FMAX, VT, LA_LEGAL);
    soa(st, ISD_STRICT_PSEUDO_FMIN, VT, LA_LEGAL);
    soa(st, ISD_STRICT_PSEUDO_FMAX, VT, LA_LEGAL);
    soa(st, ISD_FMAXIMUM, VT, LA_CUSTOM);
    soa(st, ISD_FMINIMUM, VT, LA_CUSTOM);
    soa(st, ISD_FMAXIMUMNUM, VT, LA_CUSTOM);
    soa(st, ISD_FMINIMUMNUM, VT, LA_CUSTOM);
  }

// TargetLoweringBase::initActions
tlb_init_actions :: (st: *X86_Lowering) {

  
  
  
  
  
  
  
  
  

  
  for ValVT: mvt_all_valuetypes() 
    for MemVT: mvt_all_valuetypes() 
      {}

  
  
  
  for AVT: mvt_all_valuetypes()  {
    for VT: u32.[MVT_i2, MVT_i4, MVT_v128i2, MVT_v64i4]  {
      stsa(st, AVT, VT, LA_EXPAND);
      slea(st, ISD_EXTLOAD, AVT, VT, LA_EXPAND);
      slea(st, ISD_ZEXTLOAD, AVT, VT, LA_EXPAND);
    }
  }
  

  for VT: mvt_fp_valuetypes()  {
    IntVT := mvt_int(mvt_bits(VT));
    if ((IntVT != 0)) {
      soa(st, ISD_ATOMIC_SWAP, VT, LA_PROMOTE);
      {}
    }
  }

  
  
  {}
  {}

  
  for VT: mvt_all_valuetypes()  {
    
    

    
    soa(st, ISD_ATOMIC_CMP_SWAP_WITH_SUCCESS, VT, LA_EXPAND);

    
    
    soa(st, u32.[ISD_FGETSIGN,       ISD_CONCAT_VECTORS,
                        ISD_FMINNUM,        ISD_FMAXNUM,
                        ISD_FMINNUM_IEEE,   ISD_FMAXNUM_IEEE,
                        ISD_FMINIMUM,       ISD_FMAXIMUM,
                        ISD_FMINIMUMNUM,    ISD_FMAXIMUMNUM,
                        ISD_FMAD,           ISD_SMIN,
                        ISD_SMAX,           ISD_UMIN,
                        ISD_UMAX,           ISD_ABS,
                        ISD_FSHL,           ISD_FSHR,
                        ISD_SADDSAT,        ISD_UADDSAT,
                        ISD_SSUBSAT,        ISD_USUBSAT,
                        ISD_SSHLSAT,        ISD_USHLSAT,
                        ISD_SMULFIX,        ISD_SMULFIXSAT,
                        ISD_UMULFIX,        ISD_UMULFIXSAT,
                        ISD_SDIVFIX,        ISD_SDIVFIXSAT,
                        ISD_UDIVFIX,        ISD_UDIVFIXSAT,
                        ISD_FP_TO_SINT_SAT, ISD_FP_TO_UINT_SAT,
                        ISD_IS_FPCLASS,     ISD_FCBRT,
                        ISD_FLOG,           ISD_FLOG2,
                        ISD_FLOG10,         ISD_FEXP,
                        ISD_FEXP2,          ISD_FEXP10,
                        ISD_FFLOOR,         ISD_FNEARBYINT,
                        ISD_FCEIL,          ISD_FRINT,
                        ISD_FTRUNC,         ISD_FROUNDEVEN,
                        ISD_FTAN,           ISD_FACOS,
                        ISD_FASIN,          ISD_FATAN,
                        ISD_FCOSH,          ISD_FSINH,
                        ISD_FTANH,          ISD_FATAN2,
                        ISD_FMULADD,        ISD_CONVERT_FROM_ARBITRARY_FP,
                        ISD_CONVERT_TO_ARBITRARY_FP,
                        ISD_PSEUDO_FMIN,    ISD_PSEUDO_FMAX],
                       VT, LA_EXPAND);
    

    
    soa(st, u32.[ISD_SADDO, ISD_SSUBO, ISD_UADDO, ISD_USUBO,
                        ISD_SMULO, ISD_UMULO],
                       VT, LA_EXPAND);

    
    soa(st, u32.[ISD_UADDO_CARRY, ISD_USUBO_CARRY, ISD_SETCCCARRY,
                        ISD_SADDO_CARRY, ISD_SSUBO_CARRY],
                       VT, LA_EXPAND);

    
    soa(st, u32.[ISD_ADDC, ISD_ADDE, ISD_SUBC, ISD_SUBE], VT,
                       LA_EXPAND);

    
    soa(st, u32.[ISD_UCMP, ISD_SCMP], VT, LA_EXPAND);

    
    soa(st, 
        u32.[ISD_AVGFLOORS, ISD_AVGFLOORU, ISD_AVGCEILS, ISD_AVGCEILU], VT,
        LA_EXPAND);

    
    soa(st, u32.[ISD_ABDS, ISD_ABDU], VT, LA_EXPAND);

    
    soa(st, u32.[ISD_CLMUL, ISD_CLMULR, ISD_CLMULH], VT, LA_EXPAND);

    
    soa(st, u32.[ISD_PEXT, ISD_PDEP], VT, LA_EXPAND);

    
    soa(st, ISD_TRUNCATE_SSAT_S, VT, LA_EXPAND);
    soa(st, ISD_TRUNCATE_SSAT_U, VT, LA_EXPAND);
    soa(st, ISD_TRUNCATE_USAT_U, VT, LA_EXPAND);

    
    soa(st, u32.[ISD_CTLZ_ZERO_POISON, ISD_CTTZ_ZERO_POISON], VT,
                       LA_EXPAND);

    
    soa(st, ISD_ABS_MIN_POISON, VT, LA_EXPAND);
    soa(st, ISD_CTLS, VT, LA_EXPAND);

    soa(st, u32.[ISD_BITREVERSE, ISD_PARITY], VT, LA_EXPAND);

    
    soa(st, u32.[ISD_FROUND, ISD_FPOWI, ISD_FLDEXP, ISD_FFREXP,
                        ISD_FSINCOS, ISD_FSINCOSPI, ISD_FMODF],
                       VT, LA_EXPAND);

    
    if (mvt_is_vec(VT))
      soa(st, u32.[ISD_FCOPYSIGN, ISD_SIGN_EXTEND_INREG,
                          ISD_ANY_EXTEND_VECTOR_INREG,
                          ISD_SIGN_EXTEND_VECTOR_INREG,
                          ISD_ZERO_EXTEND_VECTOR_INREG, ISD_SPLAT_VECTOR,
                          ISD_LRINT, ISD_LLRINT, ISD_LROUND, ISD_LLROUND],
                         VT, LA_EXPAND);

      
    soa(st, ISD_STRICT_PSEUDO_FMIN, VT, LA_EXPAND);
    soa(st, ISD_STRICT_PSEUDO_FMAX, VT, LA_EXPAND);

    
    soa(st, ISD_GET_DYNAMIC_AREA_OFFSET, VT, LA_EXPAND);

    
    soa(st, 
        u32.[ISD_VECREDUCE_FADD, ISD_VECREDUCE_FMUL, ISD_VECREDUCE_ADD,
         ISD_VECREDUCE_MUL, ISD_VECREDUCE_AND, ISD_VECREDUCE_OR,
         ISD_VECREDUCE_XOR, ISD_VECREDUCE_SMAX, ISD_VECREDUCE_SMIN,
         ISD_VECREDUCE_UMAX, ISD_VECREDUCE_UMIN, ISD_VECREDUCE_FMAX,
         ISD_VECREDUCE_FMIN, ISD_VECREDUCE_FMAXIMUM, ISD_VECREDUCE_FMINIMUM,
         ISD_VECREDUCE_SEQ_FADD, ISD_VECREDUCE_SEQ_FMUL],
        VT, LA_EXPAND);

    
    soa(st, u32.[ISD_VECTOR_SPLICE_LEFT, ISD_VECTOR_SPLICE_RIGHT], VT,
                       LA_EXPAND);

    
    soa(st, ISD_VECTOR_COMPRESS, VT, LA_EXPAND);

    
    soa(st, u32.[ISD_CTTZ_ELTS, ISD_CTTZ_ELTS_ZERO_POISON], VT,
                       LA_EXPAND);

    

    
    soa(st, ISD_VECTOR_FIND_LAST_ACTIVE, VT, LA_EXPAND);

    soa(st, ISD_LOOP_DEPENDENCE_RAW_MASK, VT, LA_EXPAND);
    soa(st, ISD_LOOP_DEPENDENCE_WAR_MASK, VT, LA_EXPAND);

    
    soa(st, ISD_GET_FPENV, VT, LA_EXPAND);
    soa(st, ISD_SET_FPENV, VT, LA_EXPAND);
    soa(st, ISD_RESET_FPENV, VT, LA_EXPAND);

    soa(st, ISD_MSTORE, VT, LA_EXPAND);

    soa(st, ISD_MASKED_UDIV, VT, LA_EXPAND);
    soa(st, ISD_MASKED_SDIV, VT, LA_EXPAND);
    soa(st, ISD_MASKED_UREM, VT, LA_EXPAND);
    soa(st, ISD_MASKED_SREM, VT, LA_EXPAND);
  }

  
  soa(st, ISD_PREFETCH, MVT_Other, LA_EXPAND);

  
  soa(st, ISD_READCYCLECOUNTER, MVT_i64, LA_EXPAND);

  
  soa(st, ISD_READSTEADYCOUNTER, MVT_i64, LA_EXPAND);

  
  
  
  soa(st, ISD_ConstantFP,
                     u32.[MVT_bf16, MVT_f16, MVT_f32, MVT_f64, MVT_f80, MVT_f128],
                     LA_EXPAND);

  
  soa(st, ISD_FCANONICALIZE,
                     u32.[MVT_f16, MVT_f32, MVT_f64, MVT_f128], LA_EXPAND);

  
  soa(st, u32.[ISD_LRINT, ISD_LLRINT, ISD_LROUND, ISD_LLROUND],
                     u32.[MVT_f32, MVT_f64, MVT_f128], LA_LIBCALL);

  soa(st, u32.[ISD_FTAN, ISD_FACOS, ISD_FASIN, ISD_FATAN, ISD_FCOSH,
                      ISD_FSINH, ISD_FTANH, ISD_FATAN2],
                     MVT_f16, LA_PROMOTE);
  
  soa(st, ISD_TRAP, MVT_Other, LA_EXPAND);

  
  
  soa(st, ISD_DEBUGTRAP, MVT_Other, LA_EXPAND);

  soa(st, ISD_UBSANTRAP, MVT_Other, LA_EXPAND);

  soa(st, ISD_GET_FPENV_MEM, MVT_Other, LA_EXPAND);
  soa(st, ISD_SET_FPENV_MEM, MVT_Other, LA_EXPAND);

  for VT: u32.[MVT_i8, MVT_i16, MVT_i32, MVT_i64]  {
    soa(st, ISD_GET_FPMODE, VT, LA_EXPAND);
    soa(st, ISD_SET_FPMODE, VT, LA_EXPAND);
  }
  soa(st, ISD_RESET_FPMODE, MVT_Other, LA_EXPAND);

  
  
  soa(st, ISD_CLEAR_CACHE, MVT_Other, LA_LIBCALL);

  
  
  soa(st, ISD_STACKADDRESS, MVT_Other, LA_EXPAND);


}

x86_lowering_actions :: (st: *X86_Lowering) {


  UseX87 := !st_useSoftFloat(st) && st_hasX87(st);
  PtrVT := mvt_int(st_ptr_bits(st));

  

  
  {}
  
  {}

  
  
  soa(st, ISD_CLEAR_CACHE, MVT_Other, LA_EXPAND);

  
  
  
  if (st_isAtom(st))
    {}
  else if (st_is64Bit(st))
    {}
  else
    {}
  
  {}

  
  if (true) {
    if (st_hasSlowDivide32(st))
      {}
    if (st_hasSlowDivide64(st) && st_is64Bit(st))
      {}
  }

  if (st_canUseCMPXCHG16B(st))
    {}
  else if (st_canUseCMPXCHG8B(st))
    {}
  else
    {}

  {}

  {}

  
  add_reg_class(st, MVT_i8);
  add_reg_class(st, MVT_i16);
  add_reg_class(st, MVT_i32);
  if (st_is64Bit(st))
    add_reg_class(st, MVT_i64);

  for VT: mvt_integer_valuetypes() 
    slea(st, ISD_SEXTLOAD, VT, MVT_i1, LA_PROMOTE);

  
  stsa(st, MVT_i64, MVT_i32, LA_EXPAND);
  stsa(st, MVT_i64, MVT_i16, LA_EXPAND);
  stsa(st, MVT_i64, MVT_i8 , LA_EXPAND);
  stsa(st, MVT_i32, MVT_i16, LA_EXPAND);
  stsa(st, MVT_i32, MVT_i8 , LA_EXPAND);
  stsa(st, MVT_i16, MVT_i8,  LA_EXPAND);

  stsa(st, MVT_f64, MVT_f32, LA_EXPAND);

  
  for VT: u32.[MVT_f32, MVT_f64, MVT_f80]  {
    scca(st, ISD_SETOEQ, VT, LA_EXPAND);
    scca(st, ISD_SETUNE, VT, LA_EXPAND);
  }

  
  if (st_canUseCMOV(st)) {
    soa(st, ISD_ABS            , MVT_i16  , LA_CUSTOM);
    soa(st, ISD_ABS            , MVT_i32  , LA_CUSTOM);
    if (st_is64Bit(st))
      soa(st, ISD_ABS          , MVT_i64  , LA_CUSTOM);
  }

  
  for Op: u32.[ISD_ABDS, ISD_ABDU]  {
    soa(st, Op                  , MVT_i8   , LA_CUSTOM);
    soa(st, Op                  , MVT_i16  , LA_CUSTOM);
    soa(st, Op                  , MVT_i32  , LA_CUSTOM);
    if (st_is64Bit(st))
     soa(st, Op                 , MVT_i64  , LA_CUSTOM);
  }

  
  soa(st, ISD_SSUBSAT          , MVT_i8   , LA_CUSTOM);
  soa(st, ISD_SSUBSAT          , MVT_i16  , LA_CUSTOM);
  soa(st, ISD_SSUBSAT          , MVT_i32  , LA_CUSTOM);
  if (st_is64Bit(st))
    soa(st, ISD_SSUBSAT        , MVT_i64  , LA_CUSTOM);

  
  for ShiftOp: u32.[ISD_FSHL, ISD_FSHR]  {
    
    ShiftDoubleAction :=  ifx st_isSHLDSlow(st) then LA_CUSTOM else LA_LEGAL;

    soa(st, ShiftOp             , MVT_i8   , LA_CUSTOM);
    soa(st, ShiftOp             , MVT_i16  , LA_CUSTOM);
    soa(st, ShiftOp             , MVT_i32  , ShiftDoubleAction);
    if (st_is64Bit(st))
      soa(st, ShiftOp           , MVT_i64  , ShiftDoubleAction);
  }

  if (!st_useSoftFloat(st)) {
    
    
    soa(st, ISD_UINT_TO_FP,        MVT_i8, LA_PROMOTE);
    soa(st, ISD_STRICT_UINT_TO_FP, MVT_i8, LA_PROMOTE);
    soa(st, ISD_UINT_TO_FP,        MVT_i16, LA_PROMOTE);
    soa(st, ISD_STRICT_UINT_TO_FP, MVT_i16, LA_PROMOTE);
    
    
    soa(st, ISD_UINT_TO_FP,        MVT_i32, LA_CUSTOM);
    soa(st, ISD_STRICT_UINT_TO_FP, MVT_i32, LA_CUSTOM);
    
    
    soa(st, ISD_UINT_TO_FP,        MVT_i64, LA_CUSTOM);
    soa(st, ISD_STRICT_UINT_TO_FP, MVT_i64, LA_CUSTOM);

    
    
    soa(st, ISD_SINT_TO_FP,        MVT_i8, LA_PROMOTE);
    soa(st, ISD_STRICT_SINT_TO_FP, MVT_i8, LA_PROMOTE);
    
    
    soa(st, ISD_SINT_TO_FP,        MVT_i16, LA_CUSTOM);
    soa(st, ISD_STRICT_SINT_TO_FP, MVT_i16, LA_CUSTOM);
    
    soa(st, ISD_SINT_TO_FP,        MVT_i32, LA_CUSTOM);
    soa(st, ISD_STRICT_SINT_TO_FP, MVT_i32, LA_CUSTOM);
    
    
    soa(st, ISD_SINT_TO_FP,        MVT_i64, LA_CUSTOM);
    soa(st, ISD_STRICT_SINT_TO_FP, MVT_i64, LA_CUSTOM);

    
    
    soa(st, ISD_FP_TO_SINT,        MVT_i8,  LA_PROMOTE);
    
    soa(st, ISD_STRICT_FP_TO_SINT, MVT_i8,  LA_PROMOTE);
    soa(st, ISD_FP_TO_SINT,        MVT_i16, LA_CUSTOM);
    soa(st, ISD_STRICT_FP_TO_SINT, MVT_i16, LA_CUSTOM);
    soa(st, ISD_FP_TO_SINT,        MVT_i32, LA_CUSTOM);
    soa(st, ISD_STRICT_FP_TO_SINT, MVT_i32, LA_CUSTOM);
    
    
    soa(st, ISD_FP_TO_SINT,        MVT_i64, LA_CUSTOM);
    soa(st, ISD_STRICT_FP_TO_SINT, MVT_i64, LA_CUSTOM);

    
    
    soa(st, ISD_FP_TO_UINT,        MVT_i8,  LA_PROMOTE);
    
    soa(st, ISD_STRICT_FP_TO_UINT, MVT_i8,  LA_PROMOTE);
    soa(st, ISD_FP_TO_UINT,        MVT_i16, LA_PROMOTE);
    
    soa(st, ISD_STRICT_FP_TO_UINT, MVT_i16, LA_PROMOTE);
    soa(st, ISD_FP_TO_UINT,        MVT_i32, LA_CUSTOM);
    soa(st, ISD_STRICT_FP_TO_UINT, MVT_i32, LA_CUSTOM);
    soa(st, ISD_FP_TO_UINT,        MVT_i64, LA_CUSTOM);
    soa(st, ISD_STRICT_FP_TO_UINT, MVT_i64, LA_CUSTOM);

    soa(st, ISD_LRINT,             MVT_f32, LA_CUSTOM);
    soa(st, ISD_LRINT,             MVT_f64, LA_CUSTOM);
    soa(st, ISD_LLRINT,            MVT_f32, LA_CUSTOM);
    soa(st, ISD_LLRINT,            MVT_f64, LA_CUSTOM);

    if (!st_is64Bit(st) && st_hasX87(st)) {
      soa(st, ISD_LRINT,  MVT_i64, LA_CUSTOM);
      soa(st, ISD_LLRINT, MVT_i64, LA_CUSTOM);
    }
  }

  if (st_hasSSE2(st)) {
    
    
    for VT: u32.[ MVT_i8, MVT_i16, MVT_i32 ]  {
      soa(st, ISD_FP_TO_UINT_SAT, VT, LA_CUSTOM);
      soa(st, ISD_FP_TO_SINT_SAT, VT, LA_CUSTOM);
    }
    if (st_is64Bit(st)) {
      soa(st, ISD_FP_TO_UINT_SAT, MVT_i64, LA_CUSTOM);
      soa(st, ISD_FP_TO_SINT_SAT, MVT_i64, LA_CUSTOM);
    }
  }
  if (st_hasAVX10_2(st)) {
    for VT: u32.[MVT_v8i8, MVT_v16i8, MVT_v32i8]  {
      soa(st, ISD_FP_TO_UINT_SAT, VT, LA_CUSTOM);
      soa(st, ISD_FP_TO_SINT_SAT, VT, LA_CUSTOM);
    }
    soa(st, ISD_FP_TO_UINT_SAT, MVT_v2i32, LA_CUSTOM);
    soa(st, ISD_FP_TO_SINT_SAT, MVT_v2i32, LA_CUSTOM);
    soa(st, ISD_FP_TO_UINT_SAT, MVT_v8i64, LA_LEGAL);
    soa(st, ISD_FP_TO_SINT_SAT, MVT_v8i64, LA_LEGAL);
    for VT: u32.[MVT_i32, MVT_v4i32, MVT_v8i32, MVT_v16i32, MVT_v2i64,
                   MVT_v4i64]  {
      soa(st, ISD_FP_TO_UINT_SAT, VT, LA_LEGAL);
      soa(st, ISD_FP_TO_SINT_SAT, VT, LA_LEGAL);
    }
    if (st_is64Bit(st)) {
      soa(st, ISD_FP_TO_UINT_SAT, MVT_i64, LA_LEGAL);
      soa(st, ISD_FP_TO_SINT_SAT, MVT_i64, LA_LEGAL);
    }
  }

  
  soa(st, ISD_ADDRSPACECAST, MVT_i32, LA_CUSTOM);
  soa(st, ISD_ADDRSPACECAST, MVT_i64, LA_CUSTOM);

  
  if (!st_hasSSE2(st)) {
    soa(st, ISD_BITCAST        , MVT_f32  , LA_EXPAND);
    soa(st, ISD_BITCAST        , MVT_i32  , LA_EXPAND);
    if (st_is64Bit(st)) {
      soa(st, ISD_BITCAST      , MVT_f64  , LA_EXPAND);
      
      soa(st, ISD_BITCAST      , MVT_i64  , LA_EXPAND);
    }
  } else if (!st_is64Bit(st))
    soa(st, ISD_BITCAST      , MVT_i64  , LA_CUSTOM);

  
  
  
  
  
  
  
  
  
  
  for VT: u32.[ MVT_i8, MVT_i16, MVT_i32, MVT_i64 ]  {
    soa(st, ISD_MULHS, VT, LA_EXPAND);
    soa(st, ISD_MULHU, VT, LA_EXPAND);
    soa(st, ISD_SDIV, VT, LA_EXPAND);
    soa(st, ISD_UDIV, VT, LA_EXPAND);
    soa(st, ISD_SREM, VT, LA_EXPAND);
    soa(st, ISD_UREM, VT, LA_EXPAND);
  }

  soa(st, ISD_BR_JT            , MVT_Other, LA_EXPAND);
  soa(st, ISD_BRCOND           , MVT_Other, LA_CUSTOM);
  for VT: u32.[ MVT_f32, MVT_f64, MVT_f80, MVT_f128,
                   MVT_i8,  MVT_i16, MVT_i32, MVT_i64 ]  {
    soa(st, ISD_BR_CC,     VT, LA_EXPAND);
    soa(st, ISD_SELECT_CC, VT, LA_EXPAND);
  }
  if (st_is64Bit(st))
    soa(st, ISD_SIGN_EXTEND_INREG, MVT_i32, LA_LEGAL);
  soa(st, ISD_SIGN_EXTEND_INREG, MVT_i16  , LA_LEGAL);
  soa(st, ISD_SIGN_EXTEND_INREG, MVT_i8   , LA_LEGAL);
  soa(st, ISD_SIGN_EXTEND_INREG, MVT_i1   , LA_EXPAND);

  soa(st, ISD_FREM, MVT_f32, LA_LIBCALL);
  soa(st, ISD_FREM, MVT_f64, LA_LIBCALL);
  soa(st, ISD_FREM, MVT_f80, LA_LIBCALL);
  soa(st, ISD_FREM, MVT_f128, LA_LIBCALL);

  if (!st_useSoftFloat(st) && st_hasX87(st)) {
    soa(st, ISD_GET_ROUNDING   , MVT_i32  , LA_CUSTOM);
    soa(st, ISD_SET_ROUNDING   , MVT_Other, LA_CUSTOM);
    soa(st, ISD_GET_FPENV_MEM  , MVT_Other, LA_CUSTOM);
    soa(st, ISD_SET_FPENV_MEM  , MVT_Other, LA_CUSTOM);
    soa(st, ISD_RESET_FPENV    , MVT_Other, LA_CUSTOM);
  }

  
  
  sopt(st, ISD_CTTZ, MVT_i8, MVT_i32);
  sopt(st, ISD_CTTZ_ZERO_POISON, MVT_i8, MVT_i32);
  
  
  
  sopt(st, ISD_CTTZ, MVT_i16, MVT_i32);
  sopt(st, ISD_CTTZ_ZERO_POISON, MVT_i16, MVT_i32);

  if (!st_hasBMI(st)) {
    soa(st, ISD_CTTZ, MVT_i32, LA_CUSTOM);
    soa(st, ISD_CTTZ_ZERO_POISON, MVT_i32, LA_LEGAL);
    if (st_is64Bit(st)) {
      soa(st, ISD_CTTZ, MVT_i64, LA_CUSTOM);
      soa(st, ISD_CTTZ_ZERO_POISON, MVT_i64, LA_LEGAL);
    }
  }

  if (st_hasLZCNT(st)) {
    
    
    sopt(st, ISD_CTLZ, MVT_i8, MVT_i32);
    sopt(st, ISD_CTLZ_ZERO_POISON, MVT_i8, MVT_i32);
  } else {
    for VT: u32.[MVT_i8, MVT_i16, MVT_i32, MVT_i64]  {
      if (VT == MVT_i64 && !st_is64Bit(st))
        continue;
      soa(st, ISD_CTLZ, VT, LA_CUSTOM);
      soa(st, ISD_CTLZ_ZERO_POISON, VT, LA_CUSTOM);
    }
  }

  for Op: u32.[ISD_FP16_TO_FP, ISD_STRICT_FP16_TO_FP, ISD_FP_TO_FP16,
                  ISD_STRICT_FP_TO_FP16]  {
    
    
    
    soa(st, 
        Op, MVT_f32, ifx (!st_useSoftFloat(st) && st_hasF16C(st)) then LA_CUSTOM else LA_EXPAND);
    
    soa(st, Op, MVT_f64, LA_EXPAND);
    soa(st, Op, MVT_f80, LA_EXPAND);
    soa(st, Op, MVT_f128, LA_EXPAND);
  }

  for VT: u32.[MVT_f32, MVT_f64, MVT_f80, MVT_f128]  {
    soa(st, ISD_STRICT_FP_TO_BF16, VT, LA_EXPAND);
    soa(st, ISD_STRICT_BF16_TO_FP, VT, LA_EXPAND);
  }

  for VT: u32.[MVT_f32, MVT_f64, MVT_f80, MVT_f128]  {
    slea(st, ISD_EXTLOAD, VT, MVT_f16, LA_EXPAND);
    slea(st, ISD_EXTLOAD, VT, MVT_bf16, LA_EXPAND);
    stsa(st, VT, MVT_f16, LA_EXPAND);
    stsa(st, VT, MVT_bf16, LA_EXPAND);

    soa(st, ISD_BF16_TO_FP, VT, LA_EXPAND);
    soa(st, ISD_FP_TO_BF16, VT, LA_CUSTOM);
  }

  soa(st, ISD_PARITY, MVT_i8, LA_CUSTOM);
  soa(st, ISD_PARITY, MVT_i16, LA_CUSTOM);
  soa(st, ISD_PARITY, MVT_i32, LA_CUSTOM);
  if (st_is64Bit(st))
    soa(st, ISD_PARITY, MVT_i64, LA_CUSTOM);
  if (st_hasPOPCNT(st)) {
    sopt(st, ISD_CTPOP, MVT_i8, MVT_i32);
    
    
    sopt(st, ISD_CTPOP, MVT_i16, MVT_i32);
  } else {
    soa(st, ISD_CTPOP          , MVT_i8   , LA_CUSTOM);
    soa(st, ISD_CTPOP          , MVT_i16  , LA_CUSTOM);
    soa(st, ISD_CTPOP          , MVT_i32  , LA_CUSTOM);
    soa(st, ISD_CTPOP          , MVT_i64  , LA_CUSTOM);
  }

  if (st_hasBMI2(st)) {
    soa(st, u32.[ISD_PEXT, ISD_PDEP], MVT_i8, LA_PROMOTE);
    soa(st, u32.[ISD_PEXT, ISD_PDEP], MVT_i16, LA_PROMOTE);
    soa(st, u32.[ISD_PEXT, ISD_PDEP], MVT_i32, LA_LEGAL);
    if (st_is64Bit(st))
      soa(st, u32.[ISD_PEXT, ISD_PDEP], MVT_i64, LA_LEGAL);
  }

  soa(st, ISD_READCYCLECOUNTER , MVT_i64  , LA_CUSTOM);

  if (!st_hasMOVBE(st))
    soa(st, ISD_BSWAP          , MVT_i16  , LA_EXPAND);

  
  for VT: u32.[ MVT_f32, MVT_f64, MVT_f80, MVT_f128 ]  {
    soa(st, ISD_SELECT, VT, LA_CUSTOM);
    soa(st, ISD_SETCC, VT, LA_CUSTOM);
    soa(st, ISD_STRICT_FSETCC, VT, LA_CUSTOM);
    soa(st, ISD_STRICT_FSETCCS, VT, LA_CUSTOM);
  }
  for VT: u32.[ MVT_i8, MVT_i16, MVT_i32, MVT_i64 ]  {
    if (VT == MVT_i64 && !st_is64Bit(st))
      continue;
    soa(st, ISD_SELECT, VT, LA_CUSTOM);
    soa(st, ISD_SETCC,  VT, LA_CUSTOM);
  }

  soa(st, ISD_COND_LOOP, MVT_Other, LA_CUSTOM);

  
  soa(st, ISD_SELECT, MVT_x86mmx, LA_CUSTOM);
  soa(st, ISD_SELECT_CC, MVT_x86mmx, LA_EXPAND);

  soa(st, ISD_EH_RETURN       , MVT_Other, LA_CUSTOM);
  
  
  soa(st, ISD_EH_SJLJ_SETJMP, MVT_i32, LA_CUSTOM);
  soa(st, ISD_EH_SJLJ_LONGJMP, MVT_Other, LA_CUSTOM);
  soa(st, ISD_EH_SJLJ_SETUP_DISPATCH, MVT_Other, LA_CUSTOM);

  
  for VT: u32.[ MVT_i32, MVT_i64 ]  {
    if (VT == MVT_i64 && !st_is64Bit(st))
      continue;
    soa(st, ISD_ConstantPool    , VT, LA_CUSTOM);
    soa(st, ISD_JumpTable       , VT, LA_CUSTOM);
    soa(st, ISD_GlobalAddress   , VT, LA_CUSTOM);
    soa(st, ISD_GlobalTLSAddress, VT, LA_CUSTOM);
    soa(st, ISD_ExternalSymbol  , VT, LA_CUSTOM);
    soa(st, ISD_BlockAddress    , VT, LA_CUSTOM);
  }

  
  for VT: u32.[ MVT_i32, MVT_i64 ]  {
    if (VT == MVT_i64 && !st_is64Bit(st))
      continue;
    soa(st, ISD_SHL_PARTS, VT, LA_CUSTOM);
    soa(st, ISD_SRA_PARTS, VT, LA_CUSTOM);
    soa(st, ISD_SRL_PARTS, VT, LA_CUSTOM);
  }

  if (st_hasSSEPrefetch(st))
    soa(st, ISD_PREFETCH      , MVT_Other, LA_CUSTOM);

  soa(st, ISD_ATOMIC_FENCE  , MVT_Other, LA_CUSTOM);

  
  for VT: u32.[ MVT_i8, MVT_i16, MVT_i32, MVT_i64 ]  {
    soa(st, ISD_ATOMIC_CMP_SWAP_WITH_SUCCESS, VT, LA_CUSTOM);
    soa(st, ISD_ATOMIC_LOAD_SUB, VT, LA_CUSTOM);
    soa(st, ISD_ATOMIC_LOAD_ADD, VT, LA_CUSTOM);
    soa(st, ISD_ATOMIC_LOAD_OR, VT, LA_CUSTOM);
    soa(st, ISD_ATOMIC_LOAD_XOR, VT, LA_CUSTOM);
    soa(st, ISD_ATOMIC_LOAD_AND, VT, LA_CUSTOM);
    soa(st, ISD_ATOMIC_STORE, VT, LA_CUSTOM);
  }

  if (!st_is64Bit(st))
    soa(st, ISD_ATOMIC_LOAD, MVT_i64, LA_CUSTOM);

  if (st_is64Bit(st) && st_hasAVX(st)) {
    
    
    soa(st, ISD_ATOMIC_LOAD, MVT_i128, LA_CUSTOM);
    soa(st, ISD_ATOMIC_STORE, MVT_i128, LA_CUSTOM);
  }

  if (st_canUseCMPXCHG16B(st))
    soa(st, ISD_ATOMIC_CMP_SWAP_WITH_SUCCESS, MVT_i128, LA_CUSTOM);

  
  if (!st_isTargetDarwin(st) && !st_isTargetELF(st) &&
      !st_isTargetCygMing(st) && !st_isTargetWin64(st) &&
      true) {
    soa(st, ISD_EH_LABEL, MVT_Other, LA_EXPAND);
  }

  soa(st, ISD_FRAME_TO_ARGS_OFFSET, MVT_i32, LA_CUSTOM);
  soa(st, ISD_FRAME_TO_ARGS_OFFSET, MVT_i64, LA_CUSTOM);

  soa(st, ISD_INIT_TRAMPOLINE, MVT_Other, LA_CUSTOM);
  soa(st, ISD_ADJUST_TRAMPOLINE, MVT_Other, LA_CUSTOM);

  soa(st, ISD_TRAP, MVT_Other, LA_LEGAL);
  soa(st, ISD_DEBUGTRAP, MVT_Other, LA_LEGAL);
  if (st_isTargetPS(st))
    soa(st, ISD_UBSANTRAP, MVT_Other, LA_EXPAND);
  else
    soa(st, ISD_UBSANTRAP, MVT_Other, LA_LEGAL);

  
  soa(st, ISD_VASTART           , MVT_Other, LA_CUSTOM);
  soa(st, ISD_VAEND             , MVT_Other, LA_EXPAND);
  Is64Bit := st_is64Bit(st);
  soa(st, ISD_VAARG,  MVT_Other, ifx Is64Bit then LA_CUSTOM else LA_EXPAND);
  soa(st, ISD_VACOPY, MVT_Other, ifx Is64Bit then LA_CUSTOM else LA_EXPAND);

  soa(st, ISD_STACKSAVE,          MVT_Other, LA_EXPAND);
  soa(st, ISD_STACKRESTORE,       MVT_Other, LA_EXPAND);

  soa(st, ISD_DYNAMIC_STACKALLOC, PtrVT, LA_CUSTOM);

  
  soa(st, ISD_GC_TRANSITION_START, MVT_Other, LA_CUSTOM);
  soa(st, ISD_GC_TRANSITION_END, MVT_Other, LA_CUSTOM);

  soa(st, ISD_STRICT_FP_EXTEND, MVT_f64, LA_LEGAL);

  

  if (!st_useSoftFloat(st) && st_hasSSE2(st)) {
    
    
    add_reg_class(st, MVT_f16);
    add_reg_class(st, MVT_f32);
    add_reg_class(st, MVT_f64);

    
    
    
    
    slea(st, ISD_EXTLOAD, MVT_f64, MVT_f32, LA_EXPAND);

    for VT: u32.[ MVT_f32, MVT_f64 ]  {
      
      soa(st, ISD_FABS, VT, LA_CUSTOM);

      
      soa(st, ISD_FNEG, VT, LA_CUSTOM);

      
      soa(st, ISD_FCOPYSIGN, VT, LA_CUSTOM);

      
      soa(st, ISD_FADD, VT, LA_CUSTOM);
      soa(st, ISD_FSUB, VT, LA_CUSTOM);

      
      soa(st, ISD_FSIN   , VT, LA_EXPAND);
      soa(st, ISD_FCOS   , VT, LA_EXPAND);
      soa(st, ISD_FSINCOS, VT, LA_EXPAND);
    }

    
    set_f16_action(st, MVT_f16, LA_PROMOTE);
    soa(st, ISD_FADD, MVT_f16, LA_PROMOTE);
    soa(st, ISD_FSUB, MVT_f16, LA_PROMOTE);
    soa(st, ISD_FMUL, MVT_f16, LA_PROMOTE);
    soa(st, ISD_FDIV, MVT_f16, LA_PROMOTE);
    soa(st, ISD_FABS, MVT_f16, LA_CUSTOM);
    soa(st, ISD_FNEG, MVT_f16, LA_CUSTOM);
    soa(st, ISD_FCOPYSIGN, MVT_f16, LA_CUSTOM);
    soa(st, ISD_FP_ROUND, MVT_f16, LA_CUSTOM);
    soa(st, ISD_FP_EXTEND, MVT_f32, LA_CUSTOM);
    soa(st, ISD_FP_EXTEND, MVT_f64, LA_CUSTOM);

    soa(st, ISD_STRICT_FADD, MVT_f16, LA_PROMOTE);
    soa(st, ISD_STRICT_FSUB, MVT_f16, LA_PROMOTE);
    soa(st, ISD_STRICT_FMUL, MVT_f16, LA_PROMOTE);
    soa(st, ISD_STRICT_FDIV, MVT_f16, LA_PROMOTE);
    soa(st, ISD_STRICT_FMA, MVT_f16, LA_PROMOTE);
    soa(st, ISD_STRICT_FMINNUM, MVT_f16, LA_PROMOTE);
    soa(st, ISD_STRICT_FMAXNUM, MVT_f16, LA_PROMOTE);
    soa(st, ISD_STRICT_FMINIMUM, MVT_f16, LA_PROMOTE);
    soa(st, ISD_STRICT_FMAXIMUM, MVT_f16, LA_PROMOTE);
    soa(st, ISD_STRICT_FSQRT, MVT_f16, LA_PROMOTE);
    soa(st, ISD_STRICT_FPOW, MVT_f16, LA_PROMOTE);
    soa(st, ISD_STRICT_FLDEXP, MVT_f16, LA_PROMOTE);
    soa(st, ISD_STRICT_FLOG, MVT_f16, LA_PROMOTE);
    soa(st, ISD_STRICT_FLOG2, MVT_f16, LA_PROMOTE);
    soa(st, ISD_STRICT_FLOG10, MVT_f16, LA_PROMOTE);
    soa(st, ISD_STRICT_FEXP, MVT_f16, LA_PROMOTE);
    soa(st, ISD_STRICT_FEXP2, MVT_f16, LA_PROMOTE);
    soa(st, ISD_STRICT_FCEIL, MVT_f16, LA_PROMOTE);
    soa(st, ISD_STRICT_FFLOOR, MVT_f16, LA_PROMOTE);
    soa(st, ISD_STRICT_FNEARBYINT, MVT_f16, LA_PROMOTE);
    soa(st, ISD_STRICT_FRINT, MVT_f16, LA_PROMOTE);
    soa(st, ISD_STRICT_FSETCC, MVT_f16, LA_PROMOTE);
    soa(st, ISD_STRICT_FSETCCS, MVT_f16, LA_PROMOTE);
    soa(st, ISD_STRICT_FROUND, MVT_f16, LA_PROMOTE);
    soa(st, ISD_STRICT_FROUNDEVEN, MVT_f16, LA_PROMOTE);
    soa(st, ISD_STRICT_FTRUNC, MVT_f16, LA_PROMOTE);
    soa(st, ISD_STRICT_FP_ROUND, MVT_f16, LA_CUSTOM);
    soa(st, ISD_STRICT_FP_EXTEND, MVT_f32, LA_CUSTOM);
    soa(st, ISD_STRICT_FP_EXTEND, MVT_f64, LA_CUSTOM);

    soa(st, ISD_LLROUND, MVT_f16, LA_EXPAND);
    soa(st, ISD_LROUND, MVT_f16, LA_EXPAND);
    soa(st, ISD_LRINT, MVT_f16, LA_EXPAND);
    soa(st, ISD_LLRINT, MVT_f16, LA_EXPAND);

    soa(st, ISD_STRICT_LLROUND, MVT_f16, LA_PROMOTE);
    soa(st, ISD_STRICT_LROUND, MVT_f16, LA_PROMOTE);
    soa(st, ISD_STRICT_LRINT, MVT_f16, LA_PROMOTE);
    soa(st, ISD_STRICT_LLRINT, MVT_f16, LA_PROMOTE);

    
    soa(st, ISD_FGETSIGN, MVT_i64, LA_CUSTOM);
    soa(st, ISD_FGETSIGN, MVT_i32, LA_CUSTOM);

  } else if (!st_useSoftFloat(st) && st_hasSSE1(st) &&
             (UseX87 || Is64Bit)) {
    
    
    add_reg_class(st, MVT_f32);
    if (UseX87)
      add_reg_class(st, MVT_f64);

    
    soa(st, ISD_FABS , MVT_f32, LA_CUSTOM);

    
    soa(st, ISD_FNEG , MVT_f32, LA_CUSTOM);

    if (UseX87)
      soa(st, ISD_UNDEF, MVT_f64, LA_EXPAND);

    
    if (UseX87)
      soa(st, ISD_FCOPYSIGN, MVT_f64, LA_EXPAND);
    soa(st, ISD_FCOPYSIGN, MVT_f32, LA_CUSTOM);

    
    soa(st, ISD_FSIN   , MVT_f32, LA_EXPAND);
    soa(st, ISD_FCOS   , MVT_f32, LA_EXPAND);
    soa(st, ISD_FSINCOS, MVT_f32, LA_EXPAND);

    if (UseX87) {
      
      soa(st, ISD_FSIN, MVT_f64, LA_EXPAND);
      soa(st, ISD_FCOS, MVT_f64, LA_EXPAND);
      soa(st, ISD_FSINCOS, MVT_f64, LA_EXPAND);
    }
  } else if (UseX87) {
    
    
    add_reg_class(st, MVT_f64);
    add_reg_class(st, MVT_f32);

    for VT: u32.[ MVT_f32, MVT_f64 ]  {
      soa(st, ISD_UNDEF,     VT, LA_EXPAND);
      soa(st, ISD_FCOPYSIGN, VT, LA_EXPAND);

      
      soa(st, ISD_FSIN   , VT, LA_EXPAND);
      soa(st, ISD_FCOS   , VT, LA_EXPAND);
      soa(st, ISD_FSINCOS, VT, LA_EXPAND);
    }
  }

  
  if (is_type_legal_mvt(st, MVT_f32)) {
    if (UseX87 && (false)) {
      {} 
      {} 
      {} 
      {} 
    } else 
      {} 
  }
  
  if (is_type_legal_mvt(st, MVT_f64)) {
    if (UseX87 && false) {
      {} 
      {} 
      {} 
      {} 
    } else 
      {} 
  }
  
  if (is_type_legal_mvt(st, MVT_f16))
    {}

  
  soa(st, ISD_STRICT_FADD,      MVT_f32, LA_LEGAL);
  soa(st, ISD_STRICT_FADD,      MVT_f64, LA_LEGAL);
  soa(st, ISD_STRICT_FSUB,      MVT_f32, LA_LEGAL);
  soa(st, ISD_STRICT_FSUB,      MVT_f64, LA_LEGAL);
  soa(st, ISD_STRICT_FMUL,      MVT_f32, LA_LEGAL);
  soa(st, ISD_STRICT_FMUL,      MVT_f64, LA_LEGAL);
  soa(st, ISD_STRICT_FDIV,      MVT_f32, LA_LEGAL);
  soa(st, ISD_STRICT_FDIV,      MVT_f64, LA_LEGAL);
  soa(st, ISD_STRICT_FP_ROUND,  MVT_f32, LA_LEGAL);
  soa(st, ISD_STRICT_FP_ROUND,  MVT_f64, LA_LEGAL);
  soa(st, ISD_STRICT_FSQRT,     MVT_f32, LA_LEGAL);
  soa(st, ISD_STRICT_FSQRT,     MVT_f64, LA_LEGAL);

  
  soa(st, ISD_FMA, MVT_f64, LA_EXPAND);
  soa(st, ISD_FMA, MVT_f32, LA_EXPAND);

  
  if (UseX87) {
    add_reg_class(st, MVT_f80);
    soa(st, ISD_UNDEF,     MVT_f80, LA_EXPAND);
    soa(st, ISD_FCOPYSIGN, MVT_f80, LA_EXPAND);
    {
      {}
      {}  
      {}
      {}  

      {}
      {}
      {}
      {}  
      {}
      {}  
    }

    
    
    soa(st, ISD_FSIN   , MVT_f80, LA_EXPAND);
    soa(st, ISD_FCOS   , MVT_f80, LA_EXPAND);
    soa(st, ISD_FSINCOS, MVT_f80, LA_EXPAND);
    soa(st, ISD_FTAN   , MVT_f80, LA_EXPAND);
    soa(st, ISD_FASIN  , MVT_f80, LA_EXPAND);
    soa(st, ISD_FACOS  , MVT_f80, LA_EXPAND);
    soa(st, ISD_FATAN  , MVT_f80, LA_EXPAND);
    soa(st, ISD_FATAN2 , MVT_f80, LA_EXPAND);
    soa(st, ISD_FSINH  , MVT_f80, LA_EXPAND);
    soa(st, ISD_FCOSH  , MVT_f80, LA_EXPAND);
    soa(st, ISD_FTANH  , MVT_f80, LA_EXPAND);
    

    soa(st, ISD_FFLOOR, MVT_f80, LA_EXPAND);
    soa(st, ISD_FCEIL,  MVT_f80, LA_EXPAND);
    soa(st, ISD_FTRUNC, MVT_f80, LA_EXPAND);
    soa(st, ISD_FRINT,  MVT_f80, LA_EXPAND);
    soa(st, ISD_FNEARBYINT, MVT_f80, LA_EXPAND);
    soa(st, ISD_FROUNDEVEN, MVT_f80, LA_EXPAND);
    soa(st, ISD_FMA, MVT_f80, LA_EXPAND);
    soa(st, ISD_LROUND, MVT_f80, LA_LIBCALL);
    soa(st, ISD_LLROUND, MVT_f80, LA_LIBCALL);
    soa(st, ISD_LRINT, MVT_f80, LA_CUSTOM);
    soa(st, ISD_LLRINT, MVT_f80, LA_CUSTOM);

    
    soa(st, ISD_STRICT_FADD     , MVT_f80, LA_LEGAL);
    soa(st, ISD_STRICT_FSUB     , MVT_f80, LA_LEGAL);
    soa(st, ISD_STRICT_FMUL     , MVT_f80, LA_LEGAL);
    soa(st, ISD_STRICT_FDIV     , MVT_f80, LA_LEGAL);
    soa(st, ISD_STRICT_FSQRT    , MVT_f80, LA_LEGAL);
    soa(st, ISD_FCANONICALIZE, MVT_f80, LA_EXPAND);
    if (is_type_legal_mvt(st, MVT_f16)) {
      soa(st, ISD_FP_EXTEND, MVT_f80, LA_CUSTOM);
      soa(st, ISD_STRICT_FP_EXTEND, MVT_f80, LA_CUSTOM);
    } else {
      soa(st, ISD_STRICT_FP_EXTEND, MVT_f80, LA_LEGAL);
    }
    
    
    soa(st, ISD_STRICT_FP_ROUND, MVT_f80, LA_LEGAL);
  }

  
  if (!st_useSoftFloat(st) && st_is64Bit(st) && st_hasSSE1(st)) {
    add_reg_class(st, MVT_f128);

    {} 

    soa(st, ISD_FADD,        MVT_f128, LA_LIBCALL);
    soa(st, ISD_STRICT_FADD, MVT_f128, LA_LIBCALL);
    soa(st, ISD_FSUB,        MVT_f128, LA_LIBCALL);
    soa(st, ISD_STRICT_FSUB, MVT_f128, LA_LIBCALL);
    soa(st, ISD_FDIV,        MVT_f128, LA_LIBCALL);
    soa(st, ISD_STRICT_FDIV, MVT_f128, LA_LIBCALL);
    soa(st, ISD_FMUL,        MVT_f128, LA_LIBCALL);
    soa(st, ISD_STRICT_FMUL, MVT_f128, LA_LIBCALL);
    soa(st, ISD_FMA,         MVT_f128, LA_LIBCALL);
    soa(st, ISD_STRICT_FMA,  MVT_f128, LA_LIBCALL);

    soa(st, ISD_FABS, MVT_f128, LA_CUSTOM);
    soa(st, ISD_FNEG, MVT_f128, LA_CUSTOM);
    soa(st, ISD_FCOPYSIGN, MVT_f128, LA_CUSTOM);

    
    soa(st, ISD_FSIN,         MVT_f128, LA_LIBCALL);
    soa(st, ISD_STRICT_FSIN,  MVT_f128, LA_LIBCALL);
    soa(st, ISD_FCOS,         MVT_f128, LA_LIBCALL);
    soa(st, ISD_STRICT_FCOS,  MVT_f128, LA_LIBCALL);
    soa(st, ISD_FSINCOS,      MVT_f128, LA_LIBCALL);
    soa(st, ISD_FTAN,         MVT_f128, LA_LIBCALL);
    soa(st, ISD_STRICT_FTAN,  MVT_f128, LA_LIBCALL);
    
    
    soa(st, ISD_FSQRT,        MVT_f128, LA_LIBCALL);
    soa(st, ISD_STRICT_FSQRT, MVT_f128, LA_LIBCALL);

    soa(st, ISD_FP_EXTEND,        MVT_f128, LA_CUSTOM);
    soa(st, ISD_STRICT_FP_EXTEND, MVT_f128, LA_CUSTOM);
    
    
    
    if (is_type_legal_mvt(st, MVT_f32)) {
      soa(st, ISD_FP_ROUND, MVT_f32, LA_CUSTOM);
      soa(st, ISD_STRICT_FP_ROUND, MVT_f32, LA_CUSTOM);
    }
    if (is_type_legal_mvt(st, MVT_f64)) {
      soa(st, ISD_FP_ROUND, MVT_f64, LA_CUSTOM);
      soa(st, ISD_STRICT_FP_ROUND, MVT_f64, LA_CUSTOM);
    }
    if (is_type_legal_mvt(st, MVT_f80)) {
      soa(st, ISD_FP_ROUND, MVT_f80, LA_CUSTOM);
      soa(st, ISD_STRICT_FP_ROUND, MVT_f80, LA_CUSTOM);
      soa(st, ISD_FCANONICALIZE, MVT_f80, LA_EXPAND);
    }

    soa(st, ISD_SETCC, MVT_f128, LA_CUSTOM);

    slea(st, ISD_EXTLOAD, MVT_f128, MVT_f32, LA_EXPAND);
    slea(st, ISD_EXTLOAD, MVT_f128, MVT_f64, LA_EXPAND);
    slea(st, ISD_EXTLOAD, MVT_f128, MVT_f80, LA_EXPAND);
    stsa(st, MVT_f128, MVT_f32, LA_EXPAND);
    stsa(st, MVT_f128, MVT_f64, LA_EXPAND);
    stsa(st, MVT_f128, MVT_f80, LA_EXPAND);
  }

  
  soa(st, ISD_FPOW             , MVT_f32  , LA_EXPAND);
  soa(st, ISD_FPOW             , MVT_f64  , LA_EXPAND);
  soa(st, ISD_FPOW             , MVT_f80  , LA_EXPAND);
  soa(st, ISD_FPOW             , MVT_f128 , LA_EXPAND);

  soa(st, ISD_FLOG, MVT_f80, LA_EXPAND);
  soa(st, ISD_FLOG2, MVT_f80, LA_EXPAND);
  soa(st, ISD_FLOG10, MVT_f80, LA_EXPAND);
  soa(st, ISD_FEXP, MVT_f80, LA_EXPAND);
  soa(st, ISD_FEXP2, MVT_f80, LA_EXPAND);
  soa(st, ISD_FEXP10, MVT_f80, LA_EXPAND);
  soa(st, ISD_FMINNUM, MVT_f80, LA_EXPAND);
  soa(st, ISD_FMAXNUM, MVT_f80, LA_EXPAND);

  
  for VT: u32.[ MVT_v8f16, MVT_v16f16, MVT_v32f16,
                   MVT_v4f32, MVT_v8f32,  MVT_v16f32,
                   MVT_v2f64, MVT_v4f64,  MVT_v8f64 ]  {
    
    soa(st, ISD_FSIN,      VT, LA_EXPAND);
    soa(st, ISD_FSINCOS,   VT, LA_EXPAND);
    soa(st, ISD_FCOS,      VT, LA_EXPAND);
    soa(st, ISD_FTAN,      VT, LA_EXPAND);
    soa(st, ISD_FREM,      VT, LA_EXPAND);
    soa(st, ISD_FCOPYSIGN, VT, LA_EXPAND);
    soa(st, ISD_FPOW,      VT, LA_EXPAND);
    soa(st, ISD_FLOG,      VT, LA_EXPAND);
    soa(st, ISD_FLOG2,     VT, LA_EXPAND);
    soa(st, ISD_FLOG10,    VT, LA_EXPAND);
    soa(st, ISD_FEXP,      VT, LA_EXPAND);
    soa(st, ISD_FEXP2,     VT, LA_EXPAND);
    soa(st, ISD_FEXP10,    VT, LA_EXPAND);
    
  }

  
  
  
  for VT: mvt_fixedlen_vector_valuetypes()  {
    soa(st, ISD_SDIV, VT, LA_EXPAND);
    soa(st, ISD_UDIV, VT, LA_EXPAND);
    soa(st, ISD_SREM, VT, LA_EXPAND);
    soa(st, ISD_UREM, VT, LA_EXPAND);
    soa(st, ISD_EXTRACT_VECTOR_ELT, VT,LA_EXPAND);
    soa(st, ISD_INSERT_VECTOR_ELT, VT, LA_EXPAND);
    soa(st, ISD_EXTRACT_SUBVECTOR, VT,LA_EXPAND);
    soa(st, ISD_INSERT_SUBVECTOR, VT,LA_EXPAND);
    soa(st, ISD_FMA,  VT, LA_EXPAND);
    soa(st, ISD_FFLOOR, VT, LA_EXPAND);
    soa(st, ISD_FCEIL, VT, LA_EXPAND);
    soa(st, ISD_FTRUNC, VT, LA_EXPAND);
    soa(st, ISD_FRINT, VT, LA_EXPAND);
    soa(st, ISD_FNEARBYINT, VT, LA_EXPAND);
    soa(st, ISD_FROUNDEVEN, VT, LA_EXPAND);
    soa(st, ISD_SMUL_LOHI, VT, LA_EXPAND);
    soa(st, ISD_MULHS, VT, LA_EXPAND);
    soa(st, ISD_UMUL_LOHI, VT, LA_EXPAND);
    soa(st, ISD_MULHU, VT, LA_EXPAND);
    soa(st, ISD_SDIVREM, VT, LA_EXPAND);
    soa(st, ISD_UDIVREM, VT, LA_EXPAND);
    soa(st, ISD_CTPOP, VT, LA_EXPAND);
    soa(st, ISD_CTTZ, VT, LA_EXPAND);
    soa(st, ISD_CTLZ, VT, LA_EXPAND);
    soa(st, ISD_ROTL, VT, LA_EXPAND);
    soa(st, ISD_ROTR, VT, LA_EXPAND);
    soa(st, ISD_BSWAP, VT, LA_EXPAND);
    soa(st, ISD_SETCC, VT, LA_EXPAND);
    soa(st, ISD_FP_TO_UINT, VT, LA_EXPAND);
    soa(st, ISD_FP_TO_SINT, VT, LA_EXPAND);
    soa(st, ISD_UINT_TO_FP, VT, LA_EXPAND);
    soa(st, ISD_SINT_TO_FP, VT, LA_EXPAND);
    soa(st, ISD_SIGN_EXTEND_INREG, VT,LA_EXPAND);
    soa(st, ISD_TRUNCATE, VT, LA_EXPAND);
    soa(st, ISD_SIGN_EXTEND, VT, LA_EXPAND);
    soa(st, ISD_ZERO_EXTEND, VT, LA_EXPAND);
    soa(st, ISD_ANY_EXTEND, VT, LA_EXPAND);
    soa(st, ISD_SELECT_CC, VT, LA_EXPAND);
    for InnerVT: mvt_fixedlen_vector_valuetypes()  {
      stsa(st, InnerVT, VT, LA_EXPAND);

      slea(st, ISD_SEXTLOAD, InnerVT, VT, LA_EXPAND);
      slea(st, ISD_ZEXTLOAD, InnerVT, VT, LA_EXPAND);

      
      
      
      
      if (mvt_elt(VT) == MVT_i1)
        slea(st, ISD_EXTLOAD, InnerVT, VT, LA_EXPAND);

      
      
      if (mvt_elt(VT) == MVT_f16 ||
          mvt_elt(VT) == MVT_bf16)
        slea(st, ISD_EXTLOAD, InnerVT, VT, LA_EXPAND);
    }
  }

  
  
  if (!st_useSoftFloat(st) && st_hasMMX(st)) {
    add_reg_class(st, MVT_x86mmx);
    
  }

  

  if (!st_useSoftFloat(st) && st_hasSSE1(st)) {
    add_reg_class(st, MVT_v4f32);

    set_fp_min_max_action(st, MVT_f32);

    soa(st, ISD_FNEG,               MVT_v4f32, LA_CUSTOM);
    soa(st, ISD_FABS,               MVT_v4f32, LA_CUSTOM);
    soa(st, ISD_FCOPYSIGN,          MVT_v4f32, LA_CUSTOM);
    soa(st, ISD_BUILD_VECTOR,       MVT_v4f32, LA_CUSTOM);
    soa(st, ISD_VECTOR_SHUFFLE,     MVT_v4f32, LA_CUSTOM);
    soa(st, ISD_VSELECT,            MVT_v4f32, LA_CUSTOM);
    soa(st, ISD_EXTRACT_VECTOR_ELT, MVT_v4f32, LA_CUSTOM);
    soa(st, ISD_SELECT,             MVT_v4f32, LA_CUSTOM);
    soa(st, ISD_FCANONICALIZE, MVT_v4f32, LA_EXPAND);

    soa(st, ISD_LOAD,               MVT_v2f32, LA_CUSTOM);
    soa(st, ISD_STORE,              MVT_v2f32, LA_CUSTOM);
    soa(st, ISD_FCANONICALIZE, MVT_v2f32, LA_EXPAND);

    soa(st, ISD_STRICT_FADD,        MVT_v4f32, LA_LEGAL);
    soa(st, ISD_STRICT_FSUB,        MVT_v4f32, LA_LEGAL);
    soa(st, ISD_STRICT_FMUL,        MVT_v4f32, LA_LEGAL);
    soa(st, ISD_STRICT_FDIV,        MVT_v4f32, LA_LEGAL);
    soa(st, ISD_STRICT_FSQRT,       MVT_v4f32, LA_LEGAL);
  }

  if (!st_useSoftFloat(st) && st_hasSSE2(st)) {
    add_reg_class(st, MVT_v2f64);

    
    
    add_reg_class(st, MVT_v16i8);
    add_reg_class(st, MVT_v8i16);
    add_reg_class(st, MVT_v8f16);
    add_reg_class(st, MVT_v4i32);
    add_reg_class(st, MVT_v2i64);

    for VT: u32.[ MVT_f64, MVT_v4f32, MVT_v2f64 ] 
      set_fp_min_max_action(st, VT);

    soa(st, ISD_MUL,                MVT_v2i8,  LA_CUSTOM);
    soa(st, ISD_MUL,                MVT_v4i8,  LA_CUSTOM);
    soa(st, ISD_MUL,                MVT_v8i8,  LA_CUSTOM);

    soa(st, ISD_MUL,                MVT_v16i8, LA_CUSTOM);
    soa(st, ISD_MUL,                MVT_v4i32, LA_CUSTOM);
    soa(st, ISD_MUL,                MVT_v2i64, LA_CUSTOM);
    soa(st, ISD_MULHU,              MVT_v4i32, LA_CUSTOM);
    soa(st, ISD_MULHS,              MVT_v4i32, LA_CUSTOM);
    soa(st, ISD_MULHU,              MVT_v16i8, LA_CUSTOM);
    soa(st, ISD_MULHS,              MVT_v16i8, LA_CUSTOM);
    soa(st, ISD_MULHU,              MVT_v8i16, LA_LEGAL);
    soa(st, ISD_MULHS,              MVT_v8i16, LA_LEGAL);
    soa(st, ISD_MUL,                MVT_v8i16, LA_LEGAL);
    soa(st, ISD_AVGCEILU,           MVT_v16i8, LA_LEGAL);
    soa(st, ISD_AVGCEILU,           MVT_v8i16, LA_LEGAL);

    soa(st, ISD_SMULO,              MVT_v16i8, LA_CUSTOM);
    soa(st, ISD_UMULO,              MVT_v16i8, LA_CUSTOM);
    soa(st, ISD_UMULO,              MVT_v2i32, LA_CUSTOM);

    soa(st, ISD_FNEG,               MVT_v2f64, LA_CUSTOM);
    soa(st, ISD_FCANONICALIZE, MVT_v2f64, LA_EXPAND);
    soa(st, ISD_FABS,               MVT_v2f64, LA_CUSTOM);
    soa(st, ISD_FCOPYSIGN,          MVT_v2f64, LA_CUSTOM);

    soa(st, ISD_LRINT, MVT_v4f32, LA_CUSTOM);
    soa(st, ISD_LRINT, MVT_v2i32, LA_CUSTOM);

    soa(st, ISD_AND, MVT_i128, LA_CUSTOM);
    soa(st, ISD_OR, MVT_i128, LA_CUSTOM);
    soa(st, ISD_XOR, MVT_i128, LA_CUSTOM);
    soa(st, ISD_SELECT, MVT_i128, LA_CUSTOM);

    if (st_hasPCLMUL(st)) {
      for VT: u32.[MVT_i64, MVT_v4i32, MVT_v2i64]  {
        soa(st, ISD_CLMUL, VT, LA_CUSTOM);
        soa(st, ISD_CLMULH, VT, LA_CUSTOM);
      }
      soa(st, ISD_CLMUL, MVT_i32, LA_CUSTOM);
      soa(st, ISD_CLMUL, MVT_i16, LA_CUSTOM);
      soa(st, ISD_CLMUL, MVT_i8, LA_CUSTOM);
    }

    for VT: u32.[ MVT_v16i8, MVT_v8i16, MVT_v4i32, MVT_v2i64 ]  {
      soa(st, ISD_SMAX, VT, ifx VT == MVT_v8i16 then LA_LEGAL else LA_CUSTOM);
      soa(st, ISD_SMIN, VT, ifx VT == MVT_v8i16 then LA_LEGAL else LA_CUSTOM);
      soa(st, ISD_UMAX, VT, ifx VT == MVT_v16i8 then LA_LEGAL else LA_CUSTOM);
      soa(st, ISD_UMIN, VT, ifx VT == MVT_v16i8 then LA_LEGAL else LA_CUSTOM);
      soa(st, ISD_VECREDUCE_AND, VT, LA_CUSTOM);
      soa(st, ISD_VECREDUCE_OR, VT, LA_CUSTOM);
      soa(st, ISD_VECREDUCE_XOR, VT, LA_CUSTOM);
    }

    
    
    
    for VT: u32.[MVT_v16i8, MVT_v8i16, MVT_v4i32, MVT_v2i64, MVT_i64]  {
      soa(st, ISD_VECREDUCE_MUL,  VT, LA_CUSTOM);
      soa(st, ISD_VECREDUCE_SMAX, VT, LA_CUSTOM);
      soa(st, ISD_VECREDUCE_SMIN, VT, LA_CUSTOM);
      soa(st, ISD_VECREDUCE_UMAX, VT, LA_CUSTOM);
      soa(st, ISD_VECREDUCE_UMIN, VT, LA_CUSTOM);
    }

    soa(st, ISD_UADDSAT,            MVT_v16i8, LA_LEGAL);
    soa(st, ISD_SADDSAT,            MVT_v16i8, LA_LEGAL);
    soa(st, ISD_USUBSAT,            MVT_v16i8, LA_LEGAL);
    soa(st, ISD_SSUBSAT,            MVT_v16i8, LA_LEGAL);
    soa(st, ISD_UADDSAT,            MVT_v8i16, LA_LEGAL);
    soa(st, ISD_SADDSAT,            MVT_v8i16, LA_LEGAL);
    soa(st, ISD_USUBSAT,            MVT_v8i16, LA_LEGAL);
    soa(st, ISD_SSUBSAT,            MVT_v8i16, LA_LEGAL);
    soa(st, ISD_USUBSAT,            MVT_v4i32, LA_CUSTOM);
    soa(st, ISD_USUBSAT,            MVT_v2i64, LA_CUSTOM);

    soa(st, ISD_INSERT_VECTOR_ELT,  MVT_v16i8, LA_CUSTOM);
    soa(st, ISD_INSERT_VECTOR_ELT,  MVT_v8i16, LA_CUSTOM);
    soa(st, ISD_INSERT_VECTOR_ELT,  MVT_v4i32, LA_CUSTOM);
    soa(st, ISD_INSERT_VECTOR_ELT,  MVT_v4f32, LA_CUSTOM);

    for VT: u32.[ MVT_v16i8, MVT_v8i16, MVT_v4i32, MVT_v2i64 ]  {
      soa(st, ISD_SETCC, VT, LA_CUSTOM);
      soa(st, ISD_CTPOP, VT, LA_CUSTOM);
      soa(st, ISD_ABS, VT, LA_CUSTOM);
      soa(st, ISD_ABDS, VT, LA_CUSTOM);
      soa(st, ISD_ABDU, VT, LA_CUSTOM);

      
      
      scca(st, ISD_SETLT, VT, LA_CUSTOM);
      scca(st, ISD_SETLE, VT, LA_CUSTOM);
    }

    soa(st, ISD_SETCC,          MVT_v2f64, LA_CUSTOM);
    soa(st, ISD_SETCC,          MVT_v4f32, LA_CUSTOM);
    soa(st, ISD_STRICT_FSETCC,  MVT_v2f64, LA_CUSTOM);
    soa(st, ISD_STRICT_FSETCC,  MVT_v4f32, LA_CUSTOM);
    soa(st, ISD_STRICT_FSETCCS, MVT_v2f64, LA_CUSTOM);
    soa(st, ISD_STRICT_FSETCCS, MVT_v4f32, LA_CUSTOM);

    for VT: u32.[ MVT_v16i8, MVT_v8i16, MVT_v4i32 ]  {
      soa(st, ISD_SCALAR_TO_VECTOR,   VT, LA_CUSTOM);
      soa(st, ISD_BUILD_VECTOR,       VT, LA_CUSTOM);
      soa(st, ISD_VECTOR_SHUFFLE,     VT, LA_CUSTOM);
      soa(st, ISD_VSELECT,            VT, LA_CUSTOM);
      soa(st, ISD_EXTRACT_VECTOR_ELT, VT, LA_CUSTOM);
    }

    for VT: u32.[ MVT_v8f16, MVT_v2f64, MVT_v2i64 ]  {
      soa(st, ISD_BUILD_VECTOR,       VT, LA_CUSTOM);
      soa(st, ISD_VECTOR_SHUFFLE,     VT, LA_CUSTOM);
      soa(st, ISD_VSELECT,            VT, LA_CUSTOM);

      if (VT == MVT_v2i64 && !st_is64Bit(st))
        continue;

      soa(st, ISD_INSERT_VECTOR_ELT,  VT, LA_CUSTOM);
      soa(st, ISD_EXTRACT_VECTOR_ELT, VT, LA_CUSTOM);
    }
    set_f16_action(st, MVT_v8f16, LA_EXPAND);
    soa(st, ISD_FADD, MVT_v8f16, LA_EXPAND);
    soa(st, ISD_FSUB, MVT_v8f16, LA_EXPAND);
    soa(st, ISD_FMUL, MVT_v8f16, LA_EXPAND);
    soa(st, ISD_FDIV, MVT_v8f16, LA_EXPAND);
    soa(st, ISD_FNEG, MVT_v8f16, LA_CUSTOM);
    soa(st, ISD_FABS, MVT_v8f16, LA_CUSTOM);
    soa(st, ISD_FCOPYSIGN, MVT_v8f16, LA_CUSTOM);

    
    soa(st, ISD_SELECT,             MVT_v2f64, LA_CUSTOM);
    soa(st, ISD_SELECT,             MVT_v2i64, LA_CUSTOM);
    soa(st, ISD_SELECT,             MVT_v4i32, LA_CUSTOM);
    soa(st, ISD_SELECT,             MVT_v8i16, LA_CUSTOM);
    soa(st, ISD_SELECT,             MVT_v8f16, LA_CUSTOM);
    soa(st, ISD_SELECT,             MVT_v16i8, LA_CUSTOM);

    soa(st, ISD_FP_TO_SINT,         MVT_v4i32, LA_CUSTOM);
    soa(st, ISD_FP_TO_UINT,         MVT_v4i32, LA_CUSTOM);
    soa(st, ISD_FP_TO_SINT,         MVT_v2i32, LA_CUSTOM);
    soa(st, ISD_FP_TO_UINT,         MVT_v2i32, LA_CUSTOM);
    soa(st, ISD_STRICT_FP_TO_SINT,  MVT_v4i32, LA_CUSTOM);
    soa(st, ISD_STRICT_FP_TO_SINT,  MVT_v2i32, LA_CUSTOM);

    
    for VT: u32.[MVT_v2i8, MVT_v4i8, MVT_v8i8, MVT_v2i16, MVT_v4i16]  {
      soa(st, ISD_FP_TO_SINT,        VT, LA_CUSTOM);
      soa(st, ISD_FP_TO_UINT,        VT, LA_CUSTOM);
      soa(st, ISD_STRICT_FP_TO_SINT, VT, LA_CUSTOM);
      soa(st, ISD_STRICT_FP_TO_UINT, VT, LA_CUSTOM);
    }

    soa(st, ISD_SINT_TO_FP,         MVT_v4i32, LA_CUSTOM);
    soa(st, ISD_STRICT_SINT_TO_FP,  MVT_v4i32, LA_CUSTOM);
    soa(st, ISD_SINT_TO_FP,         MVT_v2i32, LA_CUSTOM);
    soa(st, ISD_STRICT_SINT_TO_FP,  MVT_v2i32, LA_CUSTOM);

    soa(st, ISD_UINT_TO_FP,         MVT_v2i32, LA_CUSTOM);
    soa(st, ISD_STRICT_UINT_TO_FP,  MVT_v2i32, LA_CUSTOM);

    soa(st, ISD_UINT_TO_FP,         MVT_v4i32, LA_CUSTOM);
    soa(st, ISD_STRICT_UINT_TO_FP,  MVT_v4i32, LA_CUSTOM);

    
    soa(st, ISD_SINT_TO_FP,         MVT_v2f32, LA_CUSTOM);
    soa(st, ISD_STRICT_SINT_TO_FP,  MVT_v2f32, LA_CUSTOM);
    soa(st, ISD_UINT_TO_FP,         MVT_v2f32, LA_CUSTOM);
    soa(st, ISD_STRICT_UINT_TO_FP,  MVT_v2f32, LA_CUSTOM);

    soa(st, ISD_FP_EXTEND,          MVT_v2f32, LA_CUSTOM);
    soa(st, ISD_STRICT_FP_EXTEND,   MVT_v2f32, LA_CUSTOM);
    soa(st, ISD_FP_ROUND,           MVT_v2f32, LA_CUSTOM);
    soa(st, ISD_STRICT_FP_ROUND,    MVT_v2f32, LA_CUSTOM);

    
    
    
    soa(st, ISD_LOAD,               MVT_v2i32, LA_CUSTOM);
    soa(st, ISD_LOAD,               MVT_v4i16, LA_CUSTOM);
    soa(st, ISD_LOAD,               MVT_v8i8,  LA_CUSTOM);
    soa(st, ISD_STORE,              MVT_v2i32, LA_CUSTOM);
    soa(st, ISD_STORE,              MVT_v4i16, LA_CUSTOM);
    soa(st, ISD_STORE,              MVT_v8i8,  LA_CUSTOM);

    
    soa(st, ISD_STORE,              MVT_v2i16, LA_CUSTOM);
    soa(st, ISD_STORE,              MVT_v4i8,  LA_CUSTOM);

    soa(st, ISD_BITCAST,            MVT_v2i32, LA_CUSTOM);
    soa(st, ISD_BITCAST,            MVT_v4i16, LA_CUSTOM);
    soa(st, ISD_BITCAST,            MVT_v8i8,  LA_CUSTOM);
    if (!st_hasAVX512(st))
      soa(st, ISD_BITCAST, MVT_v16i1, LA_CUSTOM);

    soa(st, ISD_SIGN_EXTEND_VECTOR_INREG, MVT_v2i64, LA_CUSTOM);
    soa(st, ISD_SIGN_EXTEND_VECTOR_INREG, MVT_v4i32, LA_CUSTOM);
    soa(st, ISD_SIGN_EXTEND_VECTOR_INREG, MVT_v8i16, LA_CUSTOM);

    soa(st, ISD_SIGN_EXTEND, MVT_v4i64, LA_CUSTOM);

    soa(st, ISD_TRUNCATE,    MVT_v2i8,  LA_CUSTOM);
    soa(st, ISD_TRUNCATE,    MVT_v2i16, LA_CUSTOM);
    soa(st, ISD_TRUNCATE,    MVT_v2i32, LA_CUSTOM);
    soa(st, ISD_TRUNCATE,    MVT_v2i64, LA_CUSTOM);
    soa(st, ISD_TRUNCATE,    MVT_v4i8,  LA_CUSTOM);
    soa(st, ISD_TRUNCATE,    MVT_v4i16, LA_CUSTOM);
    soa(st, ISD_TRUNCATE,    MVT_v4i32, LA_CUSTOM);
    soa(st, ISD_TRUNCATE,    MVT_v4i64, LA_CUSTOM);
    soa(st, ISD_TRUNCATE,    MVT_v8i8,  LA_CUSTOM);
    soa(st, ISD_TRUNCATE,    MVT_v8i16, LA_CUSTOM);
    soa(st, ISD_TRUNCATE,    MVT_v8i32, LA_CUSTOM);
    soa(st, ISD_TRUNCATE,    MVT_v8i64, LA_CUSTOM);
    soa(st, ISD_TRUNCATE,    MVT_v16i8, LA_CUSTOM);
    soa(st, ISD_TRUNCATE,    MVT_v16i16, LA_CUSTOM);
    soa(st, ISD_TRUNCATE,    MVT_v16i32, LA_CUSTOM);
    soa(st, ISD_TRUNCATE,    MVT_v16i64, LA_CUSTOM);

    
    
    for VT: u32.[ MVT_v16i8, MVT_v8i16, MVT_v4i32, MVT_v2i64 ]  {
      soa(st, ISD_SRL,              VT, LA_CUSTOM);
      soa(st, ISD_SHL,              VT, LA_CUSTOM);
      soa(st, ISD_SRA,              VT, LA_CUSTOM);
      if (VT == MVT_v2i64) continue;
      soa(st, ISD_ROTL,             VT, LA_CUSTOM);
      soa(st, ISD_ROTR,             VT, LA_CUSTOM);
      soa(st, ISD_FSHL,             VT, LA_CUSTOM);
      soa(st, ISD_FSHR,             VT, LA_CUSTOM);
    }

    soa(st, ISD_STRICT_FSQRT,       MVT_v2f64, LA_LEGAL);
    soa(st, ISD_STRICT_FADD,        MVT_v2f64, LA_LEGAL);
    soa(st, ISD_STRICT_FSUB,        MVT_v2f64, LA_LEGAL);
    soa(st, ISD_STRICT_FMUL,        MVT_v2f64, LA_LEGAL);
    soa(st, ISD_STRICT_FDIV,        MVT_v2f64, LA_LEGAL);
  }

  if (!st_useSoftFloat(st) && st_hasGFNI(st)) {
    soa(st, ISD_BITREVERSE, MVT_i8, LA_CUSTOM);
    soa(st, ISD_BITREVERSE, MVT_i16, LA_CUSTOM);
    soa(st, ISD_BITREVERSE, MVT_i32, LA_CUSTOM);
    soa(st, ISD_BITREVERSE, MVT_i64, LA_CUSTOM);

    for VT: u32.[MVT_v16i8, MVT_v8i16, MVT_v4i32, MVT_v2i64]  {
      soa(st, ISD_BITREVERSE, VT, LA_CUSTOM);
    }

    soa(st, ISD_CTLZ, MVT_v16i8, LA_CUSTOM);
    soa(st, ISD_CTTZ, MVT_v16i8, LA_CUSTOM);
  }

  if (!st_useSoftFloat(st) && st_hasSSSE3(st)) {
    soa(st, ISD_ABS,                MVT_v16i8, LA_LEGAL);
    soa(st, ISD_ABS,                MVT_v8i16, LA_LEGAL);
    soa(st, ISD_ABS,                MVT_v4i32, LA_LEGAL);

    for VT: u32.[MVT_v16i8, MVT_v8i16, MVT_v4i32, MVT_v2i64]  {
      soa(st, ISD_BITREVERSE,       VT, LA_CUSTOM);
      soa(st, ISD_CTLZ,             VT, LA_CUSTOM);
    }
    soa(st, ISD_BITREVERSE,        MVT_i128, LA_CUSTOM);

    
    soa(st, ISD_ADD,                MVT_i16, LA_CUSTOM);
    soa(st, ISD_ADD,                MVT_i32, LA_CUSTOM);
    soa(st, ISD_SUB,                MVT_i16, LA_CUSTOM);
    soa(st, ISD_SUB,                MVT_i32, LA_CUSTOM);
  }

  if (!st_useSoftFloat(st) && st_hasSSE41(st)) {
    for RoundedTy: u32.[MVT_f32, MVT_f64, MVT_v4f32, MVT_v2f64]  {
      soa(st, ISD_FFLOOR,            RoundedTy,  LA_LEGAL);
      soa(st, ISD_STRICT_FFLOOR,     RoundedTy,  LA_LEGAL);
      soa(st, ISD_FCEIL,             RoundedTy,  LA_LEGAL);
      soa(st, ISD_STRICT_FCEIL,      RoundedTy,  LA_LEGAL);
      soa(st, ISD_FTRUNC,            RoundedTy,  LA_LEGAL);
      soa(st, ISD_STRICT_FTRUNC,     RoundedTy,  LA_LEGAL);
      soa(st, ISD_FRINT,             RoundedTy,  LA_LEGAL);
      soa(st, ISD_STRICT_FRINT,      RoundedTy,  LA_LEGAL);
      soa(st, ISD_FNEARBYINT,        RoundedTy,  LA_LEGAL);
      soa(st, ISD_STRICT_FNEARBYINT, RoundedTy,  LA_LEGAL);
      soa(st, ISD_FROUNDEVEN,        RoundedTy,  LA_LEGAL);
      soa(st, ISD_STRICT_FROUNDEVEN, RoundedTy,  LA_LEGAL);

      soa(st, ISD_FROUND,            RoundedTy,  LA_CUSTOM);
    }

    soa(st, ISD_SMAX,               MVT_v16i8, LA_LEGAL);
    soa(st, ISD_SMAX,               MVT_v4i32, LA_LEGAL);
    soa(st, ISD_UMAX,               MVT_v8i16, LA_LEGAL);
    soa(st, ISD_UMAX,               MVT_v4i32, LA_LEGAL);
    soa(st, ISD_SMIN,               MVT_v16i8, LA_LEGAL);
    soa(st, ISD_SMIN,               MVT_v4i32, LA_LEGAL);
    soa(st, ISD_UMIN,               MVT_v8i16, LA_LEGAL);
    soa(st, ISD_UMIN,               MVT_v4i32, LA_LEGAL);

    soa(st, ISD_UADDSAT,            MVT_v4i32, LA_CUSTOM);
    soa(st, ISD_SADDSAT,            MVT_v2i64, LA_CUSTOM);
    soa(st, ISD_SSUBSAT,            MVT_v2i64, LA_CUSTOM);

    
    soa(st, ISD_MUL,                MVT_v4i32, LA_LEGAL);
    soa(st, ISD_SMULO,              MVT_v2i32, LA_CUSTOM);

    
    
    soa(st, ISD_VSELECT,            MVT_v16i8, LA_LEGAL);

    
    
    for VT: u32.[ MVT_v8i16, MVT_v4i32, MVT_v2i64 ]  {
      soa(st, ISD_SIGN_EXTEND_VECTOR_INREG, VT, LA_LEGAL);
      soa(st, ISD_ZERO_EXTEND_VECTOR_INREG, VT, LA_LEGAL);
    }

    
    for LoadExtOp: u32.[ ISD_SEXTLOAD, ISD_ZEXTLOAD ]  {
      slea(st, LoadExtOp, MVT_v8i16, MVT_v8i8,  LA_LEGAL);
      slea(st, LoadExtOp, MVT_v4i32, MVT_v4i8,  LA_LEGAL);
      slea(st, LoadExtOp, MVT_v2i64, MVT_v2i8,  LA_LEGAL);
      slea(st, LoadExtOp, MVT_v4i32, MVT_v4i16, LA_LEGAL);
      slea(st, LoadExtOp, MVT_v2i64, MVT_v2i16, LA_LEGAL);
      slea(st, LoadExtOp, MVT_v2i64, MVT_v2i32, LA_LEGAL);
    }

    if (st_is64Bit(st) && !st_hasAVX512(st)) {
      
      
      soa(st, ISD_UINT_TO_FP,        MVT_v4i64, LA_CUSTOM);
      soa(st, ISD_STRICT_UINT_TO_FP, MVT_v4i64, LA_CUSTOM);
      
      
      soa(st, ISD_SINT_TO_FP,        MVT_v4i64, LA_CUSTOM);
      soa(st, ISD_STRICT_SINT_TO_FP, MVT_v4i64, LA_CUSTOM);
    }
  }

  if (!st_useSoftFloat(st) && st_hasSSE42(st)) {
    soa(st, ISD_UADDSAT,            MVT_v2i64, LA_CUSTOM);
  }

  if (!st_useSoftFloat(st) && st_hasXOP(st)) {
    for VT: u32.[ MVT_v16i8, MVT_v8i16,  MVT_v4i32, MVT_v2i64,
                    MVT_v32i8, MVT_v16i16, MVT_v8i32, MVT_v4i64 ]  {
      soa(st, ISD_ROTL, VT, ifx (mvt_bits(VT) == 128) then LA_LEGAL else LA_CUSTOM);
      soa(st, ISD_ROTR, VT, LA_CUSTOM);
    }

    
    for VT: u32.[ MVT_i8, MVT_i16, MVT_i32, MVT_i64 ] 
      soa(st, ISD_BITREVERSE, VT, LA_CUSTOM);
  }

  if (!st_useSoftFloat(st) && st_hasAVX(st)) {
    HasInt256 := st_hasInt256(st);

    add_reg_class(st, MVT_v32i8);
    add_reg_class(st, MVT_v16i16);
    add_reg_class(st, MVT_v16f16);
    add_reg_class(st, MVT_v8i32);
    add_reg_class(st, MVT_v8f32);
    add_reg_class(st, MVT_v4i64);
    add_reg_class(st, MVT_v4f64);

    for VT: u32.[ MVT_v8f32, MVT_v4f64 ]  {
      soa(st, ISD_FFLOOR,            VT, LA_LEGAL);
      soa(st, ISD_STRICT_FFLOOR,     VT, LA_LEGAL);
      soa(st, ISD_FCEIL,             VT, LA_LEGAL);
      soa(st, ISD_STRICT_FCEIL,      VT, LA_LEGAL);
      soa(st, ISD_FTRUNC,            VT, LA_LEGAL);
      soa(st, ISD_STRICT_FTRUNC,     VT, LA_LEGAL);
      soa(st, ISD_FRINT,             VT, LA_LEGAL);
      soa(st, ISD_STRICT_FRINT,      VT, LA_LEGAL);
      soa(st, ISD_FNEARBYINT,        VT, LA_LEGAL);
      soa(st, ISD_STRICT_FNEARBYINT, VT, LA_LEGAL);
      soa(st, ISD_FROUNDEVEN,        VT, LA_LEGAL);
      soa(st, ISD_STRICT_FROUNDEVEN, VT, LA_LEGAL);

      soa(st, ISD_FROUND,            VT, LA_CUSTOM);

      soa(st, ISD_FNEG,              VT, LA_CUSTOM);
      soa(st, ISD_FABS,              VT, LA_CUSTOM);
      soa(st, ISD_FCOPYSIGN,         VT, LA_CUSTOM);
      soa(st, ISD_FCANONICALIZE,     VT, LA_EXPAND);
      set_fp_min_max_action(st, VT);
    }

    soa(st, ISD_LRINT, MVT_v8f32, LA_CUSTOM);
    soa(st, ISD_LRINT, MVT_v4f64, LA_CUSTOM);

    soa(st, ISD_AND, MVT_i256, LA_CUSTOM);
    soa(st, ISD_OR, MVT_i256, LA_CUSTOM);
    soa(st, ISD_XOR, MVT_i256, LA_CUSTOM);
    soa(st, ISD_SELECT, MVT_i256, LA_CUSTOM);
    soa(st, ISD_BITREVERSE, MVT_i256, LA_CUSTOM);

    
    
    sopt(st, ISD_FP_TO_SINT,        MVT_v8i16, MVT_v8i32);
    sopt(st, ISD_FP_TO_UINT,        MVT_v8i16, MVT_v8i32);
    sopt(st, ISD_STRICT_FP_TO_SINT, MVT_v8i16, MVT_v8i32);
    sopt(st, ISD_STRICT_FP_TO_UINT, MVT_v8i16, MVT_v8i32);
    soa(st, ISD_FP_TO_SINT,                MVT_v8i32, LA_CUSTOM);
    soa(st, ISD_FP_TO_UINT,                MVT_v8i32, LA_CUSTOM);
    soa(st, ISD_STRICT_FP_TO_SINT,         MVT_v8i32, LA_CUSTOM);

    soa(st, ISD_SINT_TO_FP,         MVT_v8i32, LA_CUSTOM);
    soa(st, ISD_STRICT_SINT_TO_FP,  MVT_v8i32, LA_CUSTOM);
    soa(st, ISD_FP_EXTEND,          MVT_v8f32, LA_EXPAND);
    soa(st, ISD_FP_ROUND,           MVT_v8f16, LA_EXPAND);
    soa(st, ISD_FP_EXTEND,          MVT_v4f64, LA_CUSTOM);
    soa(st, ISD_STRICT_FP_EXTEND,   MVT_v4f64, LA_CUSTOM);

    soa(st, ISD_STRICT_FP_ROUND,    MVT_v4f32, LA_LEGAL);
    soa(st, ISD_STRICT_FADD,        MVT_v8f32, LA_LEGAL);
    soa(st, ISD_STRICT_FADD,        MVT_v4f64, LA_LEGAL);
    soa(st, ISD_STRICT_FSUB,        MVT_v8f32, LA_LEGAL);
    soa(st, ISD_STRICT_FSUB,        MVT_v4f64, LA_LEGAL);
    soa(st, ISD_STRICT_FMUL,        MVT_v8f32, LA_LEGAL);
    soa(st, ISD_STRICT_FMUL,        MVT_v4f64, LA_LEGAL);
    soa(st, ISD_STRICT_FDIV,        MVT_v8f32, LA_LEGAL);
    soa(st, ISD_STRICT_FDIV,        MVT_v4f64, LA_LEGAL);
    soa(st, ISD_STRICT_FSQRT,       MVT_v8f32, LA_LEGAL);
    soa(st, ISD_STRICT_FSQRT,       MVT_v4f64, LA_LEGAL);

    if (!st_hasAVX512(st))
      soa(st, ISD_BITCAST, MVT_v32i1, LA_CUSTOM);

    
    
    for VT: u32.[ MVT_v32i8, MVT_v16i16, MVT_v8i32, MVT_v4i64 ]  {
      soa(st, ISD_SRL,             VT, LA_CUSTOM);
      soa(st, ISD_SHL,             VT, LA_CUSTOM);
      soa(st, ISD_SRA,             VT, LA_CUSTOM);
      soa(st, ISD_ABDS,            VT, LA_CUSTOM);
      soa(st, ISD_ABDU,            VT, LA_CUSTOM);
      soa(st, ISD_VECREDUCE_AND,   VT, LA_CUSTOM);
      soa(st, ISD_VECREDUCE_OR,    VT, LA_CUSTOM);
      soa(st, ISD_VECREDUCE_XOR,   VT, LA_CUSTOM);
      soa(st, ISD_VECREDUCE_MUL,   VT, LA_CUSTOM);
      soa(st, ISD_VECREDUCE_SMAX,  VT, LA_CUSTOM);
      soa(st, ISD_VECREDUCE_SMIN,  VT, LA_CUSTOM);
      soa(st, ISD_VECREDUCE_UMAX,  VT, LA_CUSTOM);
      soa(st, ISD_VECREDUCE_UMIN,  VT, LA_CUSTOM);
      if (VT == MVT_v4i64) continue;
      soa(st, ISD_ROTL,            VT, LA_CUSTOM);
      soa(st, ISD_ROTR,            VT, LA_CUSTOM);
      soa(st, ISD_FSHL,            VT, LA_CUSTOM);
      soa(st, ISD_FSHR,            VT, LA_CUSTOM);
    }

    
    soa(st, ISD_SIGN_EXTEND,       MVT_v8i64,  LA_CUSTOM);
    soa(st, ISD_SIGN_EXTEND,       MVT_v16i32, LA_CUSTOM);
    soa(st, ISD_ZERO_EXTEND,       MVT_v8i64,  LA_CUSTOM);
    soa(st, ISD_ZERO_EXTEND,       MVT_v16i32, LA_CUSTOM);

    soa(st, ISD_SELECT,            MVT_v4f64, LA_CUSTOM);
    soa(st, ISD_SELECT,            MVT_v4i64, LA_CUSTOM);
    soa(st, ISD_SELECT,            MVT_v8i32, LA_CUSTOM);
    soa(st, ISD_SELECT,            MVT_v16i16, LA_CUSTOM);
    soa(st, ISD_SELECT,            MVT_v16f16, LA_CUSTOM);
    soa(st, ISD_SELECT,            MVT_v32i8, LA_CUSTOM);
    soa(st, ISD_SELECT,            MVT_v8f32, LA_CUSTOM);

    for VT: u32.[ MVT_v16i16, MVT_v8i32, MVT_v4i64 ]  {
      soa(st, ISD_SIGN_EXTEND,     VT, LA_CUSTOM);
      soa(st, ISD_ZERO_EXTEND,     VT, LA_CUSTOM);
      soa(st, ISD_ANY_EXTEND,      VT, LA_CUSTOM);
    }

    soa(st, ISD_TRUNCATE,          MVT_v32i8, LA_CUSTOM);
    soa(st, ISD_TRUNCATE,          MVT_v32i16, LA_CUSTOM);
    soa(st, ISD_TRUNCATE,          MVT_v32i32, LA_CUSTOM);
    soa(st, ISD_TRUNCATE,          MVT_v32i64, LA_CUSTOM);

    for VT: u32.[ MVT_v32i8, MVT_v16i16, MVT_v8i32, MVT_v4i64 ]  {
      soa(st, ISD_SETCC,           VT, LA_CUSTOM);
      soa(st, ISD_CTPOP,           VT, LA_CUSTOM);
      soa(st, ISD_CTLZ,            VT, LA_CUSTOM);
      soa(st, ISD_BITREVERSE,      VT, LA_CUSTOM);

      
      
      scca(st, ISD_SETLT, VT, LA_CUSTOM);
      scca(st, ISD_SETLE, VT, LA_CUSTOM);
    }

    soa(st, ISD_SETCC,          MVT_v4f64, LA_CUSTOM);
    soa(st, ISD_SETCC,          MVT_v8f32, LA_CUSTOM);
    soa(st, ISD_STRICT_FSETCC,  MVT_v4f64, LA_CUSTOM);
    soa(st, ISD_STRICT_FSETCC,  MVT_v8f32, LA_CUSTOM);
    soa(st, ISD_STRICT_FSETCCS, MVT_v4f64, LA_CUSTOM);
    soa(st, ISD_STRICT_FSETCCS, MVT_v8f32, LA_CUSTOM);

    if (st_hasAnyFMA(st)) {
      for VT: u32.[ MVT_f32, MVT_f64, MVT_v4f32, MVT_v8f32,
                       MVT_v2f64, MVT_v4f64 ]  {
        soa(st, ISD_FMA, VT, LA_LEGAL);
        soa(st, ISD_STRICT_FMA, VT, LA_LEGAL);
      }
    }

    for VT: u32.[ MVT_v32i8, MVT_v16i16, MVT_v8i32, MVT_v4i64 ]  {
      soa(st, ISD_ADD, VT, ifx HasInt256 then LA_LEGAL else LA_CUSTOM);
      soa(st, ISD_SUB, VT, ifx HasInt256 then LA_LEGAL else LA_CUSTOM);
    }

    soa(st, ISD_MUL,       MVT_v4i64,  LA_CUSTOM);
    soa(st, ISD_MUL,       MVT_v8i32, ifx HasInt256 then LA_LEGAL else LA_CUSTOM);
    soa(st, ISD_MUL,       MVT_v16i16, ifx HasInt256 then LA_LEGAL else LA_CUSTOM);
    soa(st, ISD_MUL,       MVT_v32i8,  LA_CUSTOM);

    soa(st, ISD_MULHU,     MVT_v8i32,  LA_CUSTOM);
    soa(st, ISD_MULHS,     MVT_v8i32,  LA_CUSTOM);
    soa(st, ISD_MULHU,     MVT_v16i16, ifx HasInt256 then LA_LEGAL else LA_CUSTOM);
    soa(st, ISD_MULHS,     MVT_v16i16, ifx HasInt256 then LA_LEGAL else LA_CUSTOM);
    soa(st, ISD_MULHU,     MVT_v32i8,  LA_CUSTOM);
    soa(st, ISD_MULHS,     MVT_v32i8,  LA_CUSTOM);
    soa(st, ISD_AVGCEILU,  MVT_v16i16, ifx HasInt256 then LA_LEGAL else LA_CUSTOM);
    soa(st, ISD_AVGCEILU,  MVT_v32i8, ifx HasInt256 then LA_LEGAL else LA_CUSTOM);

    soa(st, ISD_SMULO,     MVT_v32i8, LA_CUSTOM);
    soa(st, ISD_UMULO,     MVT_v32i8, LA_CUSTOM);

    soa(st, ISD_ABS,       MVT_v4i64,  LA_CUSTOM);
    soa(st, ISD_SMAX,      MVT_v4i64,  LA_CUSTOM);
    soa(st, ISD_UMAX,      MVT_v4i64,  LA_CUSTOM);
    soa(st, ISD_SMIN,      MVT_v4i64,  LA_CUSTOM);
    soa(st, ISD_UMIN,      MVT_v4i64,  LA_CUSTOM);

    soa(st, ISD_UADDSAT,   MVT_v32i8, ifx HasInt256 then LA_LEGAL else LA_CUSTOM);
    soa(st, ISD_SADDSAT,   MVT_v32i8, ifx HasInt256 then LA_LEGAL else LA_CUSTOM);
    soa(st, ISD_USUBSAT,   MVT_v32i8, ifx HasInt256 then LA_LEGAL else LA_CUSTOM);
    soa(st, ISD_SSUBSAT,   MVT_v32i8, ifx HasInt256 then LA_LEGAL else LA_CUSTOM);
    soa(st, ISD_UADDSAT,   MVT_v16i16, ifx HasInt256 then LA_LEGAL else LA_CUSTOM);
    soa(st, ISD_SADDSAT,   MVT_v16i16, ifx HasInt256 then LA_LEGAL else LA_CUSTOM);
    soa(st, ISD_USUBSAT,   MVT_v16i16, ifx HasInt256 then LA_LEGAL else LA_CUSTOM);
    soa(st, ISD_SSUBSAT,   MVT_v16i16, ifx HasInt256 then LA_LEGAL else LA_CUSTOM);
    soa(st, ISD_UADDSAT,   MVT_v8i32, LA_CUSTOM);
    soa(st, ISD_USUBSAT,   MVT_v8i32, LA_CUSTOM);
    soa(st, ISD_UADDSAT,   MVT_v4i64, LA_CUSTOM);
    soa(st, ISD_USUBSAT,   MVT_v4i64, LA_CUSTOM);

    for VT: u32.[ MVT_v32i8, MVT_v16i16, MVT_v8i32 ]  {
      soa(st, ISD_ABS,  VT, ifx HasInt256 then LA_LEGAL else LA_CUSTOM);
      soa(st, ISD_SMAX, VT, ifx HasInt256 then LA_LEGAL else LA_CUSTOM);
      soa(st, ISD_UMAX, VT, ifx HasInt256 then LA_LEGAL else LA_CUSTOM);
      soa(st, ISD_SMIN, VT, ifx HasInt256 then LA_LEGAL else LA_CUSTOM);
      soa(st, ISD_UMIN, VT, ifx HasInt256 then LA_LEGAL else LA_CUSTOM);
    }

    for VT: u32.[MVT_v16i16, MVT_v8i32, MVT_v4i64]  {
      soa(st, ISD_SIGN_EXTEND_VECTOR_INREG, VT, LA_CUSTOM);
      soa(st, ISD_ZERO_EXTEND_VECTOR_INREG, VT, LA_CUSTOM);
    }

    if (HasInt256) {
      
      
      soa(st, ISD_UINT_TO_FP, MVT_v8i32, LA_CUSTOM);
      soa(st, ISD_STRICT_UINT_TO_FP, MVT_v8i32, LA_CUSTOM);

      
      for LoadExtOp: u32.[ ISD_SEXTLOAD, ISD_ZEXTLOAD ]  {
        slea(st, LoadExtOp, MVT_v16i16, MVT_v16i8, LA_LEGAL);
        slea(st, LoadExtOp, MVT_v8i32,  MVT_v8i8,  LA_LEGAL);
        slea(st, LoadExtOp, MVT_v4i64,  MVT_v4i8,  LA_LEGAL);
        slea(st, LoadExtOp, MVT_v8i32,  MVT_v8i16, LA_LEGAL);
        slea(st, LoadExtOp, MVT_v4i64,  MVT_v4i16, LA_LEGAL);
        slea(st, LoadExtOp, MVT_v4i64,  MVT_v4i32, LA_LEGAL);
      }
    }

    for VT: u32.[ MVT_v4i32, MVT_v8i32, MVT_v2i64, MVT_v4i64,
                     MVT_v4f32, MVT_v8f32, MVT_v2f64, MVT_v4f64 ]  {
      soa(st, ISD_MLOAD,  VT, ifx st_hasVLX(st) then LA_LEGAL else LA_CUSTOM);
      soa(st, ISD_MSTORE, VT, LA_LEGAL);
    }

    
    
    for VT: u32.[ MVT_v16i8, MVT_v8i16, MVT_v4i32, MVT_v2i64,
                     MVT_v8f16, MVT_v4f32, MVT_v2f64 ]  {
      soa(st, ISD_EXTRACT_SUBVECTOR, VT, LA_LEGAL);
    }

    
    for VT: u32.[ MVT_v32i8, MVT_v16i16, MVT_v8i32, MVT_v4i64,
                    MVT_v16f16, MVT_v8f32, MVT_v4f64 ]  {
      soa(st, ISD_BUILD_VECTOR,       VT, LA_CUSTOM);
      soa(st, ISD_VECTOR_SHUFFLE,     VT, LA_CUSTOM);
      soa(st, ISD_VSELECT,            VT, LA_CUSTOM);
      soa(st, ISD_INSERT_VECTOR_ELT,  VT, LA_CUSTOM);
      soa(st, ISD_EXTRACT_VECTOR_ELT, VT, LA_CUSTOM);
      soa(st, ISD_SCALAR_TO_VECTOR,   VT, LA_CUSTOM);
      soa(st, ISD_INSERT_SUBVECTOR,   VT, LA_LEGAL);
      soa(st, ISD_CONCAT_VECTORS,     VT, LA_CUSTOM);
      soa(st, ISD_STORE,              VT, LA_CUSTOM);
    }
    set_f16_action(st, MVT_v16f16, LA_EXPAND);
    soa(st, ISD_FNEG, MVT_v16f16, LA_CUSTOM);
    soa(st, ISD_FABS, MVT_v16f16, LA_CUSTOM);
    soa(st, ISD_FCOPYSIGN, MVT_v16f16, LA_CUSTOM);
    soa(st, ISD_FADD, MVT_v16f16, LA_EXPAND);
    soa(st, ISD_FSUB, MVT_v16f16, LA_EXPAND);
    soa(st, ISD_FMUL, MVT_v16f16, LA_EXPAND);
    soa(st, ISD_FDIV, MVT_v16f16, LA_EXPAND);

    
    if (st_hasPCLMUL(st)) {
      for VT: u32.[MVT_v8i32, MVT_v4i64]  {
        soa(st, ISD_CLMUL, VT, LA_CUSTOM);
        soa(st, ISD_CLMULH, VT, LA_CUSTOM);
      }
    }

    if (HasInt256) {
      soa(st, ISD_MULHU, MVT_v4i64, LA_CUSTOM);
      
      
      
      if (st_is64Bit(st)) {
        soa(st, ISD_UMUL_LOHI, MVT_v4i64, LA_CUSTOM);
        soa(st, ISD_SMUL_LOHI, MVT_v4i64, LA_CUSTOM);
      }
      soa(st, ISD_VSELECT, MVT_v32i8, LA_LEGAL);

      
      soa(st, ISD_MGATHER, MVT_v2f32, LA_CUSTOM);
      soa(st, ISD_MGATHER, MVT_v2i32, LA_CUSTOM);

      for VT: u32.[ MVT_v4i32, MVT_v8i32, MVT_v2i64, MVT_v4i64,
                       MVT_v4f32, MVT_v8f32, MVT_v2f64, MVT_v4f64 ] 
        soa(st, ISD_MGATHER,  VT, LA_CUSTOM);
    }

    if (st_hasGFNI(st)) {
      soa(st, ISD_CTLZ, MVT_v32i8, LA_CUSTOM);
      soa(st, ISD_CTTZ, MVT_v32i8, LA_CUSTOM);
    }
  }

  if (!st_useSoftFloat(st) && !st_hasFP16(st) &&
      st_hasF16C(st)) {
    for VT: u32.[ MVT_f16, MVT_v2f16, MVT_v4f16, MVT_v8f16 ]  {
      soa(st, ISD_FP_ROUND,           VT, LA_CUSTOM);
      soa(st, ISD_STRICT_FP_ROUND,    VT, LA_CUSTOM);
    }
    for VT: u32.[ MVT_f32, MVT_v2f32, MVT_v4f32, MVT_v8f32 ]  {
      soa(st, ISD_FP_EXTEND,          VT, LA_CUSTOM);
      soa(st, ISD_STRICT_FP_EXTEND,   VT, LA_CUSTOM);
    }
    for Opc: u32.[ISD_FADD, ISD_FSUB, ISD_FMUL, ISD_FDIV]  {
      sopt(st, Opc, MVT_v8f16, MVT_v8f32);
      sopt(st, Opc, MVT_v16f16, MVT_v16f32);
    }
    soa(st, ISD_SETCC, MVT_v8f16, LA_CUSTOM);
    soa(st, ISD_SETCC, MVT_v16f16, LA_CUSTOM);
  }

  
  
  
  if (!st_useSoftFloat(st) && st_hasAVX512(st)) {
    add_reg_class(st, MVT_v1i1);
    add_reg_class(st, MVT_v2i1);
    add_reg_class(st, MVT_v4i1);
    add_reg_class(st, MVT_v8i1);
    add_reg_class(st, MVT_v16i1);

    soa(st, ISD_SELECT,             MVT_v1i1, LA_CUSTOM);
    soa(st, ISD_EXTRACT_VECTOR_ELT, MVT_v1i1, LA_CUSTOM);
    soa(st, ISD_BUILD_VECTOR,       MVT_v1i1, LA_CUSTOM);

    sopt(st, ISD_FP_TO_SINT,        MVT_v8i1,  MVT_v8i32);
    sopt(st, ISD_FP_TO_UINT,        MVT_v8i1,  MVT_v8i32);
    sopt(st, ISD_FP_TO_SINT,        MVT_v4i1,  MVT_v4i32);
    sopt(st, ISD_FP_TO_UINT,        MVT_v4i1,  MVT_v4i32);
    sopt(st, ISD_STRICT_FP_TO_SINT, MVT_v8i1,  MVT_v8i32);
    sopt(st, ISD_STRICT_FP_TO_UINT, MVT_v8i1,  MVT_v8i32);
    sopt(st, ISD_STRICT_FP_TO_SINT, MVT_v4i1,  MVT_v4i32);
    sopt(st, ISD_STRICT_FP_TO_UINT, MVT_v4i1,  MVT_v4i32);
    soa(st, ISD_FP_TO_SINT,                MVT_v2i1,  LA_CUSTOM);
    soa(st, ISD_FP_TO_UINT,                MVT_v2i1,  LA_CUSTOM);
    soa(st, ISD_STRICT_FP_TO_SINT,         MVT_v2i1,  LA_CUSTOM);
    soa(st, ISD_STRICT_FP_TO_UINT,         MVT_v2i1,  LA_CUSTOM);
    soa(st, ISD_FCANONICALIZE, MVT_v8f16, LA_EXPAND);
    soa(st, ISD_FCANONICALIZE, MVT_v16f16, LA_EXPAND);
    soa(st, ISD_FCANONICALIZE, MVT_v32f16, LA_EXPAND);

    
    if (!st_hasDQI(st)) {
      soa(st, ISD_LOAD, MVT_v1i1, LA_CUSTOM);
      soa(st, ISD_LOAD, MVT_v2i1, LA_CUSTOM);
      soa(st, ISD_LOAD, MVT_v4i1, LA_CUSTOM);
      soa(st, ISD_LOAD, MVT_v8i1, LA_CUSTOM);

      soa(st, ISD_STORE, MVT_v1i1, LA_CUSTOM);
      soa(st, ISD_STORE, MVT_v2i1, LA_CUSTOM);
      soa(st, ISD_STORE, MVT_v4i1, LA_CUSTOM);
      soa(st, ISD_STORE, MVT_v8i1, LA_CUSTOM);
    }

    
    for VT: u32.[ MVT_v16i8, MVT_v8i16, MVT_v4i32, MVT_v2i64 ]  {
      soa(st, ISD_SIGN_EXTEND, VT, LA_CUSTOM);
      soa(st, ISD_ZERO_EXTEND, VT, LA_CUSTOM);
      soa(st, ISD_ANY_EXTEND,  VT, LA_CUSTOM);
    }

    for VT: u32.[ MVT_v1i1, MVT_v2i1, MVT_v4i1, MVT_v8i1, MVT_v16i1 ] 
      soa(st, ISD_VSELECT,          VT, LA_EXPAND);

    for VT: u32.[ MVT_v2i1, MVT_v4i1, MVT_v8i1, MVT_v16i1 ]  {
      soa(st, ISD_SETCC,            VT, LA_CUSTOM);
      soa(st, ISD_SELECT,           VT, LA_CUSTOM);
      soa(st, ISD_TRUNCATE,         VT, LA_CUSTOM);

      soa(st, ISD_BUILD_VECTOR,     VT, LA_CUSTOM);
      soa(st, ISD_CONCAT_VECTORS,   VT, LA_CUSTOM);
      soa(st, ISD_EXTRACT_VECTOR_ELT, VT, LA_CUSTOM);
      soa(st, ISD_INSERT_SUBVECTOR, VT, LA_CUSTOM);
      soa(st, ISD_INSERT_VECTOR_ELT, VT, LA_CUSTOM);
      soa(st, ISD_VECTOR_SHUFFLE,   VT,  LA_CUSTOM);
    }

    for VT: u32.[ MVT_v1i1, MVT_v2i1, MVT_v4i1, MVT_v8i1 ] 
      soa(st, ISD_EXTRACT_SUBVECTOR, VT, LA_CUSTOM);
  }
  if (st_hasDQI(st) && st_hasVLX(st)) {
    for VT: u32.[MVT_v4f32, MVT_v8f32, MVT_v2f64, MVT_v4f64]  {
      soa(st, ISD_LRINT, VT, LA_LEGAL);
      soa(st, ISD_LLRINT, VT, LA_LEGAL);
    }
  }

  
  
  
  if (!st_useSoftFloat(st) && st_useAVX512Regs(st)) {
    HasBWI := st_hasBWI(st);

    add_reg_class(st, MVT_v16i32);
    add_reg_class(st, MVT_v16f32);
    add_reg_class(st, MVT_v8i64);
    add_reg_class(st, MVT_v8f64);
    add_reg_class(st, MVT_v32i16);
    add_reg_class(st, MVT_v32f16);
    add_reg_class(st, MVT_v64i8);

    for ExtType: u32.[ISD_ZEXTLOAD, ISD_SEXTLOAD]  {
      slea(st, ExtType, MVT_v16i32, MVT_v16i8,  LA_LEGAL);
      slea(st, ExtType, MVT_v16i32, MVT_v16i16, LA_LEGAL);
      slea(st, ExtType, MVT_v8i64,  MVT_v8i8,   LA_LEGAL);
      slea(st, ExtType, MVT_v8i64,  MVT_v8i16,  LA_LEGAL);
      slea(st, ExtType, MVT_v8i64,  MVT_v8i32,  LA_LEGAL);
      if (HasBWI)
        slea(st, ExtType, MVT_v32i16, MVT_v32i8, LA_LEGAL);
    }

    for VT: u32.[ MVT_v16f32, MVT_v8f64 ]  {
      set_fp_min_max_action(st, VT);
      soa(st, ISD_FNEG,  VT, LA_CUSTOM);
      soa(st, ISD_FABS,  VT, LA_CUSTOM);
      soa(st, ISD_FMA,   VT, LA_LEGAL);
      soa(st, ISD_STRICT_FMA, VT, LA_LEGAL);
      soa(st, ISD_FCOPYSIGN, VT, LA_CUSTOM);
      soa(st, ISD_FCANONICALIZE, VT, LA_EXPAND);
      soa(st, ISD_FLDEXP, VT, LA_CUSTOM);
    }
    soa(st, ISD_LRINT, MVT_v16f32, ifx st_hasDQI(st) then LA_LEGAL else LA_CUSTOM);
    soa(st, ISD_LRINT, MVT_v8f64, ifx st_hasDQI(st) then LA_LEGAL else LA_CUSTOM);
    if (st_hasDQI(st))
      soa(st, ISD_LLRINT, MVT_v8f64, LA_LEGAL);

    soa(st, ISD_AND, MVT_i512, LA_CUSTOM);
    soa(st, ISD_OR, MVT_i512, LA_CUSTOM);
    soa(st, ISD_XOR, MVT_i512, LA_CUSTOM);
    soa(st, ISD_ADD, MVT_i512, LA_CUSTOM);
    soa(st, ISD_SUB, MVT_i512, LA_CUSTOM);
    soa(st, ISD_SRL, MVT_i512, LA_CUSTOM);
    soa(st, ISD_SHL, MVT_i512, LA_CUSTOM);
    soa(st, ISD_SRA, MVT_i512, LA_CUSTOM);
    soa(st, ISD_FSHR, MVT_i512, LA_CUSTOM);
    soa(st, ISD_FSHL, MVT_i512, LA_CUSTOM);
    soa(st, ISD_FSHR, MVT_i256, LA_CUSTOM);
    soa(st, ISD_FSHL, MVT_i256, LA_CUSTOM);
    soa(st, ISD_SELECT, MVT_i512, LA_CUSTOM);
    soa(st, ISD_BITREVERSE, MVT_i512, LA_CUSTOM);

    for VT: u32.[ MVT_v16i1, MVT_v16i8 ]  {
      sopt(st, ISD_FP_TO_SINT       , VT, MVT_v16i32);
      sopt(st, ISD_FP_TO_UINT       , VT, MVT_v16i32);
      sopt(st, ISD_STRICT_FP_TO_SINT, VT, MVT_v16i32);
      sopt(st, ISD_STRICT_FP_TO_UINT, VT, MVT_v16i32);
    }

    for VT: u32.[ MVT_v16i16, MVT_v16i32 ]  {
      soa(st, ISD_FP_TO_SINT,        VT, LA_CUSTOM);
      soa(st, ISD_FP_TO_UINT,        VT, LA_CUSTOM);
      soa(st, ISD_STRICT_FP_TO_SINT, VT, LA_CUSTOM);
      soa(st, ISD_STRICT_FP_TO_UINT, VT, LA_CUSTOM);
    }

    soa(st, ISD_SINT_TO_FP,        MVT_v16i32, LA_CUSTOM);
    soa(st, ISD_UINT_TO_FP,        MVT_v16i32, LA_CUSTOM);
    soa(st, ISD_STRICT_SINT_TO_FP, MVT_v16i32, LA_CUSTOM);
    soa(st, ISD_STRICT_UINT_TO_FP, MVT_v16i32, LA_CUSTOM);
    soa(st, ISD_FP_EXTEND,         MVT_v8f64,  LA_CUSTOM);
    soa(st, ISD_STRICT_FP_EXTEND,  MVT_v8f64,  LA_CUSTOM);

    soa(st, ISD_STRICT_FADD,      MVT_v16f32, LA_LEGAL);
    soa(st, ISD_STRICT_FADD,      MVT_v8f64,  LA_LEGAL);
    soa(st, ISD_STRICT_FSUB,      MVT_v16f32, LA_LEGAL);
    soa(st, ISD_STRICT_FSUB,      MVT_v8f64,  LA_LEGAL);
    soa(st, ISD_STRICT_FMUL,      MVT_v16f32, LA_LEGAL);
    soa(st, ISD_STRICT_FMUL,      MVT_v8f64,  LA_LEGAL);
    soa(st, ISD_STRICT_FDIV,      MVT_v16f32, LA_LEGAL);
    soa(st, ISD_STRICT_FDIV,      MVT_v8f64,  LA_LEGAL);
    soa(st, ISD_STRICT_FSQRT,     MVT_v16f32, LA_LEGAL);
    soa(st, ISD_STRICT_FSQRT,     MVT_v8f64,  LA_LEGAL);
    soa(st, ISD_STRICT_FP_ROUND,  MVT_v8f32,  LA_LEGAL);

    stsa(st, MVT_v8i64,   MVT_v8i8,   LA_LEGAL);
    stsa(st, MVT_v8i64,   MVT_v8i16,  LA_LEGAL);
    stsa(st, MVT_v8i64,   MVT_v8i32,  LA_LEGAL);
    stsa(st, MVT_v16i32,  MVT_v16i8,  LA_LEGAL);
    stsa(st, MVT_v16i32,  MVT_v16i16, LA_LEGAL);
    if (HasBWI)
      stsa(st, MVT_v32i16,  MVT_v32i8, LA_LEGAL);

    
    
    
    if (!st_hasVLX(st)) {
      for VT: u32.[MVT_v4i32, MVT_v8i32, MVT_v2i64, MVT_v4i64,
           MVT_v4f32, MVT_v8f32, MVT_v2f64, MVT_v4f64]  {
        soa(st, ISD_MLOAD,  VT, LA_CUSTOM);
        soa(st, ISD_MSTORE, VT, LA_CUSTOM);
      }
    }

    soa(st, ISD_TRUNCATE,    MVT_v8i32,  LA_LEGAL);
    soa(st, ISD_TRUNCATE,    MVT_v16i16, LA_LEGAL);
    soa(st, ISD_TRUNCATE,    MVT_v32i8, ifx HasBWI then LA_LEGAL else LA_CUSTOM);
    soa(st, ISD_ZERO_EXTEND, MVT_v32i16, LA_CUSTOM);
    soa(st, ISD_ZERO_EXTEND, MVT_v16i32, LA_CUSTOM);
    soa(st, ISD_ZERO_EXTEND, MVT_v8i64,  LA_CUSTOM);
    soa(st, ISD_ANY_EXTEND,  MVT_v32i16, LA_CUSTOM);
    soa(st, ISD_ANY_EXTEND,  MVT_v16i32, LA_CUSTOM);
    soa(st, ISD_ANY_EXTEND,  MVT_v8i64,  LA_CUSTOM);
    soa(st, ISD_SIGN_EXTEND, MVT_v32i16, LA_CUSTOM);
    soa(st, ISD_SIGN_EXTEND, MVT_v16i32, LA_CUSTOM);
    soa(st, ISD_SIGN_EXTEND, MVT_v8i64,  LA_CUSTOM);

    if (HasBWI) {
      
      soa(st, ISD_SIGN_EXTEND,        MVT_v64i8, LA_CUSTOM);
      soa(st, ISD_ZERO_EXTEND,        MVT_v64i8, LA_CUSTOM);
      soa(st, ISD_ANY_EXTEND,         MVT_v64i8, LA_CUSTOM);
    }

    for VT: u32.[ MVT_v16f32, MVT_v8f64 ]  {
      soa(st, ISD_FFLOOR,            VT, LA_LEGAL);
      soa(st, ISD_STRICT_FFLOOR,     VT, LA_LEGAL);
      soa(st, ISD_FCEIL,             VT, LA_LEGAL);
      soa(st, ISD_STRICT_FCEIL,      VT, LA_LEGAL);
      soa(st, ISD_FTRUNC,            VT, LA_LEGAL);
      soa(st, ISD_STRICT_FTRUNC,     VT, LA_LEGAL);
      soa(st, ISD_FRINT,             VT, LA_LEGAL);
      soa(st, ISD_STRICT_FRINT,      VT, LA_LEGAL);
      soa(st, ISD_FNEARBYINT,        VT, LA_LEGAL);
      soa(st, ISD_STRICT_FNEARBYINT, VT, LA_LEGAL);
      soa(st, ISD_FROUNDEVEN,        VT, LA_LEGAL);
      soa(st, ISD_STRICT_FROUNDEVEN, VT, LA_LEGAL);

      soa(st, ISD_FROUND,            VT, LA_CUSTOM);
    }

    for VT: u32.[MVT_v32i16, MVT_v16i32, MVT_v8i64]  {
      soa(st, ISD_SIGN_EXTEND_VECTOR_INREG, VT, LA_CUSTOM);
      soa(st, ISD_ZERO_EXTEND_VECTOR_INREG, VT, LA_CUSTOM);
    }

    soa(st, ISD_ADD, MVT_v32i16, ifx HasBWI then LA_LEGAL else LA_CUSTOM);
    soa(st, ISD_SUB, MVT_v32i16, ifx HasBWI then LA_LEGAL else LA_CUSTOM);
    soa(st, ISD_ADD, MVT_v64i8, ifx HasBWI then LA_LEGAL else LA_CUSTOM);
    soa(st, ISD_SUB, MVT_v64i8, ifx HasBWI then LA_LEGAL else LA_CUSTOM);

    soa(st, ISD_MUL, MVT_v8i64,  LA_CUSTOM);
    soa(st, ISD_MUL, MVT_v16i32, LA_LEGAL);
    soa(st, ISD_MUL, MVT_v32i16, ifx HasBWI then LA_LEGAL else LA_CUSTOM);
    soa(st, ISD_MUL, MVT_v64i8,  LA_CUSTOM);

    soa(st, ISD_MULHU, MVT_v8i64, LA_CUSTOM);
    if (st_is64Bit(st)) {
      soa(st, ISD_UMUL_LOHI, MVT_v8i64, LA_CUSTOM);
      soa(st, ISD_SMUL_LOHI, MVT_v8i64, LA_CUSTOM);
    }
    soa(st, ISD_MULHU, MVT_v16i32, LA_CUSTOM);
    soa(st, ISD_MULHS, MVT_v16i32, LA_CUSTOM);
    soa(st, ISD_MULHS, MVT_v32i16, ifx HasBWI then LA_LEGAL else LA_CUSTOM);
    soa(st, ISD_MULHU, MVT_v32i16, ifx HasBWI then LA_LEGAL else LA_CUSTOM);
    soa(st, ISD_MULHS, MVT_v64i8,  LA_CUSTOM);
    soa(st, ISD_MULHU, MVT_v64i8,  LA_CUSTOM);
    soa(st, ISD_AVGCEILU, MVT_v32i16, ifx HasBWI then LA_LEGAL else LA_CUSTOM);
    soa(st, ISD_AVGCEILU, MVT_v64i8, ifx HasBWI then LA_LEGAL else LA_CUSTOM);

    soa(st, ISD_SMULO, MVT_v64i8, LA_CUSTOM);
    soa(st, ISD_UMULO, MVT_v64i8, LA_CUSTOM);

    for VT: u32.[ MVT_v64i8, MVT_v32i16, MVT_v16i32, MVT_v8i64 ]  {
      soa(st, ISD_SRL,              VT, LA_CUSTOM);
      soa(st, ISD_SHL,              VT, LA_CUSTOM);
      soa(st, ISD_SRA,              VT, LA_CUSTOM);
      soa(st, ISD_ROTL,             VT, LA_CUSTOM);
      soa(st, ISD_ROTR,             VT, LA_CUSTOM);
      soa(st, ISD_SETCC,            VT, LA_CUSTOM);
      soa(st, ISD_ABDS,             VT, LA_CUSTOM);
      soa(st, ISD_ABDU,             VT, LA_CUSTOM);
      soa(st, ISD_BITREVERSE,       VT, LA_CUSTOM);
      soa(st, ISD_VECREDUCE_AND,    VT, LA_CUSTOM);
      soa(st, ISD_VECREDUCE_OR,     VT, LA_CUSTOM);
      soa(st, ISD_VECREDUCE_XOR,    VT, LA_CUSTOM);
      soa(st, ISD_VECREDUCE_MUL,    VT, LA_CUSTOM);
      soa(st, ISD_VECREDUCE_SMAX,   VT, LA_CUSTOM);
      soa(st, ISD_VECREDUCE_SMIN,   VT, LA_CUSTOM);
      soa(st, ISD_VECREDUCE_UMAX,   VT, LA_CUSTOM);
      soa(st, ISD_VECREDUCE_UMIN,   VT, LA_CUSTOM);

      
      
      scca(st, ISD_SETLT, VT, LA_CUSTOM);
      scca(st, ISD_SETLE, VT, LA_CUSTOM);
    }

    soa(st, ISD_SETCC,          MVT_v8f64, LA_CUSTOM);
    soa(st, ISD_SETCC,          MVT_v16f32, LA_CUSTOM);
    soa(st, ISD_STRICT_FSETCC,  MVT_v8f64, LA_CUSTOM);
    soa(st, ISD_STRICT_FSETCC,  MVT_v16f32, LA_CUSTOM);
    soa(st, ISD_STRICT_FSETCCS, MVT_v8f64, LA_CUSTOM);
    soa(st, ISD_STRICT_FSETCCS, MVT_v16f32, LA_CUSTOM);

    for VT: u32.[ MVT_v16i32, MVT_v8i64 ]  {
      soa(st, ISD_SMAX,             VT, LA_LEGAL);
      soa(st, ISD_UMAX,             VT, LA_LEGAL);
      soa(st, ISD_SMIN,             VT, LA_LEGAL);
      soa(st, ISD_UMIN,             VT, LA_LEGAL);
      soa(st, ISD_ROTL,             VT, LA_LEGAL);
      soa(st, ISD_ROTR,             VT, LA_LEGAL);
      soa(st, ISD_ABS,              VT, LA_LEGAL);
      soa(st, ISD_CTPOP,            VT, LA_CUSTOM);
    }

    for VT: u32.[ MVT_v64i8, MVT_v32i16 ]  {
      soa(st, ISD_ABS,     VT, ifx HasBWI then LA_LEGAL else LA_CUSTOM);
      soa(st, ISD_CTPOP,   VT, ifx st_hasBITALG(st) then LA_LEGAL else LA_CUSTOM);
      soa(st, ISD_CTLZ,    VT, LA_CUSTOM);
      soa(st, ISD_SMAX,    VT, ifx HasBWI then LA_LEGAL else LA_CUSTOM);
      soa(st, ISD_UMAX,    VT, ifx HasBWI then LA_LEGAL else LA_CUSTOM);
      soa(st, ISD_SMIN,    VT, ifx HasBWI then LA_LEGAL else LA_CUSTOM);
      soa(st, ISD_UMIN,    VT, ifx HasBWI then LA_LEGAL else LA_CUSTOM);
      soa(st, ISD_UADDSAT, VT, ifx HasBWI then LA_LEGAL else LA_CUSTOM);
      soa(st, ISD_SADDSAT, VT, ifx HasBWI then LA_LEGAL else LA_CUSTOM);
      soa(st, ISD_USUBSAT, VT, ifx HasBWI then LA_LEGAL else LA_CUSTOM);
      soa(st, ISD_SSUBSAT, VT, ifx HasBWI then LA_LEGAL else LA_CUSTOM);
    }

    soa(st, ISD_FSHL,       MVT_v64i8, LA_CUSTOM);
    soa(st, ISD_FSHR,       MVT_v64i8, LA_CUSTOM);
    soa(st, ISD_FSHL,      MVT_v32i16, LA_CUSTOM);
    soa(st, ISD_FSHR,      MVT_v32i16, LA_CUSTOM);
    soa(st, ISD_FSHL,      MVT_v16i32, LA_CUSTOM);
    soa(st, ISD_FSHR,      MVT_v16i32, LA_CUSTOM);

    if (st_hasDQI(st) || st_hasFP16(st))
      for Opc: u32.[ISD_SINT_TO_FP, ISD_UINT_TO_FP, ISD_STRICT_SINT_TO_FP,
                       ISD_STRICT_UINT_TO_FP, ISD_FP_TO_SINT, ISD_FP_TO_UINT,
                       ISD_STRICT_FP_TO_SINT, ISD_STRICT_FP_TO_UINT] 
        soa(st, Opc,           MVT_v8i64, LA_CUSTOM);

    if (st_hasDQI(st)) {
      soa(st, ISD_MUL,        MVT_v8i64, LA_LEGAL);

      
      soa(st, ISD_MULHS, MVT_v8i64, LA_CUSTOM);
    }

    if (st_hasCDI(st)) {
      
      for VT: u32.[ MVT_v16i32, MVT_v8i64]  {
        soa(st, ISD_CTLZ,            VT, LA_LEGAL);
      }
    } 

    if (st_hasVPOPCNTDQ(st)) {
      for VT: u32.[ MVT_v16i32, MVT_v8i64 ] 
        soa(st, ISD_CTPOP, VT, LA_LEGAL);
      soa(st, ISD_CTPOP, MVT_i512, LA_CUSTOM);
    }

    
    
    
    for VT: u32.[ MVT_v32i8, MVT_v16i16, MVT_v8i32, MVT_v4i64,
                     MVT_v16f16, MVT_v8f32, MVT_v4f64 ] 
      soa(st, ISD_EXTRACT_SUBVECTOR, VT, LA_LEGAL);

    for VT: u32.[ MVT_v64i8, MVT_v32i16, MVT_v16i32, MVT_v8i64,
                     MVT_v32f16, MVT_v16f32, MVT_v8f64 ]  {
      soa(st, ISD_CONCAT_VECTORS,     VT, LA_CUSTOM);
      soa(st, ISD_INSERT_SUBVECTOR,   VT, LA_LEGAL);
      soa(st, ISD_SELECT,             VT, LA_CUSTOM);
      soa(st, ISD_VSELECT,            VT, LA_CUSTOM);
      soa(st, ISD_BUILD_VECTOR,       VT, LA_CUSTOM);
      soa(st, ISD_EXTRACT_VECTOR_ELT, VT, LA_CUSTOM);
      soa(st, ISD_VECTOR_SHUFFLE,     VT, LA_CUSTOM);
      soa(st, ISD_SCALAR_TO_VECTOR,   VT, LA_CUSTOM);
      soa(st, ISD_INSERT_VECTOR_ELT,  VT, LA_CUSTOM);
    }
    set_f16_action(st, MVT_v32f16, LA_EXPAND);
    soa(st, ISD_FP_ROUND, MVT_v16f16, LA_CUSTOM);
    soa(st, ISD_STRICT_FP_ROUND, MVT_v16f16, LA_CUSTOM);
    soa(st, ISD_FP_EXTEND, MVT_v16f32, LA_CUSTOM);
    soa(st, ISD_STRICT_FP_EXTEND, MVT_v16f32, LA_CUSTOM);
    for Opc: u32.[ISD_FADD, ISD_FSUB, ISD_FMUL, ISD_FDIV] 
      sopt(st, Opc, MVT_v32f16, MVT_v32f32);
    soa(st, ISD_SETCC, MVT_v32f16, LA_CUSTOM);

    for VT: u32.[ MVT_v16i32, MVT_v8i64, MVT_v16f32, MVT_v8f64 ]  {
      soa(st, ISD_MLOAD,               VT, LA_LEGAL);
      soa(st, ISD_MSTORE,              VT, LA_LEGAL);
      soa(st, ISD_MGATHER,             VT, LA_CUSTOM);
      soa(st, ISD_MSCATTER,            VT, LA_CUSTOM);
    }
    if (HasBWI) {
      for VT: u32.[ MVT_v64i8, MVT_v32i16 ]  {
        soa(st, ISD_MLOAD,        VT, LA_LEGAL);
        soa(st, ISD_MSTORE,       VT, LA_LEGAL);
      }
    } else {
      soa(st, ISD_STORE, MVT_v32i16, LA_CUSTOM);
      soa(st, ISD_STORE, MVT_v64i8,  LA_CUSTOM);
    }

    if (st_hasVBMI2(st)) {
      for VT: u32.[MVT_v32i16, MVT_v16i32, MVT_v8i64]  {
        soa(st, ISD_FSHL, VT, LA_LEGAL);
        soa(st, ISD_FSHR, VT, LA_LEGAL);
      }

      soa(st, ISD_ROTL, MVT_v32i16, LA_LEGAL);
      soa(st, ISD_ROTR, MVT_v32i16, LA_LEGAL);
    }

    
    if (st_hasPCLMUL(st)) {
      for VT: u32.[MVT_v16i32, MVT_v8i64]  {
        soa(st, ISD_CLMUL, VT, LA_CUSTOM);
        soa(st, ISD_CLMULH, VT, LA_CUSTOM);
      }
    }

    soa(st, ISD_FNEG, MVT_v32f16, LA_CUSTOM);
    soa(st, ISD_FABS, MVT_v32f16, LA_CUSTOM);
    soa(st, ISD_FCOPYSIGN, MVT_v32f16, LA_CUSTOM);
    soa(st, ISD_FLDEXP, MVT_v32f16, LA_CUSTOM);

    if (st_hasGFNI(st)) {
      soa(st, ISD_CTLZ, MVT_v64i8, LA_CUSTOM);
      soa(st, ISD_CTTZ, MVT_v64i8, LA_CUSTOM);
    }
  }

  if (!st_useSoftFloat(st) && st_hasVBMI2(st)) {
    for VT: u32.[MVT_v8i16, MVT_v4i32, MVT_v2i64, MVT_v16i16, MVT_v8i32,
                    MVT_v4i64]  {
      soa(st, ISD_FSHL, VT, LA_LEGAL);
      soa(st, ISD_FSHR, VT, LA_LEGAL);
    }

    soa(st, ISD_ROTL, MVT_v16i16, LA_LEGAL);
    soa(st, ISD_ROTR, MVT_v16i16, LA_LEGAL);
    soa(st, ISD_ROTL, MVT_v8i16, LA_LEGAL);
    soa(st, ISD_ROTR, MVT_v8i16, LA_LEGAL);
  }

  
  
  
  if (!st_useSoftFloat(st) && st_hasAVX512(st)) {
    for VT: u32.[MVT_f16, MVT_f32, MVT_f64, MVT_v8f16, MVT_v4f32,
                   MVT_v2f64, MVT_v16f16, MVT_v8f32, MVT_v4f64] 
      soa(st, ISD_FLDEXP, VT, LA_CUSTOM);

    
    
    soa(st, ISD_STRICT_FP_TO_UINT,  MVT_v8i32, LA_CUSTOM);
    soa(st, ISD_STRICT_FP_TO_UINT,  MVT_v4i32, LA_CUSTOM);
    soa(st, ISD_STRICT_FP_TO_UINT,  MVT_v2i32, LA_CUSTOM);

    if (st_hasDQI(st)) {
      
      
      {}
      
      soa(st, ISD_FP_TO_SINT,        MVT_v2f32, LA_CUSTOM);
      soa(st, ISD_FP_TO_UINT,        MVT_v2f32, LA_CUSTOM);
      soa(st, ISD_STRICT_FP_TO_SINT, MVT_v2f32, LA_CUSTOM);
      soa(st, ISD_STRICT_FP_TO_UINT, MVT_v2f32, LA_CUSTOM);
    }

    for VT: u32.[ MVT_v2i64, MVT_v4i64 ]  {
      soa(st, ISD_SMAX, VT, LA_LEGAL);
      soa(st, ISD_UMAX, VT, LA_LEGAL);
      soa(st, ISD_SMIN, VT, LA_LEGAL);
      soa(st, ISD_UMIN, VT, LA_LEGAL);
      soa(st, ISD_ABS,  VT, LA_LEGAL);
    }

    for VT: u32.[ MVT_v4i32, MVT_v8i32, MVT_v2i64, MVT_v4i64 ]  {
      soa(st, ISD_ROTL,     VT, LA_LEGAL);
      soa(st, ISD_ROTR,     VT, LA_LEGAL);
    }

    
    soa(st, ISD_MSCATTER, MVT_v2f32, LA_CUSTOM);
    soa(st, ISD_MSCATTER, MVT_v2i32, LA_CUSTOM);

    for VT: u32.[ MVT_v4i32, MVT_v8i32, MVT_v2i64, MVT_v4i64,
                     MVT_v4f32, MVT_v8f32, MVT_v2f64, MVT_v4f64 ] 
      soa(st, ISD_MSCATTER, VT, LA_CUSTOM);

    if (st_hasDQI(st)) {
      for Opc: u32.[ISD_SINT_TO_FP, ISD_UINT_TO_FP, ISD_STRICT_SINT_TO_FP,
                       ISD_STRICT_UINT_TO_FP, ISD_FP_TO_SINT, ISD_FP_TO_UINT,
                       ISD_STRICT_FP_TO_SINT, ISD_STRICT_FP_TO_UINT]  {
        soa(st, Opc, MVT_v2i64, LA_CUSTOM);
        soa(st, Opc, MVT_v4i64, LA_CUSTOM);
      }
      soa(st, ISD_MUL, MVT_v2i64, LA_LEGAL);
      soa(st, ISD_MUL, MVT_v4i64, LA_LEGAL);

      
      
      soa(st, ISD_MULHS, MVT_v4i64, LA_CUSTOM);
    }

    if (st_hasCDI(st)) {
      for VT: u32.[MVT_i256, MVT_i512]  {
        if (VT == MVT_i512 && !st_useAVX512Regs(st))
          continue;
        soa(st, ISD_CTLZ, VT, LA_CUSTOM);
        soa(st, ISD_CTTZ, VT, LA_CUSTOM);
        soa(st, ISD_CTLZ_ZERO_POISON, VT, LA_CUSTOM);
        soa(st, ISD_CTTZ_ZERO_POISON, VT, LA_CUSTOM);
      }
      for VT: u32.[ MVT_v4i32, MVT_v8i32, MVT_v2i64, MVT_v4i64 ]  {
        soa(st, ISD_CTLZ,            VT, LA_LEGAL);
      }
    } 

    if (st_hasVPOPCNTDQ(st)) {
      for VT: u32.[MVT_v4i32, MVT_v8i32, MVT_v2i64, MVT_v4i64] 
        soa(st, ISD_CTPOP, VT, LA_LEGAL);
      soa(st, ISD_CTPOP, MVT_i256, LA_CUSTOM);
    }

    
    
    
    for VT: u32.[MVT_v8i32, MVT_v8f32, MVT_v4i32, MVT_v4f32, MVT_v4i64,
                   MVT_v4f64, MVT_v2i64, MVT_v2f64, MVT_v16i8, MVT_v8i16,
                   MVT_v16i16, MVT_v8i8] 
      soa(st, ISD_VECTOR_COMPRESS, VT, LA_CUSTOM);

    
    
    for VT: u32.[MVT_v16i32, MVT_v16f32, MVT_v8i64, MVT_v8f64] 
      soa(st, ISD_VECTOR_COMPRESS, VT, LA_LEGAL);

    
    if (st_hasVLX(st))
      for VT: u32.[MVT_v8i32, MVT_v8f32, MVT_v4i32, MVT_v4f32, MVT_v4i64,
                     MVT_v4f64, MVT_v2i64, MVT_v2f64] 
        soa(st, ISD_VECTOR_COMPRESS, VT, LA_LEGAL);

    
    if (st_hasVBMI2(st))
      for VT: u32.[MVT_v32i16, MVT_v64i8] 
        soa(st, ISD_VECTOR_COMPRESS, VT, LA_LEGAL);

    
    if (st_hasVBMI2(st) && st_hasVLX(st))
      for VT: u32.[MVT_v16i8, MVT_v8i16, MVT_v32i8, MVT_v16i16] 
        soa(st, ISD_VECTOR_COMPRESS, VT, LA_LEGAL);
  }

  
  
  if (!st_useSoftFloat(st) && st_hasBWI(st)) {
    add_reg_class(st, MVT_v32i1);
    add_reg_class(st, MVT_v64i1);

    for VT: u32.[ MVT_v32i1, MVT_v64i1 ]  {
      soa(st, ISD_VSELECT,            VT, LA_EXPAND);
      soa(st, ISD_TRUNCATE,           VT, LA_CUSTOM);
      soa(st, ISD_SETCC,              VT, LA_CUSTOM);
      soa(st, ISD_EXTRACT_VECTOR_ELT, VT, LA_CUSTOM);
      soa(st, ISD_INSERT_VECTOR_ELT,  VT, LA_CUSTOM);
      soa(st, ISD_SELECT,             VT, LA_CUSTOM);
      soa(st, ISD_BUILD_VECTOR,       VT, LA_CUSTOM);
      soa(st, ISD_VECTOR_SHUFFLE,     VT, LA_CUSTOM);
      soa(st, ISD_CONCAT_VECTORS,     VT, LA_CUSTOM);
      soa(st, ISD_INSERT_SUBVECTOR,   VT, LA_CUSTOM);
    }

    for VT: u32.[ MVT_v16i1, MVT_v32i1 ] 
      soa(st, ISD_EXTRACT_SUBVECTOR, VT, LA_CUSTOM);

    
    soa(st, ISD_SIGN_EXTEND,        MVT_v32i8, LA_CUSTOM);
    soa(st, ISD_ZERO_EXTEND,        MVT_v32i8, LA_CUSTOM);
    soa(st, ISD_ANY_EXTEND,         MVT_v32i8, LA_CUSTOM);

    for VT: u32.[MVT_v32i8, MVT_v16i8, MVT_v16i16, MVT_v8i16,
                    MVT_v16f16, MVT_v8f16]  {
      soa(st, ISD_MLOAD,  VT, ifx st_hasVLX(st) then LA_LEGAL else LA_CUSTOM);
      soa(st, ISD_MSTORE, VT, ifx st_hasVLX(st) then LA_LEGAL else LA_CUSTOM);
    }

    
    
    

    if (st_hasBITALG(st)) {
      for VT: u32.[ MVT_v16i8, MVT_v32i8, MVT_v8i16, MVT_v16i16 ] 
        soa(st, ISD_CTPOP, VT, LA_LEGAL);
    }

    if (st_hasBMM(st)) {
      soa(st, ISD_BITREVERSE, MVT_i8, LA_CUSTOM);
      soa(st, ISD_BITREVERSE, MVT_i16, LA_CUSTOM);
      soa(st, ISD_BITREVERSE, MVT_i32, LA_CUSTOM);
      soa(st, ISD_BITREVERSE, MVT_i64, LA_CUSTOM);

      for VT: u32.[MVT_v16i8, MVT_v32i8, MVT_v64i8] 
        soa(st, ISD_BITREVERSE, VT, LA_LEGAL);
    }
  }

  if (!st_useSoftFloat(st) && st_hasFP16(st)) {
    

    
    set_group(st, MVT_f16);
    set_fp_min_max_action(st, MVT_f16);
    soa(st, ISD_FREM,                 MVT_f16, LA_PROMOTE);
    soa(st, ISD_STRICT_FREM,          MVT_f16, LA_PROMOTE);
    soa(st, ISD_SELECT_CC,            MVT_f16, LA_EXPAND);
    soa(st, ISD_BR_CC,                MVT_f16, LA_EXPAND);
    soa(st, ISD_STRICT_FROUND,        MVT_f16, LA_PROMOTE);
    soa(st, ISD_FROUNDEVEN,           MVT_f16, LA_LEGAL);
    soa(st, ISD_STRICT_FROUNDEVEN,    MVT_f16, LA_LEGAL);
    soa(st, ISD_FP_ROUND,             MVT_f16, LA_CUSTOM);
    soa(st, ISD_STRICT_FP_ROUND,      MVT_f16, LA_CUSTOM);
    soa(st, ISD_FP_EXTEND,            MVT_f32, LA_LEGAL);
    soa(st, ISD_STRICT_FP_EXTEND,     MVT_f32, LA_LEGAL);
    soa(st, ISD_LRINT,                MVT_f16, LA_LEGAL);
    soa(st, ISD_LLRINT,               MVT_f16, LA_LEGAL);

    scca(st, ISD_SETOEQ, MVT_f16, LA_EXPAND);
    scca(st, ISD_SETUNE, MVT_f16, LA_EXPAND);

    if (st_useAVX512Regs(st)) {
      set_group(st, MVT_v32f16);
      soa(st, ISD_SCALAR_TO_VECTOR,       MVT_v32f16, LA_CUSTOM);
      soa(st, ISD_SINT_TO_FP,             MVT_v32i16, LA_LEGAL);
      soa(st, ISD_STRICT_SINT_TO_FP,      MVT_v32i16, LA_LEGAL);
      soa(st, ISD_UINT_TO_FP,             MVT_v32i16, LA_LEGAL);
      soa(st, ISD_STRICT_UINT_TO_FP,      MVT_v32i16, LA_LEGAL);
      soa(st, ISD_FP_ROUND,               MVT_v16f16, LA_LEGAL);
      soa(st, ISD_STRICT_FP_ROUND,        MVT_v16f16, LA_LEGAL);
      soa(st, ISD_FP_EXTEND,              MVT_v16f32, LA_CUSTOM);
      soa(st, ISD_STRICT_FP_EXTEND,       MVT_v16f32, LA_LEGAL);
      soa(st, ISD_FP_EXTEND,              MVT_v8f64,  LA_CUSTOM);
      soa(st, ISD_STRICT_FP_EXTEND,       MVT_v8f64,  LA_LEGAL);
      soa(st, ISD_INSERT_VECTOR_ELT,      MVT_v32f16, LA_CUSTOM);

      soa(st, ISD_FP_TO_SINT,             MVT_v32i16, LA_CUSTOM);
      soa(st, ISD_STRICT_FP_TO_SINT,      MVT_v32i16, LA_CUSTOM);
      soa(st, ISD_FP_TO_UINT,             MVT_v32i16, LA_CUSTOM);
      soa(st, ISD_STRICT_FP_TO_UINT,      MVT_v32i16, LA_CUSTOM);
      sopt(st, ISD_FP_TO_SINT,     MVT_v32i8,  MVT_v32i16);
      sopt(st, ISD_STRICT_FP_TO_SINT, MVT_v32i8,
                                 MVT_v32i16);
      sopt(st, ISD_FP_TO_UINT,     MVT_v32i8,  MVT_v32i16);
      sopt(st, ISD_STRICT_FP_TO_UINT, MVT_v32i8,
                                 MVT_v32i16);
      sopt(st, ISD_FP_TO_SINT,     MVT_v32i1,  MVT_v32i16);
      sopt(st, ISD_STRICT_FP_TO_SINT, MVT_v32i1,
                                 MVT_v32i16);
      sopt(st, ISD_FP_TO_UINT,     MVT_v32i1,  MVT_v32i16);
      sopt(st, ISD_STRICT_FP_TO_UINT, MVT_v32i1,
                                 MVT_v32i16);

      soa(st, ISD_EXTRACT_SUBVECTOR,      MVT_v16f16, LA_LEGAL);
      soa(st, ISD_INSERT_SUBVECTOR,       MVT_v32f16, LA_LEGAL);
      soa(st, ISD_CONCAT_VECTORS,         MVT_v32f16, LA_CUSTOM);

      slea(st, ISD_EXTLOAD, MVT_v8f64,  MVT_v8f16,  LA_LEGAL);
      slea(st, ISD_EXTLOAD, MVT_v16f32, MVT_v16f16, LA_LEGAL);

      set_fp_min_max_action(st, MVT_v32f16);
      soa(st, ISD_LRINT, MVT_v32f16, LA_LEGAL);
      soa(st, ISD_LLRINT, MVT_v8f16, LA_LEGAL);
    }

    soa(st, ISD_FP_TO_SINT,         MVT_v8i16, LA_CUSTOM);
    soa(st, ISD_STRICT_FP_TO_SINT,  MVT_v8i16, LA_CUSTOM);
    soa(st, ISD_FP_TO_UINT,         MVT_v8i16, LA_CUSTOM);
    soa(st, ISD_STRICT_FP_TO_UINT,  MVT_v8i16, LA_CUSTOM);

    if (st_hasVLX(st)) {
      set_group(st, MVT_v8f16);
      set_group(st, MVT_v16f16);

      soa(st, ISD_SCALAR_TO_VECTOR,   MVT_v8f16,  LA_LEGAL);
      soa(st, ISD_SCALAR_TO_VECTOR,   MVT_v16f16, LA_CUSTOM);
      soa(st, ISD_SINT_TO_FP,         MVT_v16i16, LA_LEGAL);
      soa(st, ISD_STRICT_SINT_TO_FP,  MVT_v16i16, LA_LEGAL);
      soa(st, ISD_SINT_TO_FP,         MVT_v8i16,  LA_LEGAL);
      soa(st, ISD_STRICT_SINT_TO_FP,  MVT_v8i16,  LA_LEGAL);
      soa(st, ISD_UINT_TO_FP,         MVT_v16i16, LA_LEGAL);
      soa(st, ISD_STRICT_UINT_TO_FP,  MVT_v16i16, LA_LEGAL);
      soa(st, ISD_UINT_TO_FP,         MVT_v8i16,  LA_LEGAL);
      soa(st, ISD_STRICT_UINT_TO_FP,  MVT_v8i16,  LA_LEGAL);

      soa(st, ISD_FP_ROUND,           MVT_v8f16, LA_LEGAL);
      soa(st, ISD_STRICT_FP_ROUND,    MVT_v8f16, LA_LEGAL);
      soa(st, ISD_FP_EXTEND,          MVT_v8f32, LA_CUSTOM);
      soa(st, ISD_STRICT_FP_EXTEND,   MVT_v8f32, LA_LEGAL);
      soa(st, ISD_FP_EXTEND,          MVT_v4f64, LA_CUSTOM);
      soa(st, ISD_STRICT_FP_EXTEND,   MVT_v4f64, LA_LEGAL);

      
      soa(st, ISD_INSERT_VECTOR_ELT,    MVT_v8f16,  LA_CUSTOM);
      soa(st, ISD_INSERT_VECTOR_ELT,    MVT_v16f16, LA_CUSTOM);

      soa(st, ISD_EXTRACT_SUBVECTOR,    MVT_v8f16, LA_LEGAL);
      soa(st, ISD_INSERT_SUBVECTOR,     MVT_v16f16, LA_LEGAL);
      soa(st, ISD_CONCAT_VECTORS,       MVT_v16f16, LA_CUSTOM);

      slea(st, ISD_EXTLOAD, MVT_v4f64, MVT_v4f16, LA_LEGAL);
      slea(st, ISD_EXTLOAD, MVT_v2f64, MVT_v2f16, LA_LEGAL);
      slea(st, ISD_EXTLOAD, MVT_v8f32, MVT_v8f16, LA_LEGAL);
      slea(st, ISD_EXTLOAD, MVT_v4f32, MVT_v4f16, LA_LEGAL);

      
      soa(st, ISD_LOAD,  MVT_v4f16, LA_CUSTOM);
      soa(st, ISD_STORE, MVT_v4f16, LA_CUSTOM);

      set_fp_min_max_action(st, MVT_v8f16);
      set_fp_min_max_action(st, MVT_v16f16);

      soa(st, ISD_LRINT, MVT_v8f16, LA_LEGAL);
      soa(st, ISD_LRINT, MVT_v16f16, LA_LEGAL);
    }
  }

  if (!st_useSoftFloat(st) &&
      (st_hasAVXNECONVERT(st) || st_hasBF16(st))) {
    add_reg_class(st, MVT_v8bf16);
    add_reg_class(st, MVT_v16bf16);
    
    
    
    soa(st, ISD_BUILD_VECTOR, MVT_bf16, LA_CUSTOM);
    soa(st, ISD_INSERT_VECTOR_ELT, MVT_bf16, LA_CUSTOM);
    for VT: u32.[MVT_v8bf16, MVT_v16bf16]  {
      set_f16_action(st, VT, LA_EXPAND);
      if (!st_hasBF16(st))
        soa(st, ISD_VSELECT, VT, LA_CUSTOM);
      soa(st, ISD_BUILD_VECTOR, VT, LA_CUSTOM);
      soa(st, ISD_VECTOR_SHUFFLE, VT, LA_CUSTOM);
      soa(st, ISD_INSERT_SUBVECTOR, VT, LA_LEGAL);
      soa(st, ISD_CONCAT_VECTORS, VT, LA_CUSTOM);
    }
    for Opc: u32.[ISD_FADD, ISD_FSUB, ISD_FMUL, ISD_FDIV]  {
      sopt(st, Opc, MVT_v8bf16, MVT_v8f32);
      sopt(st, Opc, MVT_v16bf16, MVT_v16f32);
    }
    soa(st, ISD_SETCC, MVT_v8bf16, LA_CUSTOM);
    soa(st, ISD_SETCC, MVT_v16bf16, LA_CUSTOM);
    soa(st, ISD_FP_ROUND, MVT_v8bf16, LA_CUSTOM);
    {}
  }

  if (!st_useSoftFloat(st) && st_hasBF16(st) &&
      st_useAVX512Regs(st)) {
    add_reg_class(st, MVT_v32bf16);
    set_f16_action(st, MVT_v32bf16, LA_EXPAND);
    for Opc: u32.[ISD_FADD, ISD_FSUB, ISD_FMUL, ISD_FDIV] 
      sopt(st, Opc, MVT_v32bf16, MVT_v32f32);
    soa(st, ISD_SETCC, MVT_v32bf16, LA_CUSTOM);
    soa(st, ISD_BUILD_VECTOR, MVT_v32bf16, LA_CUSTOM);
    soa(st, ISD_FP_ROUND, MVT_v16bf16, LA_CUSTOM);
    soa(st, ISD_VECTOR_SHUFFLE, MVT_v32bf16, LA_CUSTOM);
    soa(st, ISD_INSERT_SUBVECTOR, MVT_v32bf16, LA_LEGAL);
    soa(st, ISD_CONCAT_VECTORS, MVT_v32bf16, LA_CUSTOM);
  }

  if (!st_useSoftFloat(st) && st_hasAVX10_2(st)) {
    soa(st, ISD_FADD, MVT_v32bf16, LA_LEGAL);
    soa(st, ISD_FSUB, MVT_v32bf16, LA_LEGAL);
    soa(st, ISD_FMUL, MVT_v32bf16, LA_LEGAL);
    soa(st, ISD_FDIV, MVT_v32bf16, LA_LEGAL);
    soa(st, ISD_FSQRT, MVT_v32bf16, LA_LEGAL);
    soa(st, ISD_FMA, MVT_v32bf16, LA_LEGAL);
    soa(st, ISD_SETCC, MVT_v32bf16, LA_CUSTOM);
    set_fp_min_max_action(st, MVT_v32bf16);
    for VT: u32.[MVT_v8bf16, MVT_v16bf16]  {
      soa(st, ISD_FADD, VT, LA_LEGAL);
      soa(st, ISD_FSUB, VT, LA_LEGAL);
      soa(st, ISD_FMUL, VT, LA_LEGAL);
      soa(st, ISD_FDIV, VT, LA_LEGAL);
      soa(st, ISD_FSQRT, VT, LA_LEGAL);
      soa(st, ISD_FMA, VT, LA_LEGAL);
      soa(st, ISD_SETCC, VT, LA_CUSTOM);
      set_fp_min_max_action(st, VT);
    }
    for VT: u32.[MVT_f16, MVT_f32, MVT_f64]  {
      scca(st, ISD_SETOEQ, VT, LA_CUSTOM);
      scca(st, ISD_SETUNE, VT, LA_CUSTOM);
    }
  }

  if (!st_useSoftFloat(st) && st_hasVLX(st)) {
    stsa(st, MVT_v4i64, MVT_v4i8,  LA_LEGAL);
    stsa(st, MVT_v4i64, MVT_v4i16, LA_LEGAL);
    stsa(st, MVT_v4i64, MVT_v4i32, LA_LEGAL);
    stsa(st, MVT_v8i32, MVT_v8i8,  LA_LEGAL);
    stsa(st, MVT_v8i32, MVT_v8i16, LA_LEGAL);

    stsa(st, MVT_v2i64, MVT_v2i8,  LA_LEGAL);
    stsa(st, MVT_v2i64, MVT_v2i16, LA_LEGAL);
    stsa(st, MVT_v2i64, MVT_v2i32, LA_LEGAL);
    stsa(st, MVT_v4i32, MVT_v4i8,  LA_LEGAL);
    stsa(st, MVT_v4i32, MVT_v4i16, LA_LEGAL);

    if (st_hasBWI(st)) {
      stsa(st, MVT_v16i16,  MVT_v16i8, LA_LEGAL);
      stsa(st, MVT_v8i16,   MVT_v8i8,  LA_LEGAL);
    }

    if (st_hasFP16(st)) {
      
      soa(st, ISD_FP_TO_SINT,        MVT_v2f16, LA_CUSTOM);
      soa(st, ISD_STRICT_FP_TO_SINT, MVT_v2f16, LA_CUSTOM);
      soa(st, ISD_FP_TO_UINT,        MVT_v2f16, LA_CUSTOM);
      soa(st, ISD_STRICT_FP_TO_UINT, MVT_v2f16, LA_CUSTOM);
      soa(st, ISD_FP_TO_SINT,        MVT_v4f16, LA_CUSTOM);
      soa(st, ISD_STRICT_FP_TO_SINT, MVT_v4f16, LA_CUSTOM);
      soa(st, ISD_FP_TO_UINT,        MVT_v4f16, LA_CUSTOM);
      soa(st, ISD_STRICT_FP_TO_UINT, MVT_v4f16, LA_CUSTOM);
      
      soa(st, ISD_SINT_TO_FP,        MVT_v2f16, LA_CUSTOM);
      soa(st, ISD_STRICT_SINT_TO_FP, MVT_v2f16, LA_CUSTOM);
      soa(st, ISD_UINT_TO_FP,        MVT_v2f16, LA_CUSTOM);
      soa(st, ISD_STRICT_UINT_TO_FP, MVT_v2f16, LA_CUSTOM);
      soa(st, ISD_SINT_TO_FP,        MVT_v4f16, LA_CUSTOM);
      soa(st, ISD_STRICT_SINT_TO_FP, MVT_v4f16, LA_CUSTOM);
      soa(st, ISD_UINT_TO_FP,        MVT_v4f16, LA_CUSTOM);
      soa(st, ISD_STRICT_UINT_TO_FP, MVT_v4f16, LA_CUSTOM);
      
      soa(st, ISD_FP_ROUND,          MVT_v2f16, LA_CUSTOM);
      soa(st, ISD_STRICT_FP_ROUND,   MVT_v2f16, LA_CUSTOM);
      soa(st, ISD_FP_ROUND,          MVT_v4f16, LA_CUSTOM);
      soa(st, ISD_STRICT_FP_ROUND,   MVT_v4f16, LA_CUSTOM);
      
      soa(st, ISD_FP_EXTEND,         MVT_v2f16, LA_CUSTOM);
      soa(st, ISD_STRICT_FP_EXTEND,  MVT_v2f16, LA_CUSTOM);
      soa(st, ISD_FP_EXTEND,         MVT_v4f16, LA_CUSTOM);
      soa(st, ISD_STRICT_FP_EXTEND,  MVT_v4f16, LA_CUSTOM);
    }
  }

  if (!st_useSoftFloat(st) && st_hasAMXTILE(st)) {
    add_reg_class(st, MVT_x86amx);
  }

  
  soa(st, ISD_INTRINSIC_WO_CHAIN, MVT_Other, LA_CUSTOM);
  soa(st, ISD_INTRINSIC_W_CHAIN, MVT_Other, LA_CUSTOM);
  soa(st, ISD_INTRINSIC_VOID, MVT_Other, LA_CUSTOM);
  if (!st_is64Bit(st)) {
    soa(st, ISD_INTRINSIC_W_CHAIN, MVT_i64, LA_CUSTOM);
  }

  
  
  
  
  
  
  for VT: u32.[ MVT_i8, MVT_i16, MVT_i32, MVT_i64 ]  {
    if (VT == MVT_i64 && !st_is64Bit(st))
      continue;
    
    soa(st, ISD_SADDO, VT, LA_CUSTOM);
    soa(st, ISD_UADDO, VT, LA_CUSTOM);
    soa(st, ISD_SSUBO, VT, LA_CUSTOM);
    soa(st, ISD_USUBO, VT, LA_CUSTOM);
    soa(st, ISD_SMULO, VT, LA_CUSTOM);
    soa(st, ISD_UMULO, VT, LA_CUSTOM);

    
    soa(st, ISD_UADDO_CARRY, VT, LA_CUSTOM);
    soa(st, ISD_USUBO_CARRY, VT, LA_CUSTOM);
    soa(st, ISD_SETCCCARRY, VT, LA_CUSTOM);
    soa(st, ISD_SADDO_CARRY, VT, LA_CUSTOM);
    soa(st, ISD_SSUBO_CARRY, VT, LA_CUSTOM);
  }

  
  soa(st, ISD_FSINCOS, MVT_f64, LA_EXPAND);
  soa(st, ISD_FSINCOS, MVT_f32, LA_EXPAND);

  if (st_isTargetWin64(st)) {
    soa(st, ISD_SDIV, MVT_i128, LA_CUSTOM);
    soa(st, ISD_UDIV, MVT_i128, LA_CUSTOM);
    soa(st, ISD_SREM, MVT_i128, LA_CUSTOM);
    soa(st, ISD_UREM, MVT_i128, LA_CUSTOM);
    soa(st, ISD_FP_TO_SINT, MVT_i128, LA_CUSTOM);
    soa(st, ISD_FP_TO_UINT, MVT_i128, LA_CUSTOM);
    soa(st, ISD_SINT_TO_FP, MVT_i128, LA_CUSTOM);
    soa(st, ISD_UINT_TO_FP, MVT_i128, LA_CUSTOM);
    soa(st, ISD_STRICT_FP_TO_SINT, MVT_i128, LA_CUSTOM);
    soa(st, ISD_STRICT_FP_TO_UINT, MVT_i128, LA_CUSTOM);
    soa(st, ISD_STRICT_SINT_TO_FP, MVT_i128, LA_CUSTOM);
    soa(st, ISD_STRICT_UINT_TO_FP, MVT_i128, LA_CUSTOM);
  }

  
  
  
  
  if (st_is32Bit(st) &&
      (st_isTargetWindowsMSVC(st) || st_isTargetWindowsItanium(st)))
    
   for Op: u32.[ISD_FACOS,  ISD_STRICT_FACOS,
          ISD_FASIN,  ISD_STRICT_FASIN,
          ISD_FATAN,  ISD_STRICT_FATAN,
          ISD_FATAN2, ISD_STRICT_FATAN2,
          ISD_FCEIL,  ISD_STRICT_FCEIL,
          ISD_FCOS,   ISD_STRICT_FCOS,
          ISD_FCOSH,  ISD_STRICT_FCOSH,
          ISD_FEXP,   ISD_STRICT_FEXP,
          ISD_FFLOOR, ISD_STRICT_FFLOOR,
          ISD_FREM,   ISD_STRICT_FREM,
          ISD_FLOG,   ISD_STRICT_FLOG,
          ISD_FLOG10, ISD_STRICT_FLOG10,
          ISD_FPOW,   ISD_STRICT_FPOW,
          ISD_FSIN,   ISD_STRICT_FSIN,
          ISD_FSINH,  ISD_STRICT_FSINH,
          ISD_FTAN,   ISD_STRICT_FTAN,
          ISD_FTANH,  ISD_STRICT_FTANH,
          
          ISD_FMODF] 
     if (is_op_expand_or_libcall(st, Op, MVT_f32))
        soa(st, Op, MVT_f32, LA_PROMOTE);
  

  
  
  if (st_isOSWindows(st)) {
    for Op: u32.[ISD_FLDEXP, ISD_STRICT_FLDEXP, ISD_FFREXP] 
      if (is_op_expand(st, Op, MVT_f32))
        soa(st, Op, MVT_f32, LA_PROMOTE);
  }

  sopt(st, ISD_ATOMIC_LOAD, MVT_f16, MVT_i16);
  sopt(st, ISD_ATOMIC_LOAD, MVT_f32, MVT_i32);
  sopt(st, ISD_ATOMIC_LOAD, MVT_f64, MVT_i64);

  sopt(st, ISD_ATOMIC_STORE, MVT_f16, MVT_i16);
  sopt(st, ISD_ATOMIC_STORE, MVT_f32, MVT_i32);
  sopt(st, ISD_ATOMIC_STORE, MVT_f64, MVT_i64);

  
  {}

  
}
