// The OpenMPIRBuilder pieces OpenMPOpt uses: a port of parts of llvm/lib/Frontend/OpenMP/OMPIRBuilder.cpp
// (initializeTypes, addAttributes, getOrCreateRuntimeFunction, getOrCreateSrcLocStr / getOrCreateDefaultSrcLocStr,
// getOrCreateIdent, readThreadBoundsForKernel, readTeamBoundsForKernel) over the tables of
// llvm/include/llvm/Frontend/OpenMP/OMPKinds.def (gen_omp_kinds.jai, generated by gen/gen_omp_kinds.py).
// createParallel / createMaster / createBarrier / finalize (parallel region merging) are in omp_ir_builder_outline.jai.

// -openmp-ir-builder-optimistic-attributes (OptimisticAttributes)
omp_optimistic_attributes := false;

// The parts of an OpenMPIRBuilder instance that OpenMPOpt reaches: Config (IsTargetDevice, IsGPU) and the
// SrcLocStrMap / IdentMap caches. One per OMPInformationCache.
Omp_Ident_Entry :: struct { src_loc_str: Value_Id; flags: u64; ident: Value_Id; }
Omp_Builder :: struct {
    is_target_device: bool;
    is_gpu: bool;
    src_loc_str_map: Table(string, Value_Id);
    ident_map: [..] Omp_Ident_Entry;
}

// OMP_IDENT_FLAG_KMPC (OMPConstants.h)
OMP_IDENT_FLAG_KMPC :: 0x02;
OMP_IDENT_FLAG_BARRIER_IMPL :: 0x40;
OMP_IDENT_FLAG_BARRIER_EXPL :: 0x20;

// The OMP_TYPE / OMP_STRUCT_TYPE / ... type of `t` (every pointer type of the table is `ptr` in address space 0)
omp_type :: (t: Omp_Ty) -> Type_Id {
    if t == {
        case .VOID; return ir.t_void;
        case .I1; return type_int(1);
        case .I8; return type_int(8);
        case .I16; return type_int(16);
        case .I32; return type_int(32);
        case .I63; return type_int(63);
        case .I64; return type_int(64);
        case .DOUBLE; return type_simple(.DOUBLE);
        case .SIZE; return dl_int_ptr_type(ir.t_ptr);   // M.getDataLayout().getIntPtrType(Ctx)
        case .PTR; return ir.t_ptr;
    }
    fatal("internal: omp_type: no type for %", t);
    return NONE;
}

omp_rtl_name :: inline (r: Omp_Rtl) -> string { return OMP_RTL_NAMES[cast(s64) r]; }
omp_rtl_ret_type :: (r: Omp_Rtl) -> Type_Id { return omp_type(OMP_RTL_SIG[OMP_RTL_SIG_OFFSET[cast(s64) r]]); }
// The argument types of `r` (OMP_RTL's __VA_ARGS__)
omp_rtl_arg_types :: (r: Omp_Rtl) -> [..] Type_Id {
    out: [..] Type_Id; out.allocator = temp;
    k := cast(s64) OMP_RTL_SIG_OFFSET[cast(s64) r] + 1;
    while OMP_RTL_SIG[k] != .END { array_add(*out, omp_type(OMP_RTL_SIG[k])); k += 1; }
    return out;
}
// FunctionType::get(ReturnType, {__VA_ARGS__}, IsVarArg)
omp_rtl_fn_type :: (r: Omp_Rtl) -> Type_Id {
    return type_func(omp_rtl_ret_type(r), omp_rtl_arg_types(r), OMP_RTL_VARARG[cast(s64) r]);
}

// The named struct types of initializeTypes: StructType::getTypeByName, else StructType::create
omp_struct_type :: (name: string, elts: [] Type_Id) -> Type_Id {
    found, t := table_find(*ir.named_types, name);
    if found return t;
    t = type_named_struct("");
    set_struct_body(t, elts, false);
    ctx_set_struct_name(t, name);
    return t;
}
// OpenMPIRBuilder::Ident (%struct.ident_t = type { i32, i32, i32, i32, ptr })
omp_ident_type :: () -> Type_Id {
    i32 := type_int(32);
    return omp_struct_type("struct.ident_t", .[i32, i32, i32, i32, ir.t_ptr]);
}
// OpenMPIRBuilder::AsyncInfo (%struct.__tgt_async_info = type { ptr })
omp_async_info_type :: () -> Type_Id { return omp_struct_type("struct.__tgt_async_info", .[ir.t_ptr]); }

// ---------------------------------------------------------------- attributes

// The attributes of an OMP_ATTRS_SET atom (the ext atoms are handled by omp_add_attr_set)
omp_atom_attr :: (a: Omp_Atom) -> Attr {
    if a == {
        case .NOUNWIND; return attr_enum(.NoUnwind);
        case .NOSYNC; return attr_enum(.NoSync);
        case .NOFREE; return attr_enum(.NoFree);
        case .WILLRETURN; return attr_enum(.WillReturn);
        case .CONVERGENT; return attr_enum(.Convergent);
        case .ALWAYSINLINE; return attr_enum(.AlwaysInline);
        case .READONLY; return attr_enum(.ReadOnly);
        case .WRITEONLY; return attr_enum(.WriteOnly);
        case .NOALIAS; return attr_enum(.NoAlias);
        case .ALLOCATEDPOINTER; return attr_enum(.AllocatedPointer);
        case .NOCAPTURE; return attr_enum(.Captures, 0);   // CaptureInfo::none()
        case .MEM_INACC_REF; return attr_enum(.Memory, me_loc(LOC_INACCESSIBLE, MR_REF));
        case .MEM_INACC_OR_ARG_REF; return attr_enum(.Memory, me_inaccessible_or_arg_mem_only(MR_REF));
        case .MEM_ARG_OR_INACC_REF; return attr_enum(.Memory, me_arg_mem_only() | me_loc(LOC_INACCESSIBLE, MR_REF));
        case .MEM_INACC_MOD; return attr_enum(.Memory, me_loc(LOC_INACCESSIBLE, MR_MOD));
        case .MEM_INACC_OR_ARG; return attr_enum(.Memory, me_inaccessible_or_arg_mem_only());
        case .ALLOCSIZE_0; return attr_enum(.AllocSize, 0xFFFF_FFFF);   // (ElemSizeArg 0 << 32) | none
        case .ALLOCKIND_ALLOC_UNINIT; return attr_enum(.AllocKind, ALLOC_FN_KIND_ALLOC | ALLOC_FN_KIND_UNINITIALIZED);
        case .ALLOCKIND_FREE; return attr_enum(.AllocKind, ALLOC_FN_KIND_FREE);
        case .ALLOC_FAMILY_SHARED; return attr_str("alloc-family", "__kmpc_alloc_shared");
    }
    fatal("internal: omp_atom_attr: unexpected atom %", a);
    return .{};
}
ALLOC_FN_KIND_ALLOC :: 1;
ALLOC_FN_KIND_FREE :: 4;
ALLOC_FN_KIND_UNINITIALIZED :: 8;

// The atoms of attribute set `id` (OptimisticAttributes selects the variant)
omp_attr_set_atoms :: (id: u16) -> [] Omp_Atom {
    k := cast(s64) id * 2 + (ifx omp_optimistic_attributes then 1 else 0);
    start := cast(s64) OMP_ATTR_SET_OFFSET[k];
    n := 0;
    while OMP_ATTR_ATOMS[start + n] != .END n += 1;
    r: [] Omp_Atom;
    r.data = OMP_ATTR_ATOMS.data + start;
    r.count = n;
    return r;
}

// addAttrSet(FnAS, AS, Param): AS is added, except that an integer-extension set (SExt / ZExt, alone) adds the
// extension TargetLibraryInfo::getExtAttrForI32Param / Return asks for (none on x86-64)
omp_add_attr_set :: (s: u32, id: u16, param: bool) -> u32 {
    atoms := omp_attr_set_atoms(id);
    has_sext := false;
    has_zext := false;
    for atoms {
        if it == .SEXT has_sext = true;
        if it == .ZEXT has_zext = true;
        if it == .SIZE_TY_EXT && type_int_width(dl_int_ptr_type(ir.t_ptr)) < 64 has_zext = true;
    }
    if atoms.count == 1 && atoms[0] == .SIZE_TY_EXT && !has_zext return s;   // SizeTyExt on 64-bit: AttributeSet()
    if has_sext || has_zext {
        if atoms.count != 1 fatal("internal: openmp-opt: an extension attribute combined with others");
        ak := ifx param then tli_ext_attr_for_i32_param(has_sext) else tli_ext_attr_for_i32_return(has_sext);
        if ak != .NONE_ATTR return attr_set_with(s, attr_enum(ak));
        return s;
    }
    if atoms.count == 0 return s;
    add: [..] Attr; add.allocator = temp;
    for atoms array_add(*add, omp_atom_attr(it));
    return attr_set_merge(s, attr_set_get(add));
}

// OpenMPIRBuilder::addAttributes
omp_add_attributes :: (r: Omp_Rtl, f: Value_Id) {
    off := OMP_RTL_ATTRS_OFFSET[cast(s64) r];
    if off < 0 return;   // attributes are optional
    l := glob(f).attrs;
    fn_attrs := attr_list_fn(l);
    ret_attrs := attr_list_ret(l);
    nargs := cast(s64) fn_nargs(f);
    arg_attrs := NewArray(nargs, u32,, allocator = temp);
    for k: 0..nargs - 1 arg_attrs[k] = attr_list_param(l, cast(u32) k);
    fn_set := OMP_RTL_ATTRS[off];
    ret_set := OMP_RTL_ATTRS[off + 1];
    np := cast(s64) OMP_RTL_ATTRS[off + 2];
    // FnAttrs.addAttributes(Ctx, FnAttrSet)
    fatoms := omp_attr_set_atoms(fn_set);
    if fatoms.count {
        add: [..] Attr; add.allocator = temp;
        for fatoms array_add(*add, omp_atom_attr(it));
        fn_attrs = attr_set_merge(fn_attrs, attr_set_get(add));
    }
    ret_attrs = omp_add_attr_set(ret_attrs, ret_set, false);
    if np > nargs fatal("internal: openmp-opt: more parameter attribute sets than parameters for %", omp_rtl_name(r));
    for k: 0..np - 1 arg_attrs[k] = omp_add_attr_set(arg_attrs[k], OMP_RTL_ATTRS[off + 3 + k], true);
    fn_set_attr_list(f, attr_list_get(fn_attrs, ret_attrs, arg_attrs));
}

// OpenMPIRBuilder::getOrCreateRuntimeFunction: the declaration of `r` (created at the end of the module if absent)
omp_get_or_create_runtime_function :: (r: Omp_Rtl) -> Value_Id {
    fty := omp_rtl_fn_type(r);
    f := module_get_function(omp_rtl_name(r));
    if f != NONE return f;
    f = new_function(fty, omp_rtl_name(r), dl.program_as);
    array_add(*ir.m_functions, f);
    glob(f).cc = 0;   // Config.getRuntimeCC(): CallingConv::C
    if r == .__kmpc_fork_call || r == .__kmpc_fork_teams {
        if get_metadata(f, md_fixed("callback")) == NONE {
            // MDBuilder::createCallbackEncoding(2, {-1, -1}, /* VarArgsArePassed */ true)
            i64 := type_int(64);
            enc := md_tuple(.[md_value(const_int(i64, 2)), md_value(const_int_signed(i64, -1)),
                              md_value(const_int_signed(i64, -1)), md_value(const_int(type_int(1), 1))], false);
            add_metadata(f, md_kind_id("callback"), md_tuple(.[enc], false));
        }
    }
    omp_add_attributes(r, f);
    return f;
}

// ---------------------------------------------------------------- source locations and idents

// OpenMPIRBuilder::getOrCreateSrcLocStr(StringRef LocStr, uint32_t &SrcLocStrSize)
omp_get_or_create_src_loc_str :: (b: *Omp_Builder, loc_str: string) -> (Value_Id, u32) {
    size := cast(u32) loc_str.count;
    found, c := table_find(*b.src_loc_str_map, loc_str);
    if found && c != NONE return c, size;
    init := c_string_const(loc_str, true);
    for gv: ir.m_globals {
        if vkind(gv) != .GLOBAL_VAR continue;
        if glob(gv).is_const && glob(gv).has_init && gv_initializer(gv) == init {
            // ConstantExpr::getPointerCast(&GV, Int8Ptr)
            c = ce_pointer_bitcast_or_addrspacecast(gv, ir.t_ptr);
            table_set(*b.src_loc_str_map, copy_string(loc_str), c);
            return c, size;
        }
    }
    gv := irb_create_global_string(loc_str, "", dl_default_globals_as());
    table_set(*b.src_loc_str_map, copy_string(loc_str), gv);
    return gv, size;
}
// getOrCreateSrcLocStr(FunctionName, FileName, Line, Column)
omp_get_or_create_src_loc_str_parts :: (b: *Omp_Builder, function_name: string, file_name: string, line: u32, column: u32) -> (Value_Id, u32) {
    s := tconcat(";", file_name, ";", function_name, ";", tdec(line), ";", tdec(column), ";;");
    c, n := omp_get_or_create_src_loc_str(b, s);
    return c, n;
}
// getOrCreateDefaultSrcLocStr
omp_get_or_create_default_src_loc_str :: (b: *Omp_Builder) -> (Value_Id, u32) {
    c, n := omp_get_or_create_src_loc_str(b, ";unknown;unknown;0;0;;");
    return c, n;
}
// getOrCreateSrcLocStr(DebugLoc DL, uint32_t &SrcLocStrSize, Function *F)
omp_get_or_create_src_loc_str_dl :: (b: *Omp_Builder, dl_md: Md_Id, f: Value_Id) -> (Value_Id, u32) {
    if dl_md == NONE {
        c, n := omp_get_or_create_default_src_loc_str(b);
        return c, n;
    }
    file_name := diloc_filename(dl_md);
    if file_name.count == 0 file_name = ir.module_id;   // M.getName()
    function_name := md_str_of(di_op(diloc_subprogram(dl_md), 2));   // DIL->getScope()->getSubprogram()->getName()
    if function_name.count == 0 && f != NONE function_name = vname(f);
    c, n := omp_get_or_create_src_loc_str_parts(b, function_name, file_name, cast(u32) diloc_line(dl_md), cast(u32) diloc_col(dl_md));
    return c, n;
}

// OpenMPIRBuilder::getOrCreateIdent(SrcLocStr, SrcLocStrSize, LocFlags, Reserve2Flags)
omp_get_or_create_ident :: (b: *Omp_Builder, src_loc_str: Value_Id, size: u32, loc_flags_in: u32 = 0, reserve2: u32 = 0) -> Value_Id {
    loc_flags := loc_flags_in | OMP_IDENT_FLAG_KMPC;
    key := ((cast(u64) loc_flags) << 31) | cast(u64) reserve2;
    for b.ident_map if it.src_loc_str == src_loc_str && it.flags == key return ce_pointer_bitcast_or_addrspacecast(it.ident, ir.t_ptr);
    ident_ty := omp_ident_type();
    i32 := type_int(32);
    str := src_loc_str;
    if glob_addrspace_of(str) != 0 str = ce_cast(.ADDRSPACECAST, str, ir.t_ptr);   // the ident's i8* field is in address space 0
    init := const_aggregate(.C_STRUCT, ident_ty, .[const_int(i32, 0), const_int(i32, loc_flags), const_int(i32, reserve2),
                                                  const_int(i32, size), str]);
    ident: Value_Id = NONE;
    for gv: ir.m_globals {
        if vkind(gv) != .GLOBAL_VAR continue;
        if glob(gv).value_type == ident_ty && glob(gv).has_init && gv_initializer(gv) == init ident = gv;
    }
    if ident == NONE {
        ident = gv_create(ident_ty, true, .PRIVATE, init, "", NONE, 0, dl_default_globals_as());
        glob(ident).unnamed_addr = 2;
        glob(ident).align = 8;
    }
    array_add(*b.ident_map, .{src_loc_str, key, ident});
    // ConstantExpr::getPointerBitCastOrAddrSpaceCast(Ident, IdentPtr)
    return ce_pointer_bitcast_or_addrspacecast(ident, ir.t_ptr);
}
glob_addrspace_of :: (v: Value_Id) -> u32 { return cast(u32) type_addrspace(vtype(v)); }
// DataLayout::getDefaultGlobalsAddressSpace
dl_default_globals_as :: () -> u32 { return dl.globals_as; }

// ---------------------------------------------------------------- kernel bounds

// Function::getFnAttributeAsParsedInteger(Name, Default): StringRef::getAsInteger(0, uint64_t)
fn_attr_as_parsed_integer :: (f: Value_Id, key: string, default: u64 = 0) -> u64 {
    a := fn_find_str_attr(f, key);
    if !a return default;
    ok, v := str_get_as_integer_auto_radix(a.val);
    if !ok || v.bits > 64 fatal("cannot parse integer attribute %", key);
    return ap_zext_value(v);
}
// OpenMPIRBuilder::readThreadBoundsForKernel (no AMDGPU triples here)
omp_read_thread_bounds_for_kernel :: (f: Value_Id) -> (s32, s32) {
    thread_limit := cast,no_check(s32) fn_attr_as_parsed_integer(f, "omp_target_thread_limit");
    if fn_has_str_attr(f, "nvvm.maxntid") {
        ub := cast,no_check(s32) fn_attr_as_parsed_integer(f, "nvvm.maxntid");
        return 0, ifx thread_limit != 0 then min(thread_limit, ub) else ub;
    }
    return 0, thread_limit;
}
// OpenMPIRBuilder::readTeamBoundsForKernel
omp_read_team_bounds_for_kernel :: (f: Value_Id) -> (s32, s32) {
    return 0, cast,no_check(s32) fn_attr_as_parsed_integer(f, "omp_target_num_teams");
}
