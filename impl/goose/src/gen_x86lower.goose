            xl_soa(XISD_EXTRACT_VECTOR_ELT, VT, LA_CUSTOM);
            xl_soa(XISD_INSERT_VECTOR_ELT, VT, LA_CUSTOM);
            xl_soa(XISD_SELECT, VT, LA_CUSTOM);
            xl_soa(XISD_BUILD_VECTOR, VT, LA_CUSTOM);
            xl_soa(XISD_VECTOR_SHUFFLE, VT, LA_CUSTOM);
            xl_soa(XISD_CONCAT_VECTORS, VT, LA_CUSTOM);
            xl_soa(XISD_INSERT_SUBVECTOR, VT, LA_CUSTOM);
        }
        for VT in [MVT_v16i1, MVT_v32i1] {
            xl_soa(XISD_EXTRACT_SUBVECTOR, VT, LA_CUSTOM);
        }
        xl_soa(XISD_SIGN_EXTEND, MVT_v32i8, LA_CUSTOM);
        xl_soa(XISD_ZERO_EXTEND, MVT_v32i8, LA_CUSTOM);
        xl_soa(XISD_ANY_EXTEND, MVT_v32i8, LA_CUSTOM);
        for VT in [MVT_v32i8, MVT_v16i8, MVT_v16i16, MVT_v8i16, MVT_v16f16, MVT_v8f16] {
            xl_soa(XISD_MLOAD, VT, (if xst_hasVLX() { LA_LEGAL } else { LA_CUSTOM }));
            xl_soa(XISD_MSTORE, VT, (if xst_hasVLX() { LA_LEGAL } else { LA_CUSTOM }));
        }
        if xst_hasBITALG() {
            for VT in [MVT_v16i8, MVT_v32i8, MVT_v8i16, MVT_v16i16] {
                xl_soa(XISD_CTPOP, VT, LA_LEGAL);
            }
        }
        if xst_hasBMM() {
            xl_soa(XISD_BITREVERSE, MVT_i8, LA_CUSTOM);
            xl_soa(XISD_BITREVERSE, MVT_i16, LA_CUSTOM);
            xl_soa(XISD_BITREVERSE, MVT_i32, LA_CUSTOM);
            xl_soa(XISD_BITREVERSE, MVT_i64, LA_CUSTOM);
            for VT in [MVT_v16i8, MVT_v32i8, MVT_v64i8] {
                xl_soa(XISD_BITREVERSE, VT, LA_LEGAL);
            }
        }
    }
    if !x86_use_soft_float() && xst_hasFP16() {
        xl_lambda_set_group(MVT_f16);
        xl_lambda_set_f_p_min_max_action(MVT_f16);
        xl_soa(XISD_FREM, MVT_f16, LA_PROMOTE);
        xl_soa(XISD_STRICT_FREM, MVT_f16, LA_PROMOTE);
        xl_soa(XISD_SELECT_CC, MVT_f16, LA_EXPAND);
        xl_soa(XISD_BR_CC, MVT_f16, LA_EXPAND);
        xl_soa(XISD_STRICT_FROUND, MVT_f16, LA_PROMOTE);
        xl_soa(XISD_FROUNDEVEN, MVT_f16, LA_LEGAL);
        xl_soa(XISD_STRICT_FROUNDEVEN, MVT_f16, LA_LEGAL);
        xl_soa(XISD_FP_ROUND, MVT_f16, LA_CUSTOM);
        xl_soa(XISD_STRICT_FP_ROUND, MVT_f16, LA_CUSTOM);
        xl_soa(XISD_FP_EXTEND, MVT_f32, LA_LEGAL);
        xl_soa(XISD_STRICT_FP_EXTEND, MVT_f32, LA_LEGAL);
        xl_soa(XISD_LRINT, MVT_f16, LA_LEGAL);
        xl_soa(XISD_LLRINT, MVT_f16, LA_LEGAL);
        xl_scca(XCC_SETOEQ, MVT_f16, LA_EXPAND);
        xl_scca(XCC_SETUNE, MVT_f16, LA_EXPAND);
        if x86_use_avx512_regs() {
            xl_lambda_set_group(MVT_v32f16);
            xl_soa(XISD_SCALAR_TO_VECTOR, MVT_v32f16, LA_CUSTOM);
            xl_soa(XISD_SINT_TO_FP, MVT_v32i16, LA_LEGAL);
            xl_soa(XISD_STRICT_SINT_TO_FP, MVT_v32i16, LA_LEGAL);
            xl_soa(XISD_UINT_TO_FP, MVT_v32i16, LA_LEGAL);
            xl_soa(XISD_STRICT_UINT_TO_FP, MVT_v32i16, LA_LEGAL);
            xl_soa(XISD_FP_ROUND, MVT_v16f16, LA_LEGAL);
            xl_soa(XISD_STRICT_FP_ROUND, MVT_v16f16, LA_LEGAL);
            xl_soa(XISD_FP_EXTEND, MVT_v16f32, LA_CUSTOM);
            xl_soa(XISD_STRICT_FP_EXTEND, MVT_v16f32, LA_LEGAL);
            xl_soa(XISD_FP_EXTEND, MVT_v8f64, LA_CUSTOM);
            xl_soa(XISD_STRICT_FP_EXTEND, MVT_v8f64, LA_LEGAL);
            xl_soa(XISD_INSERT_VECTOR_ELT, MVT_v32f16, LA_CUSTOM);
            xl_soa(XISD_FP_TO_SINT, MVT_v32i16, LA_CUSTOM);
            xl_soa(XISD_STRICT_FP_TO_SINT, MVT_v32i16, LA_CUSTOM);
            xl_soa(XISD_FP_TO_UINT, MVT_v32i16, LA_CUSTOM);
            xl_soa(XISD_STRICT_FP_TO_UINT, MVT_v32i16, LA_CUSTOM);
            xl_sopt(XISD_FP_TO_SINT, MVT_v32i8, MVT_v32i16);
            xl_sopt(XISD_STRICT_FP_TO_SINT, MVT_v32i8, MVT_v32i16);
            xl_sopt(XISD_FP_TO_UINT, MVT_v32i8, MVT_v32i16);
            xl_sopt(XISD_STRICT_FP_TO_UINT, MVT_v32i8, MVT_v32i16);
            xl_sopt(XISD_FP_TO_SINT, MVT_v32i1, MVT_v32i16);
            xl_sopt(XISD_STRICT_FP_TO_SINT, MVT_v32i1, MVT_v32i16);
            xl_sopt(XISD_FP_TO_UINT, MVT_v32i1, MVT_v32i16);
            xl_sopt(XISD_STRICT_FP_TO_UINT, MVT_v32i1, MVT_v32i16);
            xl_soa(XISD_EXTRACT_SUBVECTOR, MVT_v16f16, LA_LEGAL);
            xl_soa(XISD_INSERT_SUBVECTOR, MVT_v32f16, LA_LEGAL);
            xl_soa(XISD_CONCAT_VECTORS, MVT_v32f16, LA_CUSTOM);
            xl_slea(XLE_EXTLOAD, MVT_v8f64, MVT_v8f16, LA_LEGAL);
            xl_slea(XLE_EXTLOAD, MVT_v16f32, MVT_v16f16, LA_LEGAL);
            xl_lambda_set_f_p_min_max_action(MVT_v32f16);
            xl_soa(XISD_LRINT, MVT_v32f16, LA_LEGAL);
            xl_soa(XISD_LLRINT, MVT_v8f16, LA_LEGAL);
        }
        xl_soa(XISD_FP_TO_SINT, MVT_v8i16, LA_CUSTOM);
        xl_soa(XISD_STRICT_FP_TO_SINT, MVT_v8i16, LA_CUSTOM);
        xl_soa(XISD_FP_TO_UINT, MVT_v8i16, LA_CUSTOM);
        xl_soa(XISD_STRICT_FP_TO_UINT, MVT_v8i16, LA_CUSTOM);
        if xst_hasVLX() {
            xl_lambda_set_group(MVT_v8f16);
            xl_lambda_set_group(MVT_v16f16);
            xl_soa(XISD_SCALAR_TO_VECTOR, MVT_v8f16, LA_LEGAL);
            xl_soa(XISD_SCALAR_TO_VECTOR, MVT_v16f16, LA_CUSTOM);
            xl_soa(XISD_SINT_TO_FP, MVT_v16i16, LA_LEGAL);
            xl_soa(XISD_STRICT_SINT_TO_FP, MVT_v16i16, LA_LEGAL);
            xl_soa(XISD_SINT_TO_FP, MVT_v8i16, LA_LEGAL);
            xl_soa(XISD_STRICT_SINT_TO_FP, MVT_v8i16, LA_LEGAL);
            xl_soa(XISD_UINT_TO_FP, MVT_v16i16, LA_LEGAL);
            xl_soa(XISD_STRICT_UINT_TO_FP, MVT_v16i16, LA_LEGAL);
            xl_soa(XISD_UINT_TO_FP, MVT_v8i16, LA_LEGAL);
            xl_soa(XISD_STRICT_UINT_TO_FP, MVT_v8i16, LA_LEGAL);
            xl_soa(XISD_FP_ROUND, MVT_v8f16, LA_LEGAL);
            xl_soa(XISD_STRICT_FP_ROUND, MVT_v8f16, LA_LEGAL);
            xl_soa(XISD_FP_EXTEND, MVT_v8f32, LA_CUSTOM);
            xl_soa(XISD_STRICT_FP_EXTEND, MVT_v8f32, LA_LEGAL);
            xl_soa(XISD_FP_EXTEND, MVT_v4f64, LA_CUSTOM);
            xl_soa(XISD_STRICT_FP_EXTEND, MVT_v4f64, LA_LEGAL);
            xl_soa(XISD_INSERT_VECTOR_ELT, MVT_v8f16, LA_CUSTOM);
            xl_soa(XISD_INSERT_VECTOR_ELT, MVT_v16f16, LA_CUSTOM);
            xl_soa(XISD_EXTRACT_SUBVECTOR, MVT_v8f16, LA_LEGAL);
            xl_soa(XISD_INSERT_SUBVECTOR, MVT_v16f16, LA_LEGAL);
            xl_soa(XISD_CONCAT_VECTORS, MVT_v16f16, LA_CUSTOM);
            xl_slea(XLE_EXTLOAD, MVT_v4f64, MVT_v4f16, LA_LEGAL);
            xl_slea(XLE_EXTLOAD, MVT_v2f64, MVT_v2f16, LA_LEGAL);
            xl_slea(XLE_EXTLOAD, MVT_v8f32, MVT_v8f16, LA_LEGAL);
            xl_slea(XLE_EXTLOAD, MVT_v4f32, MVT_v4f16, LA_LEGAL);
            xl_soa(XISD_LOAD, MVT_v4f16, LA_CUSTOM);
            xl_soa(XISD_STORE, MVT_v4f16, LA_CUSTOM);
            xl_lambda_set_f_p_min_max_action(MVT_v8f16);
            xl_lambda_set_f_p_min_max_action(MVT_v16f16);
            xl_soa(XISD_LRINT, MVT_v8f16, LA_LEGAL);
            xl_soa(XISD_LRINT, MVT_v16f16, LA_LEGAL);
        }
    }
    if !x86_use_soft_float() && (xst_hasAVXNECONVERT() || xst_hasBF16()) {
        xl_add_reg_class(MVT_v8bf16);
        xl_add_reg_class(MVT_v16bf16);
        xl_soa(XISD_BUILD_VECTOR, MVT_bf16, LA_CUSTOM);
        xl_soa(XISD_INSERT_VECTOR_ELT, MVT_bf16, LA_CUSTOM);
        for VT in [MVT_v8bf16, MVT_v16bf16] {
            xl_lambda_set_f16_action(VT, LA_EXPAND);
            if !xst_hasBF16() {
                xl_soa(XISD_VSELECT, VT, LA_CUSTOM);
            }
            xl_soa(XISD_BUILD_VECTOR, VT, LA_CUSTOM);
            xl_soa(XISD_VECTOR_SHUFFLE, VT, LA_CUSTOM);
            xl_soa(XISD_INSERT_SUBVECTOR, VT, LA_LEGAL);
            xl_soa(XISD_CONCAT_VECTORS, VT, LA_CUSTOM);
        }
        for Opc in [XISD_FADD, XISD_FSUB, XISD_FMUL, XISD_FDIV] {
            xl_sopt(Opc, MVT_v8bf16, MVT_v8f32);
            xl_sopt(Opc, MVT_v16bf16, MVT_v16f32);
        }
        xl_soa(XISD_SETCC, MVT_v8bf16, LA_CUSTOM);
        xl_soa(XISD_SETCC, MVT_v16bf16, LA_CUSTOM);
        xl_soa(XISD_FP_ROUND, MVT_v8bf16, LA_CUSTOM);
    }
    if !x86_use_soft_float() && xst_hasBF16() && x86_use_avx512_regs() {
        xl_add_reg_class(MVT_v32bf16);
        xl_lambda_set_f16_action(MVT_v32bf16, LA_EXPAND);
        for Opc in [XISD_FADD, XISD_FSUB, XISD_FMUL, XISD_FDIV] {
            xl_sopt(Opc, MVT_v32bf16, MVT_v32f32);
        }
        xl_soa(XISD_SETCC, MVT_v32bf16, LA_CUSTOM);
        xl_soa(XISD_BUILD_VECTOR, MVT_v32bf16, LA_CUSTOM);
        xl_soa(XISD_FP_ROUND, MVT_v16bf16, LA_CUSTOM);
        xl_soa(XISD_VECTOR_SHUFFLE, MVT_v32bf16, LA_CUSTOM);
        xl_soa(XISD_INSERT_SUBVECTOR, MVT_v32bf16, LA_LEGAL);
        xl_soa(XISD_CONCAT_VECTORS, MVT_v32bf16, LA_CUSTOM);
    }
    if !x86_use_soft_float() && xst_hasAVX10_2() {
        xl_soa(XISD_FADD, MVT_v32bf16, LA_LEGAL);
        xl_soa(XISD_FSUB, MVT_v32bf16, LA_LEGAL);
        xl_soa(XISD_FMUL, MVT_v32bf16, LA_LEGAL);
        xl_soa(XISD_FDIV, MVT_v32bf16, LA_LEGAL);
        xl_soa(XISD_FSQRT, MVT_v32bf16, LA_LEGAL);
        xl_soa(XISD_FMA, MVT_v32bf16, LA_LEGAL);
        xl_soa(XISD_SETCC, MVT_v32bf16, LA_CUSTOM);
        xl_lambda_set_f_p_min_max_action(MVT_v32bf16);
        for VT in [MVT_v8bf16, MVT_v16bf16] {
            xl_soa(XISD_FADD, VT, LA_LEGAL);
            xl_soa(XISD_FSUB, VT, LA_LEGAL);
            xl_soa(XISD_FMUL, VT, LA_LEGAL);
            xl_soa(XISD_FDIV, VT, LA_LEGAL);
            xl_soa(XISD_FSQRT, VT, LA_LEGAL);
            xl_soa(XISD_FMA, VT, LA_LEGAL);
            xl_soa(XISD_SETCC, VT, LA_CUSTOM);
            xl_lambda_set_f_p_min_max_action(VT);
        }
        for VT in [MVT_f16, MVT_f32, MVT_f64] {
            xl_scca(XCC_SETOEQ, VT, LA_CUSTOM);
            xl_scca(XCC_SETUNE, VT, LA_CUSTOM);
        }
    }
    if !x86_use_soft_float() && xst_hasVLX() {
        xl_stsa(MVT_v4i64, MVT_v4i8, LA_LEGAL);
        xl_stsa(MVT_v4i64, MVT_v4i16, LA_LEGAL);
        xl_stsa(MVT_v4i64, MVT_v4i32, LA_LEGAL);
        xl_stsa(MVT_v8i32, MVT_v8i8, LA_LEGAL);
        xl_stsa(MVT_v8i32, MVT_v8i16, LA_LEGAL);
        xl_stsa(MVT_v2i64, MVT_v2i8, LA_LEGAL);
        xl_stsa(MVT_v2i64, MVT_v2i16, LA_LEGAL);
        xl_stsa(MVT_v2i64, MVT_v2i32, LA_LEGAL);
        xl_stsa(MVT_v4i32, MVT_v4i8, LA_LEGAL);
        xl_stsa(MVT_v4i32, MVT_v4i16, LA_LEGAL);
        if xst_hasBWI() {
            xl_stsa(MVT_v16i16, MVT_v16i8, LA_LEGAL);
            xl_stsa(MVT_v8i16, MVT_v8i8, LA_LEGAL);
        }
        if xst_hasFP16() {
            xl_soa(XISD_FP_TO_SINT, MVT_v2f16, LA_CUSTOM);
            xl_soa(XISD_STRICT_FP_TO_SINT, MVT_v2f16, LA_CUSTOM);
            xl_soa(XISD_FP_TO_UINT, MVT_v2f16, LA_CUSTOM);
            xl_soa(XISD_STRICT_FP_TO_UINT, MVT_v2f16, LA_CUSTOM);
            xl_soa(XISD_FP_TO_SINT, MVT_v4f16, LA_CUSTOM);
            xl_soa(XISD_STRICT_FP_TO_SINT, MVT_v4f16, LA_CUSTOM);
            xl_soa(XISD_FP_TO_UINT, MVT_v4f16, LA_CUSTOM);
            xl_soa(XISD_STRICT_FP_TO_UINT, MVT_v4f16, LA_CUSTOM);
            xl_soa(XISD_SINT_TO_FP, MVT_v2f16, LA_CUSTOM);
            xl_soa(XISD_STRICT_SINT_TO_FP, MVT_v2f16, LA_CUSTOM);
            xl_soa(XISD_UINT_TO_FP, MVT_v2f16, LA_CUSTOM);
            xl_soa(XISD_STRICT_UINT_TO_FP, MVT_v2f16, LA_CUSTOM);
            xl_soa(XISD_SINT_TO_FP, MVT_v4f16, LA_CUSTOM);
            xl_soa(XISD_STRICT_SINT_TO_FP, MVT_v4f16, LA_CUSTOM);
            xl_soa(XISD_UINT_TO_FP, MVT_v4f16, LA_CUSTOM);
            xl_soa(XISD_STRICT_UINT_TO_FP, MVT_v4f16, LA_CUSTOM);
            xl_soa(XISD_FP_ROUND, MVT_v2f16, LA_CUSTOM);
            xl_soa(XISD_STRICT_FP_ROUND, MVT_v2f16, LA_CUSTOM);
            xl_soa(XISD_FP_ROUND, MVT_v4f16, LA_CUSTOM);
            xl_soa(XISD_STRICT_FP_ROUND, MVT_v4f16, LA_CUSTOM);
            xl_soa(XISD_FP_EXTEND, MVT_v2f16, LA_CUSTOM);
            xl_soa(XISD_STRICT_FP_EXTEND, MVT_v2f16, LA_CUSTOM);
            xl_soa(XISD_FP_EXTEND, MVT_v4f16, LA_CUSTOM);
            xl_soa(XISD_STRICT_FP_EXTEND, MVT_v4f16, LA_CUSTOM);
        }
    }
    if !x86_use_soft_float() && xst_hasAMXTILE() {
        xl_add_reg_class(MVT_x86amx);
    }
    xl_soa(XISD_INTRINSIC_WO_CHAIN, MVT_Other, LA_CUSTOM);
    xl_soa(XISD_INTRINSIC_W_CHAIN, MVT_Other, LA_CUSTOM);
    xl_soa(XISD_INTRINSIC_VOID, MVT_Other, LA_CUSTOM);
    if !x86_is64() {
        xl_soa(XISD_INTRINSIC_W_CHAIN, MVT_i64, LA_CUSTOM);
    }
    for VT in [MVT_i8, MVT_i16, MVT_i32, MVT_i64] {
        if VT == MVT_i64 && !x86_is64() {
            continue;
        }
        xl_soa(XISD_SADDO, VT, LA_CUSTOM);
        xl_soa(XISD_UADDO, VT, LA_CUSTOM);
        xl_soa(XISD_SSUBO, VT, LA_CUSTOM);
        xl_soa(XISD_USUBO, VT, LA_CUSTOM);
        xl_soa(XISD_SMULO, VT, LA_CUSTOM);
        xl_soa(XISD_UMULO, VT, LA_CUSTOM);
        xl_soa(XISD_UADDO_CARRY, VT, LA_CUSTOM);
        xl_soa(XISD_USUBO_CARRY, VT, LA_CUSTOM);
        xl_soa(XISD_SETCCCARRY, VT, LA_CUSTOM);
        xl_soa(XISD_SADDO_CARRY, VT, LA_CUSTOM);
        xl_soa(XISD_SSUBO_CARRY, VT, LA_CUSTOM);
    }
    xl_soa(XISD_FSINCOS, MVT_f64, LA_EXPAND);
    xl_soa(XISD_FSINCOS, MVT_f32, LA_EXPAND);
    if x86_is_win64() {
        xl_soa(XISD_SDIV, MVT_i128, LA_CUSTOM);
        xl_soa(XISD_UDIV, MVT_i128, LA_CUSTOM);
        xl_soa(XISD_SREM, MVT_i128, LA_CUSTOM);
        xl_soa(XISD_UREM, MVT_i128, LA_CUSTOM);
        xl_soa(XISD_FP_TO_SINT, MVT_i128, LA_CUSTOM);
        xl_soa(XISD_FP_TO_UINT, MVT_i128, LA_CUSTOM);
        xl_soa(XISD_SINT_TO_FP, MVT_i128, LA_CUSTOM);
        xl_soa(XISD_UINT_TO_FP, MVT_i128, LA_CUSTOM);
        xl_soa(XISD_STRICT_FP_TO_SINT, MVT_i128, LA_CUSTOM);
        xl_soa(XISD_STRICT_FP_TO_UINT, MVT_i128, LA_CUSTOM);
        xl_soa(XISD_STRICT_SINT_TO_FP, MVT_i128, LA_CUSTOM);
        xl_soa(XISD_STRICT_UINT_TO_FP, MVT_i128, LA_CUSTOM);
    }
    if xst_is32Bit() && (x86_is_windows_msvc() || x86_is_windows_itanium()) {
        for Op in [XISD_FACOS, XISD_STRICT_FACOS, XISD_FASIN, XISD_STRICT_FASIN, XISD_FATAN, XISD_STRICT_FATAN, XISD_FATAN2, XISD_STRICT_FATAN2, XISD_FCEIL, XISD_STRICT_FCEIL, XISD_FCOS, XISD_STRICT_FCOS, XISD_FCOSH, XISD_STRICT_FCOSH, XISD_FEXP, XISD_STRICT_FEXP, XISD_FFLOOR, XISD_STRICT_FFLOOR, XISD_FREM, XISD_STRICT_FREM, XISD_FLOG, XISD_STRICT_FLOG, XISD_FLOG10, XISD_STRICT_FLOG10, XISD_FPOW, XISD_STRICT_FPOW, XISD_FSIN, XISD_STRICT_FSIN, XISD_FSINH, XISD_STRICT_FSINH, XISD_FTAN, XISD_STRICT_FTAN, XISD_FTANH, XISD_STRICT_FTANH, XISD_FMODF] {
            if xl_is_op_expand_or_libcall(Op, MVT_f32) {
                xl_soa(Op, MVT_f32, LA_PROMOTE);
            }
        }
    }
    if x86_is_windows() {
        for Op in [XISD_FLDEXP, XISD_STRICT_FLDEXP, XISD_FFREXP] {
            if xl_is_op_expand(Op, MVT_f32) {
                xl_soa(Op, MVT_f32, LA_PROMOTE);
            }
        }
    }
    xl_sopt(XISD_ATOMIC_LOAD, MVT_f16, MVT_i16);
    xl_sopt(XISD_ATOMIC_LOAD, MVT_f32, MVT_i32);
    xl_sopt(XISD_ATOMIC_LOAD, MVT_f64, MVT_i64);
    xl_sopt(XISD_ATOMIC_STORE, MVT_f16, MVT_i16);
    xl_sopt(XISD_ATOMIC_STORE, MVT_f32, MVT_i32);
    xl_sopt(XISD_ATOMIC_STORE, MVT_f64, MVT_i64);
}
