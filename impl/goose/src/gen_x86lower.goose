        xl_soa(XISD_SELECT, MVT_v16i16, LA_CUSTOM);
        xl_soa(XISD_SELECT, MVT_v16f16, LA_CUSTOM);
        xl_soa(XISD_SELECT, MVT_v32i8, LA_CUSTOM);
        xl_soa(XISD_SELECT, MVT_v8f32, LA_CUSTOM);
        for VT in [MVT_v16i16, MVT_v8i32, MVT_v4i64] {
