# Environment for `./harness/run perf` (build and every measured run; see docs/testing.md, Performance).
# Goose reserves GOOSE_STACK_RESERVE of address space per data stack (default 2G, ~490 stacks): more than valgrind
# gives a client, so `perf --instr` would fail on every run. 128M is enough for every tests/perf input.
GOOSE_STACK_RESERVE=128M
# Time the single-translation-unit build (build.sh, NOTES.md "Build"): the default split ThinLTO build is a few %
# slower on instcombine-heavy inputs. The first perf run after a source change builds it (~5 min); its binary is
# cached by input hash, and check switches back to the cached split build.
GOOSE_BUILD=whole
