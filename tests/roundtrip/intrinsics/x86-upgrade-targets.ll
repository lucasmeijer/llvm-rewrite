; Declarations of the intrinsics that AutoUpgrade creates when it rewrites old x86 intrinsic calls (as in
; llvm/test/CodeGen/X86/*-upgrade.ll) and that no other test declares, so that gen_intrinsics.py knows their
; attributes (Intrinsic::getAttributes).

declare <16 x float> @llvm.x86.avx512.vfmadd.ps.512(<16 x float>, <16 x float>, <16 x float>, i32 immarg)
declare <16 x float> @llvm.x86.avx512.vfmaddsub.ps.512(<16 x float>, <16 x float>, <16 x float>, i32 immarg)
declare <16 x i16> @llvm.x86.avx512.dbpsadbw.256(<32 x i8>, <32 x i8>, i32 immarg)
declare <16 x i1> @llvm.x86.avx512.fpclass.ps.512(<16 x float>, i32 immarg)
declare <16 x i1> @llvm.x86.avx512.vpshufbitqmb.128(<16 x i8>, <16 x i8>)
declare <16 x i32> @llvm.x86.avx512.conflict.d.512(<16 x i32>)
declare <16 x i8> @llvm.x86.avx512.pmultishift.qb.128(<16 x i8>, <16 x i8>)
declare <2 x double> @llvm.x86.fma.vfmaddsub.pd(<2 x double>, <2 x double>, <2 x double>)
declare <2 x double> @llvm.x86.xop.vpermil2pd(<2 x double>, <2 x double>, <2 x i64>, i8 immarg)
declare <2 x i1> @llvm.x86.avx512.fpclass.pd.128(<2 x double>, i32 immarg)
declare <2 x i64> @llvm.x86.avx512.conflict.q.128(<2 x i64>)
declare <32 x i1> @llvm.x86.avx512.vpshufbitqmb.256(<32 x i8>, <32 x i8>)
declare <32 x i8> @llvm.x86.avx512.pmultishift.qb.256(<32 x i8>, <32 x i8>)
declare <4 x double> @llvm.x86.fma.vfmaddsub.pd.256(<4 x double>, <4 x double>, <4 x double>)
declare <4 x double> @llvm.x86.xop.vpermil2pd.256(<4 x double>, <4 x double>, <4 x i64>, i8 immarg)
declare <4 x float> @llvm.x86.fma.vfmaddsub.ps(<4 x float>, <4 x float>, <4 x float>)
declare <4 x float> @llvm.x86.xop.vpermil2ps(<4 x float>, <4 x float>, <4 x i32>, i8 immarg)
declare <4 x i1> @llvm.x86.avx512.fpclass.pd.256(<4 x double>, i32 immarg)
declare <4 x i1> @llvm.x86.avx512.fpclass.ps.128(<4 x float>, i32 immarg)
declare <4 x i32> @llvm.x86.avx512.conflict.d.128(<4 x i32>)
declare <4 x i64> @llvm.x86.avx512.conflict.q.256(<4 x i64>)
declare <64 x i1> @llvm.x86.avx512.vpshufbitqmb.512(<64 x i8>, <64 x i8>)
declare <64 x i8> @llvm.x86.avx512.pmultishift.qb.512(<64 x i8>, <64 x i8>)
declare <8 x double> @llvm.x86.avx512.vfmadd.pd.512(<8 x double>, <8 x double>, <8 x double>, i32 immarg)
declare <8 x double> @llvm.x86.avx512.vfmaddsub.pd.512(<8 x double>, <8 x double>, <8 x double>, i32 immarg)
declare <8 x float> @llvm.x86.fma.vfmaddsub.ps.256(<8 x float>, <8 x float>, <8 x float>)
declare <8 x float> @llvm.x86.xop.vpermil2ps.256(<8 x float>, <8 x float>, <8 x i32>, i8 immarg)
declare <8 x i16> @llvm.x86.avx512.dbpsadbw.128(<16 x i8>, <16 x i8>, i32 immarg)
declare <8 x i1> @llvm.x86.avx512.fpclass.pd.512(<8 x double>, i32 immarg)
declare <8 x i1> @llvm.x86.avx512.fpclass.ps.256(<8 x float>, i32 immarg)
declare <8 x i32> @llvm.x86.avx512.conflict.d.256(<8 x i32>)
declare <8 x i64> @llvm.x86.avx512.conflict.q.512(<8 x i64>)
declare { i64, i32 } @llvm.x86.rdtscp()
declare { i8, i32 } @llvm.x86.subborrow.32(i8, i32, i32)
declare { i8, i64 } @llvm.x86.subborrow.64(i8, i64, i64)
declare i32 @llvm.x86.sse42.crc32.32.8(i32, i8)
